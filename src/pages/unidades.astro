---
import BaseLayout from "@/ui/layouts/BaseLayout.astro";

const statementLines = [
  "VMA Rental integra alquiler, venta",
  "y soporte técnico respondiendo",
  "a necesidades reales: disponibilidad,",
  "criterio técnico y acompañamiento operativo.",
];

const businessUnits = [
  {
    label: "A",
    tag: "Alquiler",
    title: "Alquiler de equipos",
    description:
      "Flota moderna siempre lista. Planes flexibles para industrias, obras o proyectos específicos.",
    image:
      "/images/optimized/Firefly-10.png",
    href: "/#contacto",
  },
  {
    label: "B",
    tag: "Venta",
    title: "Venta de equipos",
    description:
      "Equipos nuevos y usados seleccionados, con marcas confiables e historial de mantenimiento transparente.",
    image:
      "/images/Firefly10-1.png",
    href: "/#contacto",
  },
  {
    label: "C",
    tag: "Soporte",
    title: "Servicio técnico y postventa",
    description:
      "Respuesta express, mantenimiento, repuestos y capacitación para reducir accidentes, roturas y tiempos muertos.",
    image:
      "/images/Firefly20-1.png",
    href: "/#contacto",
  },
];
---

<BaseLayout>
  <main class="unitsPage" data-units-page>
    <section class="unitsHero">
      <div class="unitsRule" aria-hidden="true"></div>

      <div class="unitsHeroGrid">
        <aside class="unitsMeta">
          <a class="backLink" href="/#negocio">← Volver</a>
          <p class="kicker">UNIDADES DE NEGOCIO</p>
        </aside>

        <div class="unitsHeroTitleWrap">
          <h1>Alquiler, venta y soporte técnico.</h1>
        </div>
      </div>
    </section>

    <section class="unitsImageSection">
      <figure class="statementImage">
        <img
          src="/images/20190925_171551.jpg"
          alt="Equipo de elevación en operación"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

        <section class="unitsEditorial">
      <h2 aria-label={statementLines.join(" ")}>
        {statementLines.map((line) => (
          <span class="paintLine" data-paint-line>{line}</span>
        ))}
      </h2>

      <div class="editorialRule" aria-hidden="true"></div>
    </section>

    <section class="unitsCards" aria-label="Unidades de negocio VMA">
      <article class="featuredCard">
        <div class="featuredImage">
          <img
            src={businessUnits[0].image}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="featuredBody">
          <span class="unitPill">{businessUnits[0].tag}</span>
          <h2>{businessUnits[0].title}</h2>
          <p>{businessUnits[0].description}</p>

          <a href={businessUnits[0].href} class="cardCta">
            <span>Consultar disponibilidad</span>
            <span aria-hidden="true">↘</span>
          </a>
        </div>
      </article>

      <div class="cardGrid">
        {businessUnits.slice(1).map((unit) => (
          <article class="unitCard">
            <a href={unit.href} aria-label={unit.title}>
              <div class="unitImage">
                <img
                  src={unit.image}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="unitCardHeader">
                <span class="unitPill">{unit.tag}</span>
                <span class="unitIndex">{unit.label}</span>
              </div>

              <div class="unitCardTitle">
                <h3>{unit.title}</h3>
                <span aria-hidden="true">↘</span>
              </div>

              <p>{unit.description}</p>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="pageCta">
      <a href="/#contacto">
        <span>Cotizar equipo</span>
        <span aria-hidden="true">↘</span>
      </a>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const bindPaint = () => {
      const root = document.querySelector(".unitsEditorial h2");
      if (!root) return;

      const lines = [...root.querySelectorAll("[data-paint-line]")];
      if (!lines.length) return;

      let ticking = false;

      const update = () => {
        const viewport = window.innerHeight || 1;
        const rect = root.getBoundingClientRect();

        const start = viewport * 0.88;
        const end = viewport * 0.24;
        const progress = clamp((start - rect.top) / (start - end), 0, 1);

        lines.forEach((line, index) => {
          const lineProgress = clamp(progress * lines.length - index, 0, 1);
          line.style.setProperty("--paint", `${Math.round(lineProgress * 100)}%`);
        });

        ticking = false;
      };

      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      update();
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bindPaint, { once: true });
    } else {
      bindPaint();
    }
  })();
</script>

<style>
  .unitsPage {
    min-height: 100svh;
    background: #ffffff;
    color: #080808;
    font-family: var(--font-body);
  }

  .unitsHero {
    padding:
      clamp(112px, 11vw, 172px)
      clamp(30px, 4vw, 76px)
      clamp(62px, 7vw, 104px);
  }

  .unitsRule {
    width: 100%;
    height: 1px;
    background: rgba(8, 8, 8, 0.86);
    margin-bottom: clamp(50px, 6vw, 86px);
  }

  .unitsHeroGrid {
    display: grid;
    grid-template-columns: minmax(180px, 0.28fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 86px);
    align-items: start;
  }

  .backLink {
    display: inline-block;
    margin-bottom: 16px;
    color: rgba(8, 8, 8, 0.5);
    font-size: 0.92rem;
    text-decoration: none;
  }

  .backLink:hover {
    color: #080808;
  }

  .kicker {
    margin: 0;
    color: #ffc400;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .unitsHeroTitleWrap {
    display: flex;
    justify-content: center;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    color: #080808;
    text-align: center;
    font-size: clamp(4.6rem, 7.4vw, 10.8rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.085em;
  }

  .unitsEditorial {
    padding:clamp(12px,6vw,88px) clamp(30px,4vw,76px) clamp(54px,7vw,96px)
  }

  .unitsEditorial h2 {
    margin: 0;
    /* max-width: 920px; */
    font-family: var(--font-body);
    font-size: clamp(2.6rem, 4.15vw, 5.4rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.06em;
  }

  .paintLine {
    --paint: 0%;

    display: block;
    width: fit-content;
    max-width: 100%;
    white-space: nowrap;
    color: transparent;

    background-image: linear-gradient(
      90deg,
      #080808 0%,
      #080808 var(--paint),
      rgba(8, 8, 8, 0.14) var(--paint),
      rgba(8, 8, 8, 0.14) 100%
    );
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
  }

  .editorialRule {
    width: 100%;
    height: 1px;
    margin-top: clamp(70px, 9vw, 132px);
    background: rgba(8, 8, 8, 0.86);
  }

  .unitsImageSection {
    padding:
      0
      clamp(30px, 4vw, 76px)
      clamp(46px, 6vw, 82px);
  }

  .statementImage {
    width: 100%;
    height: clamp(430px, 50vw, 780px);
    margin: 0;
    overflow: hidden;
    border-radius: clamp(24px, 2vw, 36px);
    background: transparent;
  }

  .statementImage img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .unitsCards {
    padding:
      clamp(12px, 2vw, 28px)
      clamp(30px, 4vw, 76px)
      clamp(72px, 9vw, 132px);
  }

  .featuredCard {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    min-height: clamp(420px, 45vw, 650px);
    overflow: hidden;
    border-radius: clamp(24px, 2vw, 36px);
    background: #050505;
    color: #ffffff;
  }

  .featuredImage {
    min-height: 100%;
    overflow: hidden;
  }

  .featuredImage img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
    filter: saturate(0.96) contrast(0.98);
  }

  .featuredBody {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(36px, 5vw, 72px);
  }

  .unitPill {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 24px;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: inherit;
    font-size: clamp(0.86rem, 0.95vw, 1rem);
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .featuredBody h2 {
    max-width: 12ch;
    margin: clamp(28px, 3.4vw, 48px) 0 0;
    color: #ffffff;
    font-size: clamp(2.8rem, 5vw, 6.2rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.07em;
  }

  .featuredBody p {
    max-width: 560px;
    margin: clamp(24px, 2.6vw, 36px) 0 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: clamp(1.02rem, 1.2vw, 1.25rem);
    line-height: 1.48;
  }

  .cardCta {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 58px;
    margin-top: clamp(34px, 4vw, 56px);
    padding: 0 34px;
    border-radius: 999px;
    background: #ffffff;
    color: #080808;
    text-decoration: none;
    transition:
      gap 0.25s ease,
      background 0.25s ease,
      transform 0.25s ease;
  }

  .cardCta:hover {
    gap: 20px;
    background: #ffc400;
    transform: translateY(-2px);
  }

  .cardGrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 44px);
    margin-top: clamp(34px, 4vw, 58px);
  }

  .unitCard a {
    display: block;
    color: #080808;
    text-decoration: none;
  }

  .unitImage {
    width: 100%;
    aspect-ratio: 1.62 / 1;
    overflow: hidden;
    border-radius: clamp(22px, 1.8vw, 32px);
    background: #e7e7e7;
  }

  .unitImage img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
    transition:
      transform 0.4s ease,
      filter 0.4s ease;
  }

  .unitCard:hover .unitImage img {
    transform: scale(1.035);
    filter: saturate(1.04) contrast(1.03);
  }

  .unitCardHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(22px, 2.4vw, 34px);
  }

  .unitCardHeader .unitPill {
    color: #080808;
  }

  .unitIndex {
    color: #ffc400;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .unitCardTitle {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: end;
    margin-top: clamp(18px, 2vw, 28px);
  }

  .unitCardTitle h3 {
    margin: 0;
    color: #080808;
    font-size: clamp(2.3rem, 4vw, 5rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  .unitCardTitle span {
    font-size: clamp(2.6rem, 4vw, 4.8rem);
    line-height: 0.8;
    transform: translateY(-4px);
  }

  .unitCard p {
    max-width: 620px;
    margin: clamp(18px, 2vw, 28px) 0 0;
    color: rgba(8, 8, 8, 0.62);
    font-size: clamp(1rem, 1.08vw, 1.16rem);
    line-height: 1.5;
  }

  .pageCta {
    display: flex;
    justify-content: center;
    padding:
      0
      clamp(30px, 4vw, 76px)
      clamp(90px, 10vw, 150px);
  }

  .pageCta a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 58px;
    padding: 0 36px;
    border: 1px solid #080808;
    border-radius: 999px;
    background: #ffffff;
    color: #080808;
    text-decoration: none;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      gap 0.25s ease;
  }

  .pageCta a:hover {
    background: #ffc400;
    border-color: #080808;
    gap: 18px;
  }

  /* Hover focus system — estilo cards index */
.unitsCards {
  isolation: isolate;
}

.featuredCard,
.unitCard {
  transition:
    opacity 0.3s ease,
    filter 0.3s ease,
    transform 0.3s ease;
}

.featuredCard {
  position: relative;
  border: 1px solid transparent;
  transition:
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    opacity 0.3s ease,
    filter 0.3s ease,
    transform 0.3s ease;
}

.featuredCard::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow: inset 0 0 0 1px transparent;
  transition: box-shadow 0.3s ease;
}

.featuredCard:hover {
  border-color: rgba(255, 196, 0, 0.85);
  box-shadow: 0 26px 80px rgba(255, 196, 0, 0.12);
  transform: translateY(-2px);
}

.featuredCard:hover::after {
  box-shadow: inset 0 0 0 1px rgba(255, 196, 0, 0.85);
}

.featuredCard:hover .featuredImage img {
  transform: scale(1.035);
  filter: saturate(1.04) contrast(1.04);
}

.featuredImage img {
  transition:
    transform 0.45s ease,
    filter 0.45s ease;
}

.featuredCard:hover .unitPill {
  color: #ffc400;
  border-color: #ffc400;
}

.featuredCard:hover h2 {
  color: #ffc400;
}

.featuredCard:hover .cardCta {
  background: #ffc400;
  color: #080808;
  gap: 20px;
}

/* Cards secundarias */
.unitCard a {
  position: relative;
}

.unitImage {
  border: 1px solid transparent;
  transition:
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    filter 0.3s ease;
}

.unitCard:hover {
  transform: translateY(-2px);
}

.unitCard:hover .unitImage {
  border-color: rgba(255, 196, 0, 0.85);
  box-shadow: 0 24px 70px rgba(255, 196, 0, 0.12);
}

.unitCard:hover .unitImage img {
  transform: scale(1.035);
  filter: saturate(1.04) contrast(1.04);
}

.unitCard:hover .unitPill {
  color: #ffc400;
  border-color: #ffc400;
}

.unitCard:hover .unitIndex,
.unitCard:hover .unitCardTitle h3,
.unitCard:hover .unitCardTitle span {
  color: #ffc400;
}

.unitCardTitle h3,
.unitCardTitle span,
.unitPill,
.unitIndex {
  transition:
    color 0.25s ease,
    border-color 0.25s ease,
    transform 0.25s ease;
}

.unitCard:hover .unitCardTitle span {
  transform: translate(4px, -8px);
}

/* Cuando una card está activa, las otras bajan presencia */
.unitsCards:has(.featuredCard:hover) .unitCard {
  opacity: 0.38;
  filter: grayscale(1);
}

.unitsCards:has(.unitCard:hover) .featuredCard {
  opacity: 0.38;
  filter: grayscale(1);
}

.unitsCards:has(.unitCard:hover) .unitCard:not(:hover) {
  opacity: 0.38;
  filter: grayscale(1);
}

/* Mantener la card activa limpia */
.unitsCards:has(.featuredCard:hover) .featuredCard,
.unitsCards:has(.unitCard:hover) .unitCard:hover {
  opacity: 1;
  filter: none;
}

  @media (max-width: 980px) {
    .unitsHeroGrid,
    .featuredCard,
    .cardGrid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: clamp(3.2rem, 14vw, 7rem);
    }

    .unitsEditorial h2 {
      font-size: clamp(2.15rem, 7vw, 4.2rem);
    }

    .paintLine {
      width: auto;
      max-width: 100%;
      white-space: normal;
    }

    .statementImage {
      height: 460px;
    }

    .featuredImage {
      min-height: 360px;
    }

    .featuredBody h2 {
      max-width: 11ch;
    }
  }

  @media (max-width: 640px) {
    .unitsHero,
    .unitsEditorial,
    .unitsImageSection,
    .unitsCards,
    .pageCta {
      padding-left: 22px;
      padding-right: 22px;
    }

    .statementImage {
      height: 380px;
      border-radius: 24px;
    }

    .featuredCard,
    .unitImage {
      border-radius: 24px;
    }

    .featuredBody {
      padding: 28px 24px 34px;
    }

    .featuredBody h2 {
      font-size: clamp(2.4rem, 12vw, 4.4rem);
    }

    .unitCardTitle h3 {
      font-size: clamp(2.1rem, 10vw, 3.8rem);
    }
  }
</style>