---
import BaseLayout from "@/ui/layouts/BaseLayout.astro";

const heroVideo = "/videos/about-vma-hero.mp4";
const heroPoster =
  "https://nationaldispatching.com/wp-content/uploads/2023/08/LIFT-WITH-PLATFORM-WORK-IN-WAREHOUSE-HANGAR-CONSTRUCTION-FIELD..jpg";

const storyBlocks = [
  {
    kicker: "Misión",
    title: "Resolver altura sin frenar la operación.",
    body:
      "Acompañamos proyectos de obra, industria y mantenimiento con equipos correctos, entregas confiables y respaldo técnico real.",
    image: "/videos/MVA-img1.jpg",
    alt: "Equipo de elevación en contexto operativo",
  },
  {
    kicker: "Visión",
    title: "Ser ágiles sin perder criterio.",
    body:
      "VMA nace para atender con velocidad, cercanía y decisión técnica. Una empresa joven, con experiencia real en el rubro y foco en resolver.",
    image: "https://nationaldispatching.com/wp-content/uploads/2023/08/LIFT-WITH-PLATFORM-WORK-IN-WAREHOUSE-HANGAR-CONSTRUCTION-FIELD..jpg",
    alt: "Equipo de elevación trabajando en obra",
  },
  {
    kicker: "Valores",
    title: "La máquina correcta, en el momento correcto.",
    body:
      "No vendemos capacidad que no necesitás ni prometemos plazos que no podemos cumplir. Priorizamos continuidad operativa, respuesta clara y soporte durante todo el ciclo.",
    image: "/images/Firefly18.jpg",
    alt: "Maquinaria para trabajos en altura",
  },
];
---

<BaseLayout
  title="Nosotros — VMA Rental"
  description="Conocé VMA Rental: alquiler, venta y soporte técnico de plataformas y equipos para trabajos en altura."
>
  <section class="aboutHero">
    <video
      class="aboutHeroMedia"
      src={heroVideo}
      poster={heroPoster}
      muted
      autoplay
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>

    <div class="aboutHeroOverlay" aria-hidden="true"></div>

    <div class="aboutHeroContent">
      <p class="aboutHeroKicker">Nosotros</p>

      <h1 class="aboutHeroTitle">
        Conocemos el trabajo en altura desde adentro.
        <span>Pero no queremos contártelo; queremos demostrártelo.</span>
      </h1>

      <a class="aboutHeroCta" href="/#contacto">
        Hablemos de tu operación
        <span aria-hidden="true">↘</span>
      </a>
    </div>
  </section>

  <section class="aboutStory">
    {
      storyBlocks.map((block, index) => (
        <article class={`aboutStoryBlock ${index % 2 === 1 ? "isReverse" : ""}`} data-reveal>
          <div class="aboutStoryText">
            <p class="aboutStoryKicker">{String(index + 1).padStart(2, "0")} — {block.kicker}</p>
            <h2>{block.title}</h2>
            <p>{block.body}</p>
          </div>

          <figure class="aboutStoryFigure">
            <img src={block.image} alt={block.alt} loading="lazy" decoding="async" />
          </figure>
        </article>
      ))
    }
  </section>

  <section class="aboutClose">
    <div class="aboutCloseInner">
      <p>VMA Rental</p>
      <h2>Equipos, criterio técnico y respuesta para que tu operación no se detenga.</h2>
      <a href="/#contacto">
        Contactar a VMA
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <script is:inline>
    (() => {
      const items = Array.from(document.querySelectorAll("[data-reveal]"));

      if (!items.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("isVisible");
            }
          });
        },
        {
          threshold: 0.18,
          rootMargin: "0px 0px -10% 0px",
        }
      );

      items.forEach((item) => observer.observe(item));
    })();
  </script>
</BaseLayout>

<style>
  :global(html),
  :global(body) {
    background: #070707;
    overflow-x: clip;
  }

  .aboutHero {
    position: relative;
    min-height: 100svh;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow: hidden;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: 150px clamp(24px, 6vw, 96px) 100px;
    background: #070707;
  }

  .aboutHeroMedia {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    filter: saturate(0.88) contrast(1.08) brightness(0.72);
    transform: scale(1.02);
    z-index: 0;
  }

  .aboutHeroOverlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(7, 7, 7, 0.86) 0%,
        rgba(7, 7, 7, 0.66) 42%,
        rgba(7, 7, 7, 0.22) 74%,
        rgba(7, 7, 7, 0.36) 100%
      ),
      linear-gradient(
        180deg,
        rgba(7, 7, 7, 0.1) 0%,
        rgba(7, 7, 7, 0.18) 55%,
        rgba(7, 7, 7, 0.9) 100%
      );
  }

  .aboutHeroContent {
    position: relative;
    z-index: 2;
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .aboutHeroKicker {
    margin: 0 0 28px;
    color: #ffc400;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .aboutHeroTitle {
    margin: 0 0 42px;
    max-width: 22ch;
    color: #ffffff;
    font-size: clamp(2.7rem, 5.6vw, 5.8rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .aboutHeroTitle span {
    display: block;
    color: #ffc400;
    font-style: italic;
  }

  .aboutHeroCta,
  .aboutClose a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 54px;
    padding: 0 28px;
    border-radius: 999px;
    border: 1px solid rgba(255, 196, 0, 0.78);
    color: #f8f5ea;
    text-decoration: none;
    font-weight: 800;
    background: rgba(7, 7, 7, 0.28);
    transition:
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .aboutHeroCta:hover,
  .aboutClose a:hover {
    transform: translateY(-2px);
    background: #ffc400;
    color: #111111;
  }

  .aboutStory {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background: #ffffff;
    color: #111111;
  }

  .aboutStoryBlock {
    min-height: 100svh;
    gap: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    border-bottom: 0;
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 650ms ease,
      transform 650ms ease;
  }

  .aboutStoryBlock.isVisible {
    opacity: 1;
    transform: translateY(0);
  }

  .aboutStoryBlock.isReverse {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .aboutStoryBlock.isReverse .aboutStoryText {
    order: 2;
  }

  .aboutStoryBlock.isReverse .aboutStoryFigure {
    order: 1;
  }

  .aboutStoryText {
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    background: #ffffff;
    padding: 110px clamp(28px, 6vw, 90px);
  }

  .aboutStoryKicker {
    margin: 0 0 28px;
    color: #b89100;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .aboutStoryText h2 {
    margin: 0 0 26px;
    max-width: 12ch;
    color: #111111;
    font-size: clamp(2.4rem, 4.4vw, 4.9rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .aboutStoryText p {
    margin: 0;
    max-width: 54ch;
    color: rgba(17, 17, 17, 0.68);
    font-size: clamp(1rem, 1.22vw, 1.16rem);
    line-height: 1.72;
  }

  .aboutStoryFigure {
    margin: 0;
    min-height: 100svh;
    overflow: hidden;
    background: #111111;
  }

  .aboutStoryFigure img {
    width: 100%;
    height: 100%;
    min-height: 100svh;
    display: block;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.92) contrast(1.04);
  }

  .aboutClose {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 120px 32px;
    background: #070707;
    color: #f8f5ea;
  }

  .aboutCloseInner {
    max-width: 980px;
    text-align: center;
  }

  .aboutClose p {
    margin: 0 0 28px;
    color: #ffc400;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .aboutClose h2 {
    margin: 0 0 42px;
    color: #ffffff;
    font-size: clamp(2.5rem, 4.8vw, 5.2rem);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  @media (max-width: 820px) {
    .aboutHero {
      align-items: flex-end;
      padding: 130px 24px 90px;
    }

    .aboutHeroTitle {
      max-width: 12ch;
      font-size: clamp(2.35rem, 10.5vw, 4rem);
    }

    .aboutStoryBlock,
    .aboutStoryBlock.isReverse {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .aboutStoryBlock.isReverse .aboutStoryText,
    .aboutStoryBlock.isReverse .aboutStoryFigure {
      order: initial;
    }

    .aboutStoryText {
      padding: 84px 24px;
    }

    .aboutStoryText h2 {
      max-width: 100%;
    }

    .aboutStoryFigure,
    .aboutStoryFigure img {
      min-height: 62svh;
    }
  }
</style>
