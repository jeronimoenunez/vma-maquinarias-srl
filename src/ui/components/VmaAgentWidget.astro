---
import { waCotizarUrl } from "@/config/site";

const apiUrl =
  import.meta.env.PUBLIC_VMA_AGENT_API_URL ??
  "https://agente.vantorastudio.com/api/vma/agent";
---

<div
  class="vma-agent"
  data-vma-agent-widget
  data-api-url={apiUrl}
  data-whatsapp-url={waCotizarUrl}
>
  <button class="vma-agent__launcher" type="button" aria-label="Abrir asistente de VMA">
    <span class="vma-agent__launcherDot" aria-hidden="true"></span>
    <span class="vma-agent__launcherText">
      <strong>Asistente VMA</strong>
      <small>Online ahora</small>
    </span>
  </button>

  <section class="vma-agent__panel" aria-label="Asistente comercial VMA" hidden>
    <header class="vma-agent__header">
      <div class="vma-agent__brand">
        <img
          src="/brand/Isotipo-FavIcon.png"
          alt=""
          class="vma-agent__brandMark"
          loading="eager"
          decoding="async"
        />
        <div class="vma-agent__brandText">
          <p>VMA Rental</p>
          <h2>Equipo comercial</h2>
          <span>Online ahora</span>
        </div>
      </div>

      <button class="vma-agent__close" type="button" aria-label="Cerrar asistente">×</button>
    </header>

    <div class="vma-agent__messages" data-messages>
      <article class="vma-agent__message vma-agent__message--intro" data-role="assistant">
        <strong>VMA</strong>
        <p>Hola, soy el asistente de VMA.
Contame qué necesitás resolver y te ayudo a ordenar la consulta.

Cómo te llamás y en qué te puedo ayudar?</p>
      </article>
    </div>

    <form class="vma-agent__form" data-form>
      <label class="sr-only" for="vma-agent-message">Escribí tu consulta</label>
      <textarea
        id="vma-agent-message"
        name="message"
        rows="2"
        placeholder=""
        required
      ></textarea>

      <button type="submit">
        <span>Enviar</span>
      </button>
    </form>

    <footer class="vma-agent__footer">
      <p data-footer-note>El equipo comercial ya conoce todo el contexto de la conversación.</p>
    </footer>
  </section>
</div>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .vma-agent {
    position: fixed;
    right: 22px;
    bottom: 20px;
    z-index: 9998;
    font-family: var(--font-body, Inter, system-ui, sans-serif);
  }

  .vma-agent__launcher {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid rgba(255, 196, 0, 0.52);
    border-radius: 999px;
    background: rgba(18, 19, 21, 0.96);
    color: #f8f5ea;
    padding: 11px 16px;
    box-shadow: 0 20px 70px rgba(0, 0, 0, 0.38);
    cursor: pointer;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }

  .vma-agent__launcher:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 196, 0, 0.92);
    background: rgba(20, 21, 23, 1);
  }

  .vma-agent__launcherDot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #ffc400;
    box-shadow: 0 0 0 7px rgba(255, 196, 0, 0.14);
  }

  .vma-agent__launcherText {
    display: grid;
    gap: 3px;
    text-align: left;
  }

  .vma-agent__launcherText strong {
    font-size: 14px;
    line-height: 1;
  }

  .vma-agent__launcherText small {
    color: rgba(248, 245, 234, 0.58);
    font-size: 11px;
    line-height: 1;
  }

  .vma-agent__panel[hidden] {
    display: none !important;
  }

  .vma-agent__panel {
    position: absolute;
    right: 0;
    bottom: 68px;
    width: min(388px, calc(100vw - 28px));
    max-height: min(660px, calc(100vh - 110px));
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid rgba(255, 196, 0, 0.86);
    background: #15161a;
    color: #f8f5ea;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.52);
  }

  .vma-agent__header {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
    padding: 18px 26px;
    background: #202126;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .vma-agent__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .vma-agent__brandMark {
    width: 38px;
    height: 38px;
    object-fit: contain;
    display: none;
  }

  .vma-agent__brandText p {
    margin: 0 0 2px;
    color: #ffc400;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .vma-agent__brandText h2 {
    margin: 0;
    color: #ffffff;
    font-size: 18px;
    line-height: 1.1;
    font-weight: 500;
  }

  .vma-agent__brandText span {
    display: inline-block;
    margin-top: 4px;
    color: rgba(248, 245, 234, 0.56);
    font-size: 12px;
  }

  .vma-agent__close {
    border: 0;
    background: transparent;
    color: rgba(248, 245, 234, 0.72);
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }

  .vma-agent__close:hover {
    color: rgb(255, 200, 0);
  }

  .vma-agent__messages {
    display: flex;
    flex-direction: column;
    gap: 18px;
    overflow-y: auto;
    padding: 20px 20px 18px;
    background: #15161a;
    scroll-behavior: smooth;
  }

  .vma-agent__message {
    display: block;
    width: min(310px, 82%);
    max-width: 82%;
    border-radius: 14px;
    padding: 14px 15px;
    font-size: 15px;
    line-height: 1.35;
    word-break: break-word;
    white-space: pre-wrap;
    clear: both;
  }

  .vma-agent__message strong {
    display: block;
    margin-bottom: 8px;
    font-size: 12px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .vma-agent__message p {
    margin: 0;
  }

  .vma-agent__message[data-role="assistant"] {
    align-self: flex-start !important;
    margin-left: 0 !important;
    margin-right: auto !important;
    width: min(310px, 82%) !important;
    max-width: 82% !important;
    background: #28292e !important;
    color: rgba(248, 245, 234, 0.92) !important;
    border-radius: 14px 14px 14px 5px !important;
  }

  .vma-agent__message[data-role="assistant"] strong {
    color: #ffc400;
  }

   .vma-agent__message[data-role="user"] {
    align-self: flex-end !important;
    margin-left: auto !important;
    margin-right: 0 !important;
    width: min(305px, 78%) !important;
    max-width: 78% !important;
    background: #f8f5ea !important;
    color: #17181b !important;
    border-radius: 14px 14px 5px 14px !important;
    font-size: 15.5px;
    line-height: 1.32;
    font-weight: 500;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
  }

  .vma-agent__message[data-role="user"] strong {
    color: #d19b00;
  }

  .vma-agent__message[data-role="user"] strong:empty {
    display: none;
  }

  .vma-agent__message[data-role="system"] {
    align-self: center !important;
    max-width: 94%;
    background: rgba(255, 196, 0, 0.12) !important;
    color: rgba(248, 245, 234, 0.86) !important;
    border: 1px solid rgba(255, 196, 0, 0.2);
    font-size: 13px;
    text-align: center;
  }

  .vma-agent__message[data-role="system"] strong {
    display: none;
  }

  .vma-agent__handoff {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 40px;
    margin-top: 12px;
    border-radius: 8px;
    background: #1ecb5a;
    color: #07100b;
    text-decoration: none;
    font-size: 13px;
    font-weight: 900;
  }

  .vma-agent__handoff:hover {
    filter: brightness(1.04);
  }

  .vma-agent__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    padding: 14px 14px 10px;
    background: #15161a;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .vma-agent__form textarea {
    resize: none;
    min-height: 42px;
    max-height: 96px;
    border: 1px solid rgba(255, 196, 0, 0.58);
    border-radius: 6px;
    padding: 10px 12px;
    background: #191a1f;
    color: #f8f5ea;
    font: inherit;
    outline: none;
  }

  .vma-agent__form textarea::placeholder {
    color: rgba(248, 245, 234, 0.36);
  }

  .vma-agent__form textarea:focus {
    border-color: rgba(255, 196, 0, 0.95);
    box-shadow: 0 0 0 2px rgba(255, 196, 0, 0.08);
  }

  .vma-agent__form button {
    width: 100%;
    min-height: 40px;
    border: 0;
    border-radius: 5px;
    padding: 0 14px;
    background: #ffc400;
    color: #111111;
    cursor: pointer;
    font-weight: 900;
    transition:
      background 180ms ease,
      color 180ms ease,
      opacity 180ms ease;
  }

  .vma-agent__form button.isHandoffMode {
    background: rgba(255, 196, 0, 0.35);
    color: rgba(17, 17, 17, 0.72);
  }

  .vma-agent__form button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .vma-agent__footer {
    display: grid;
    gap: 9px;
    padding: 0 14px 14px;
    background: #15161a;
  }

  .vma-agent__whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    border-radius: 8px;
    background: #1ecb5a;
    color: #07100b;
    text-decoration: none;
    font-size: 13px;
    font-weight: 900;
  }

  .vma-agent__whatsapp[hidden] {
    display: none !important;
  }

  .vma-agent__footer p {
    margin: 0;
    text-align: center;
    color: rgba(248, 245, 234, 0.34);
    font-size: 11px;
  }

  @media (max-width: 640px) {
    .vma-agent {
      right: 12px;
      bottom: 12px;
    }

    .vma-agent__launcher {
      padding: 10px 13px;
    }

    .vma-agent__panel {
      right: -2px;
      bottom: 64px;
      width: calc(100vw - 20px);
      max-height: calc(100vh - 96px);
      border-radius: 14px;
    }

    .vma-agent__messages {
      max-height: 52vh;
    }
  }

  /* FORCE CHAT BUBBLE ALIGNMENT */
  .vma-agent .vma-agent__messages {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
  }

  .vma-agent .vma-agent__message[data-role="assistant"] {
    align-self: flex-start !important;
    margin-left: 0 !important;
    margin-right: auto !important;
    width: 100%;
    max-width: 82% !important;
    background: #28292e !important;
    color: rgba(248, 245, 234, 0.92) !important;
    border-radius: 14px 14px 14px 5px !important;
  }

  .vma-agent .vma-agent__message[data-role="user"] {
    align-self: flex-end !important;
    margin-left: auto !important;
    margin-right: 0 !important;
    width: 100%;
    max-width: 78% !important;
    background: #f8f5ea !important;
    color: #17181b !important;
    border-radius: 14px 14px 5px 14px !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18) !important;
  }

  .vma-agent .vma-agent__message[data-role="user"] strong {
    color: #d19b00 !important;
  }

  .vma-agent .vma-agent__message[data-role="assistant"] strong {
    color: #ffc400 !important;
  }

  .vma-agent .vma-agent__message[data-role="system"] {
    align-self: center !important;
    max-width: 94% !important;
    background: rgba(255, 196, 0, 0.12) !important;
    color: rgba(248, 245, 234, 0.86) !important;
    border: 1px solid rgba(255, 196, 0, 0.2) !important;
    text-align: center !important;
  }
</style>

<script>
  const STORAGE_KEY = "vma_agent_chat_v1";
  const SESSION_KEY = "vma_agent_session_v1";
  const USER_NAME_KEY = "vma_agent_user_name_v1";

  type StoredMessage = {
    role: "user" | "assistant";
    content: string;
  };

  type MessageRole = "user" | "assistant" | "system";

  const root = document.querySelector<HTMLElement>("[data-vma-agent-widget]");
  const button = root?.querySelector<HTMLButtonElement>(".vma-agent__launcher");
  const panel = root?.querySelector<HTMLElement>(".vma-agent__panel");
  const closeButton = root?.querySelector<HTMLButtonElement>(".vma-agent__close");
  const messagesEl = root?.querySelector<HTMLElement>("[data-messages]");
  const form = root?.querySelector<HTMLFormElement>("[data-form]");
  const textarea = form?.querySelector<HTMLTextAreaElement>("textarea");
  const submitButton = form?.querySelector<HTMLButtonElement>("button");
  const apiUrl = root?.getAttribute("data-api-url");

  function track(eventName: string, params = {}) {
    window.dispatchEvent(
      new CustomEvent("vma:analytics", {
        detail: {
          eventName,
          params,
        },
      })
    );

    if (typeof (window as any).gtag === "function") {
      (window as any).gtag("event", eventName, params);
    }
  }

  function formatUserName(name: string) {
    return name
      .trim()
      .replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, "")
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1).toLowerCase())
      .join(" ");
  }

  function inferUserNameFromText(text: string) {
    const clean = text.trim();

    const patterns = [
      /(?:me llamo|mi nombre es|soy)\s+([a-zA-ZáéíóúÁÉÍÓÚñÑ]{2,})(?:\s+([a-zA-ZáéíóúÁÉÍÓÚñÑ]{2,}))?/i,
      /(?:hola,?\s+soy)\s+([a-zA-ZáéíóúÁÉÍÓÚñÑ]{2,})(?:\s+([a-zA-ZáéíóúÁÉÍÓÚñÑ]{2,}))?/i,
    ];

    for (const pattern of patterns) {
      const match = clean.match(pattern);
      if (match?.[1]) {
        return formatUserName([match[1], match[2]].filter(Boolean).join(" "));
      }
    }

    return "";
  }

  function getUserDisplayName() {
    return window.sessionStorage.getItem(USER_NAME_KEY) || "";
  }

  function setUserDisplayName(name: string) {
    const formattedName = formatUserName(name);
    if (!formattedName) return;

    window.sessionStorage.setItem(USER_NAME_KEY, formattedName);
    updateUserLabels();
  }

  function updateUserLabels() {
    if (!messagesEl) return;

    const displayName = getUserDisplayName();
    if (!displayName) return;

    messagesEl
      .querySelectorAll<HTMLElement>('[data-role="user"]')
      .forEach((message) => {
        let label = message.querySelector<HTMLElement>("[data-user-label]");

        if (!label) {
          label = document.createElement("strong");
          label.setAttribute("data-user-label", "true");
          message.prepend(label);
        }

        label.textContent = displayName;
      });
  }

  function createSessionId() {
    if (!window.sessionStorage.getItem(SESSION_KEY)) {
      window.sessionStorage.setItem(SESSION_KEY, `vma_web_${crypto.randomUUID()}`);
    }

    return window.sessionStorage.getItem(SESSION_KEY);
  }

  function getStoredMessages(): StoredMessage[] {
    try {
      const raw = window.sessionStorage.getItem(STORAGE_KEY) || "[]";
      const parsed = JSON.parse(raw);

      if (!Array.isArray(parsed)) return [];

      return parsed.filter((message): message is StoredMessage => {
        return (
          typeof message === "object" &&
          message !== null &&
          (message.role === "user" || message.role === "assistant") &&
          typeof message.content === "string"
        );
      });
    } catch {
      return [];
    }
  }

  function storeMessages(messages: StoredMessage[]) {
    window.sessionStorage.setItem(STORAGE_KEY, JSON.stringify(messages.slice(-20)));
  }

  function scrollToBottom() {
    if (!messagesEl) return;
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function appendMessage(role: MessageRole, content: string, shouldStore = true) {
    if (!messagesEl) return;

    const article = document.createElement("article");
    article.className = "vma-agent__message";
    article.setAttribute("data-role", role);

    const label = document.createElement("strong");
    const userDisplayName = getUserDisplayName();

    label.textContent = role === "user" ? userDisplayName : role === "assistant" ? "VMA" : "";

    if (role === "user") {
      label.setAttribute("data-user-label", "true");
    }

    const paragraph = document.createElement("p");
    paragraph.textContent = content;

    if (role === "assistant" || (role === "user" && userDisplayName)) {
      article.appendChild(label);
    }

    article.appendChild(paragraph);
    messagesEl.appendChild(article);

    if (shouldStore && (role === "user" || role === "assistant")) {
      const stored = getStoredMessages();
      stored.push({ role, content });
      storeMessages(stored);
    }

    scrollToBottom();
  }

  function restoreMessages() {
    const stored = getStoredMessages();
    stored.forEach((message) => appendMessage(message.role, message.content, false));
  }

  function setLoading(isLoading: boolean) {
    if (!submitButton || !textarea) return;

    submitButton.disabled = isLoading;
    textarea.disabled = isLoading;

    if (isLoading) {
      submitButton.textContent = "...";
      return;
    }

    submitButton.textContent = submitButton.classList.contains("isHandoffMode")
      ? "Seguir hablando"
      : "Enviar";
  }

  function setHandoffButtonMode() {
    if (!submitButton) return;

    submitButton.classList.add("isHandoffMode");
    submitButton.textContent = "Seguir hablando";
  }

  function resetHandoffButtonMode() {
    if (!submitButton) return;

    submitButton.classList.remove("isHandoffMode");
    submitButton.textContent = "Enviar";
  }

  function shouldShowWhatsappFromText(text: string) {
    const normalized = text.toLowerCase();

    return [
      "whatsapp",
      "teléfono",
      "telefono",
      "llamar",
      "llamen",
      "llamada",
      "comercial",
      "vendedor",
      "asesor",
      "asesora",
      "soporte",
      "servicio técnico",
      "servicio tecnico",
      "hablar con alguien",
      "hablar con una persona",
    ].some((word) => normalized.includes(word));
  }

  function shouldShowWhatsappFromLead(result: any) {
    const lead = result?.lead;
    if (!lead) return false;

    return Boolean(lead.phone);
  }

  function appendWhatsappHandoffMessage(reason = "ready") {
    if (!messagesEl || !root) return;

    const alreadyExists = messagesEl.querySelector("[data-whatsapp-handoff]");
    if (alreadyExists) return;

    const whatsappUrl = root.getAttribute("data-whatsapp-url") || "";
    if (!whatsappUrl) return;

    const article = document.createElement("article");
    article.className = "vma-agent__message";
    article.setAttribute("data-role", "assistant");
    article.setAttribute("data-whatsapp-handoff", "true");

    const label = document.createElement("strong");
    label.textContent = "VMA";

    const paragraph = document.createElement("p");
    paragraph.textContent =
      reason === "support"
        ? "Perfecto. El equipo de soporte puede retomar la consulta con el contexto que ya compartiste."
        : "Perfecto. El equipo comercial ya tiene el contexto de la consulta y puede continuar por WhatsApp.";

    const link = document.createElement("a");
    link.className = "vma-agent__handoff";
    link.href = whatsappUrl;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.textContent = "Hablar por WhatsApp";

    link.addEventListener("click", () => {
      track("vma_whatsapp_click", {
        page_path: window.location.pathname,
        source: "agent_widget_chat_handoff",
        reason,
      });
    });

    article.appendChild(label);
    article.appendChild(paragraph);
    article.appendChild(link);

    messagesEl.appendChild(article);
    setHandoffButtonMode();
    scrollToBottom();
  }

  function inferContextFromPage() {
    const path = window.location.pathname.toLowerCase();
    const text = document.title.toLowerCase();

    if (path.includes("unidades") || text.includes("unidades")) {
      return {
        intentHint: "alquiler",
        equipmentHint: "equipo de elevación",
        ctaClicked: "asistente flotante desde unidades",
      };
    }

    if (path.includes("metodo") || text.includes("método") || text.includes("metodo")) {
      return {
        intentHint: "consulta_tecnica",
        equipmentHint: "selección técnica de equipo",
        ctaClicked: "asistente flotante desde método",
      };
    }

    return {
      intentHint: "alquiler",
      equipmentHint: "equipo de elevación",
      ctaClicked: "asistente flotante",
    };
  }

  async function sendMessage(message: string) {
    if (!apiUrl) {
      throw new Error("Missing VMA agent API URL");
    }

    const history = getStoredMessages().slice(-10);
    const pagePath = window.location.pathname;
    const context = inferContextFromPage();

    const response = await fetch(apiUrl, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        sessionId: createSessionId(),
        message,
        history,
        page: pagePath,
        pagePath,
        source: "vma-web",
        context,
      }),
    });

    if (!response.ok) {
      throw new Error(`VMA agent request failed: ${response.status}`);
    }

    return response.json();
  }

  button?.addEventListener("click", () => {
    if (!panel) return;

    panel.hidden = !panel.hidden;

    if (!panel.hidden) {
      track("vma_agent_open", {
        page_path: window.location.pathname,
      });
      textarea?.focus();
      scrollToBottom();
    }
  });

  closeButton?.addEventListener("click", () => {
    if (!panel) return;
    panel.hidden = true;
  });

  textarea?.addEventListener("input", () => {
    if (textarea.value.trim()) {
      resetHandoffButtonMode();
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const message = textarea?.value.trim();

    if (!message || !textarea) return;

    textarea.value = "";

    const inferredName = inferUserNameFromText(message);
    if (inferredName) {
      setUserDisplayName(inferredName);
    }

    appendMessage("user", message);
    updateUserLabels();

    if (shouldShowWhatsappFromText(message)) {
      appendWhatsappHandoffMessage(message.toLowerCase().includes("soporte") ? "support" : "ready");
    }

    setLoading(true);

    track("vma_agent_message_sent", {
      page_path: window.location.pathname,
    });

    try {
      const result = await sendMessage(message);

      if (!result?.ok || !result?.reply) {
        throw new Error("Invalid VMA agent response");
      }

      appendMessage("assistant", result.reply);

      if (result?.lead?.temperature) {
        track("vma_lead_created", {
          page_path: window.location.pathname,
          temperature: result.lead.temperature,
          intent: result.lead.intent,
          lead_score: result.lead.leadScore,
        });
      }

      if (shouldShowWhatsappFromLead(result)) {
        const intent = result?.lead?.intent;
        appendWhatsappHandoffMessage(intent === "servicio_tecnico" ? "support" : "ready");
      }
    } catch (error) {
      console.error("[vma-agent-widget]", error);
      appendMessage(
        "system",
        "No pude conectar con el asistente en este momento. Intentá nuevamente o escribí que querés hablar con comercial para derivarte por WhatsApp."
      );
    } finally {
      setLoading(false);
      textarea?.focus();
    }
  });


  restoreMessages();
</script>
