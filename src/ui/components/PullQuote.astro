---
type Props = {
  text: string;
  variant?: "hero" | "center" | "free";
};

const { text, variant = "free" } = Astro.props as Props;
---

<blockquote class={`pullQuote pullQuote--${variant}`}>{text}</blockquote>

<style>
  .pullQuote {
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: -0.01em;
    color: var(--quote-color-light);
    margin: 0;
  }

  .pullQuote--hero {
    font-size: clamp(1.05rem, 1.4vw, 1.4rem);
    line-height: 1.4;
    padding: 0.5rem 0 0.5rem 1.25rem;
    border-left: 2px solid var(--quote-color-accent);
    max-width: 540px;
    margin: 1.5rem 0;
  }

  .pullQuote--center {
    font-size: clamp(1.1rem, 1.5vw, 1.45rem);
    line-height: 1.45;
    text-align: center;
    max-width: 620px;
    margin: 2rem auto;
    padding: 1rem 0;
    border-top: 1px solid rgba(234, 242, 247, 0.15);
    border-bottom: 1px solid rgba(234, 242, 247, 0.15);
  }

  .pullQuote--free {
    font-size: clamp(1.15rem, 1.6vw, 1.55rem);
    line-height: 1.4;
    max-width: 600px;
    margin: 1.5rem 0 2rem;
  }
</style>
