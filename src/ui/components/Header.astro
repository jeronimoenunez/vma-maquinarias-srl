---
import Container from "@/ui/components/Container.astro";
import { waCotizarUrl } from "@/config/site";

const navGroups = [
  {
    key: "inicio",
    label: "Inicio",
    href: "/#inicio",
    mobileHref: "/#inicio",
    hasMega: false,
    sectionId: "inicio",
  },
  {
    key: "flota",
    label: "Flota VMA",
    href: "/#equipos",
    mobileHref: "/#equipos",
    hasMega: false,
    sectionId: "equipos",
  },
  {
    key: "sectores",
    label: "Sectores",
    href: "/#sectores",
    mobileHref: "/#sectores",
    hasMega: true,
    sectionId: "sectores",
    eyebrow: "Sectores",
    title: "Soluciones por tipo de operación",
    description:
      "Industria, obra y alquiler flexible requieren decisiones distintas. El objetivo es siempre el mismo: equipo correcto, disponibilidad real y respaldo técnico.",
    cards: [
      {
        title: "Industria y planta",
        subtitle: "Contratos, equipos dedicados y continuidad",
        href: "/#sectores",
        image:
          "https://images.unsplash.com/photo-1717386255773-1e3037c81788?q=80&w=2340&auto=format&fit=crop",
      },
      {
        title: "Construcción y obra",
        subtitle: "Entrega coordinada y soporte en sitio",
        href: "/#sectores",
        image: "/images/Firefly19.jpg",
      },
      {
        title: "Alquiler flexible",
        subtitle: "Planes según operación y duración",
        href: "/#sectores",
        image: "/images/optimized/Firefly-10.png",
      },
    ],
    links: [
      { label: "Ver sectores", href: "/#sectores" },
      { label: "Consultar disponibilidad", href: waCotizarUrl },
    ],
  },
  {
    key: "negocio",
    label: "Sistema VMA",
    href: "/#negocio",
    mobileHref: "/#negocio",
    hasMega: true,
    sectionId: "negocio",
    activePaths: ["/metodo"],
    eyebrow: "Sistema VMA",
    title: "Unidades de negocio y método operativo",
    description:
      "Dos caminos para entender VMA: qué resolvemos y cómo trabajamos antes de recomendar un equipo.",
    cards: [
      {
        title: "Unidades de negocio",
        subtitle: "Alquiler, venta y servicio técnico",
        href: "/unidades",
        image: "/images/Firefly10-1.png",
      },
      {
        title: "Método VMA",
        subtitle: "Análisis, asesoramiento y proyección 360°",
        href: "/metodo",
        image: "/images/Metodo-VMA-Grids.png",
      },
      {
        title: "Continuidad operativa",
        subtitle: "La máquina correcta con respaldo real",
        href: "/#negocio",
        image: "/images/Firefly14.jpg",
      },
    ],
    links: [
      { label: "Ver sistema VMA", href: "/#negocio" },
      { label: "Método VMA", href: "/metodo" },
      { label: "Consultar por WhatsApp", href: waCotizarUrl },
    ],
  },
  {
    key: "faq",
    label: "FAQ",
    href: "/#faq",
    mobileHref: "/#faq",
    hasMega: false,
    sectionId: "faq",
  },
  {
    key: "nosotros",
    label: "Nosotros",
    href: "/nosotros",
    mobileHref: "/nosotros",
    hasMega: false,
    sectionId: "nosotros",
    activePaths: ["/nosotros"],
  },
];

const megaGroups = navGroups.filter((group) => group.hasMega);
const currentPath = Astro.url.pathname;
const isInternalPage = currentPath !== "/";
---

<header class:list={["topNav", { isInternalPage }]} data-topnav>
  <div class="desktopBackdrop" data-nav-backdrop hidden></div>

  <div class="navBar">
    <Container class="navInner">
      <a class="brand" href="/#inicio" aria-label="VMA Rental">
        <img
          class="brandImage"
          src="/brand/Isologotipo.png"
          alt="VMA Rental"
          loading="eager"
          decoding="async"
        />
      </a>

      <nav class="tabs" aria-label="Navegación principal" data-mobile-nav>
        {
          navGroups.map((group) => (
            <a
              class="tab"
              href={group.href}
              data-tab
              data-section-id={group.sectionId ?? group.key}
              data-menu-trigger={group.hasMega ? group.key : undefined}
            >
              {group.label}
            </a>
          ))
        }

        <a class="mobileOnlyCta" href="/#contacto" data-mobile-contact>
          Contacto
        </a>
      </nav>

      <div class="right">
        <a class="navCta" href="/#contacto">
          Contacto
        </a>

        <button
          class="mobileMenuButton"
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          data-mobile-menu-button
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </Container>
  </div>

  <div class="megaMenu" data-mega-menu hidden>
    <Container class="megaInner">
      {
        megaGroups.map((group) => (
          <section class="megaPanel" data-mega-panel={group.key} hidden>
            <div class="megaIntro">
              <p class="megaEyebrow">{group.eyebrow}</p>
              <h2 class="megaTitle">{group.title}</h2>
              <p class="megaDescription">{group.description}</p>
            </div>

            <div class="megaCards">
              {group.cards?.map((card) => (
                <a class="megaCard" href={card.href}>
                  <div
                    class="megaCardImage"
                    style={`--nav-card-image: url('${card.image}')`}
                    aria-hidden="true"
                  ></div>

                  <div class="megaCardBody">
                    <strong>{card.title}</strong>
                    <span>{card.subtitle}</span>
                  </div>
                </a>
              ))}
            </div>

            <aside class="megaAside">
              <p class="megaAsideTitle">Acciones</p>

              <div class="megaAsideLinks">
                {group.links?.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </div>
            </aside>
          </section>
        ))
      }
    </Container>
  </div>
</header>

<style>
  [hidden] {
    display: none !important;
  }

  .topNav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 9999;
    width: 100%;
    max-width: 100%;
    pointer-events: none;
  }

  .desktopBackdrop {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: auto;
    opacity: 0;
    background: rgba(10, 12, 14, 0.14);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: opacity 0.22s ease;
  }

  .topNav.isMenuOpen .desktopBackdrop {
    opacity: 1;
  }

  .navBar {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 100%;
    pointer-events: auto;
    background: transparent;
    border: 0 !important;
    border-bottom: 0 !important;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition:
      background 0.24s ease,
      box-shadow 0.24s ease,
      backdrop-filter 0.24s ease;
  }

  .topNav.isScrolled .navBar,
  .topNav.isMenuOpen .navBar,
  .topNav.isInternalPage .navBar {
    background: rgba(4, 7, 9, 0.58);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(18px) saturate(1.16);
    -webkit-backdrop-filter: blur(18px) saturate(1.16);
  }

  .navBar :global(.container.navInner) {
    width: min(1639px, calc(100% - 56px));
    max-width: calc(100% - 56px);
    min-height: 72px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
  }

  .brand {
    position: relative;
    z-index: 10002;
    display: inline-flex;
    align-items: center;
    min-width: 0;
    line-height: 0;
    text-decoration: none;
  }

  .brandImage {
    display: block;
    width: clamp(118px,10.5vw,163px);
    height: auto;
    max-height: 48px;
    object-fit: contain;
  }

  .tabs {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    gap: 45px;
    min-width: 0;
  }

  .tab {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 0;
    white-space: nowrap;
    background: transparent;
    box-shadow: none;
    font-weight: 500;
    font-size: 16px;
    color: rgba(255, 255, 255, 1);
    text-decoration: none;
    transition:
      color 0.18s ease,
      opacity 0.18s ease;
  }

  .tab:hover,
  .tab.isMenuActive,
  .tab.isActive {
    color: #ffc400;
  }

  .tab.isActive {
    font-weight: 800;
  }

  .right {
    position: relative;
    z-index: 10002;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    justify-self: end;
  }

  .navCta,
  .mobileOnlyCta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid rgba(255, 196, 0, 0.7);
    border-radius: 10px;
    background: rgba(255, 196, 0, 0.08);
    color: #ffc400;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .navCta:hover,
  .mobileOnlyCta:hover {
    background: #ffc400;
    border-color: #ffc400;
    color: #070707;
    box-shadow: 0 16px 44px rgba(255, 196, 0, 0.18);
    transform: translateY(-1px);
  }

  .mobileOnlyCta {
    display: none;
  }

  .mobileMenuButton {
    display: none;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    position: relative;
  }

  .mobileMenuButton span {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 2px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    transition:
      transform 0.22s ease,
      opacity 0.18s ease,
      top 0.22s ease;
  }

  .mobileMenuButton span:nth-child(1) {
    top: 15px;
  }

  .mobileMenuButton span:nth-child(2) {
    top: 23px;
  }

  .mobileMenuButton span:nth-child(3) {
    top: 31px;
  }

  .mobileMenuButton.is-open span:nth-child(1) {
    top: 23px;
    transform: rotate(45deg);
  }

  .mobileMenuButton.is-open span:nth-child(2) {
    opacity: 0;
  }

  .mobileMenuButton.is-open span:nth-child(3) {
    top: 23px;
    transform: rotate(-45deg);
  }

  .megaMenu {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    z-index: 2;
    pointer-events: auto;
    background: rgba(246, 245, 241, 0.88);
    border: 0 !important;
    border-bottom: 0 !important;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(24px) saturate(1.18);
    -webkit-backdrop-filter: blur(24px) saturate(1.18);
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  .topNav.isMenuOpen .megaMenu {
    opacity: 1;
    transform: translateY(0);
  }

  .megaMenu :global(.container.megaInner) {
    width: min(1360px, calc(100% - 56px));
    max-width: calc(100% - 56px);
    margin: 0 auto;
  }

  .megaPanel {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr) 220px;
    gap: 40px;
    padding: 34px 0 38px;
    align-items: start;
  }

  .megaPanel.isActive {
    display: grid !important;
  }

  .megaIntro {
    max-width: 300px;
  }

  .megaEyebrow {
    margin: 0 0 12px;
    color: #b58c00;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .megaTitle {
    margin: 0;
    color: #101214;
    font-size: clamp(1.85rem, 2.1vw, 2.5rem);
    line-height: 1.04;
    letter-spacing: -0.05em;
    font-weight: 600;
  }

  .megaDescription {
    margin: 16px 0 0;
    color: rgba(16, 18, 20, 0.62);
    font-size: 0.96rem;
    line-height: 1.6;
  }

  .megaCards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .megaCard {
    display: block;
    color: #101214;
    text-decoration: none;
  }

  .megaCardImage {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #d7d2c1;
    background-image:
      linear-gradient(
        135deg,
        rgba(255, 196, 0, 0.18),
        rgba(16, 18, 20, 0.12)
      ),
      var(--nav-card-image);
    background-size: cover;
    background-position: center;
    border-radius: 12px;
    transition:
      transform 0.28s ease,
      filter 0.28s ease;
  }

  .megaCard:hover .megaCardImage {
    transform: scale(1.025);
    filter: saturate(1.03) contrast(1.03);
  }

  .megaCardBody {
    padding-top: 14px;
  }

  .megaCardBody strong {
    display: block;
    color: #101214;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .megaCardBody span {
    display: block;
    margin-top: 6px;
    color: rgba(16, 18, 20, 0.58);
    font-size: 0.86rem;
    line-height: 1.42;
  }

  .megaAside {
    border-left: 1px solid rgba(16, 18, 20, 0.1);
    padding-left: 28px;
  }

  .megaAsideTitle {
    margin: 0 0 18px;
    color: #101214;
    font-size: 0.92rem;
    font-weight: 800;
  }

  .megaAsideLinks {
    display: grid;
    gap: 16px;
  }

  .megaAsideLinks a {
    color: rgba(16, 18, 20, 0.68);
    font-size: 0.95rem;
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .megaAsideLinks a:hover {
    color: #101214;
  }

  @media (max-width: 1180px) {
    .tabs {
      gap: 28px;
    }

    .megaPanel {
      grid-template-columns: 280px minmax(0, 1fr);
    }

    .megaAside {
      grid-column: 1 / -1;
      border-left: 0;
      border-top: 1px solid rgba(16, 18, 20, 0.1);
      padding-left: 0;
      padding-top: 20px;
    }
  }

  @media (max-width: 860px) {
    .desktopBackdrop,
    .megaMenu {
      display: none !important;
    }

    .topNav {
      overflow: visible;
    }

    .navBar,
    .topNav.isScrolled .navBar,
    .topNav.isMenuOpen .navBar,
    .topNav.isInternalPage .navBar {
      background: rgba(3, 3, 3, 0.92);
      border: 0 !important;
      box-shadow: none;
      backdrop-filter: blur(18px) saturate(1.1);
      -webkit-backdrop-filter: blur(18px) saturate(1.1);
    }

    .navBar :global(.container.navInner) {
      width: 100%;
      max-width: 100%;
      min-height: 76px;
      padding: 0 16px;
      grid-template-columns: auto auto;
      gap: 16px;
      justify-content: space-between;
    }

    .brandImage {
      width: 90px;
      max-height: 42px;
    }

    .right {
      gap: 0;
    }

    .navCta {
      display: none;
    }


    .topNav.isMobileMenuOpen .brand {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .topNav.isMobileMenuOpen .navBar,
    .topNav.isMobileMenuOpen .tabs {
      background: #030303 !important;
    }

    .mobileMenuButton {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      z-index: 10003;
    }

    .tabs {
      position: fixed;
      inset: 0;
      z-index: 10001;
      width: 100%;
      height: 100dvh;
      min-height: 100vh;
      padding: 112px 24px 42px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      background: #030303;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-10px);
      transition:
        opacity 0.24s ease,
        visibility 0.24s ease,
        transform 0.24s ease;
      overflow-y: auto;
      overflow-x: hidden;
    }

    .tabs.is-mobile-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .tab {
      width: 100%;
      height: auto;
      min-height: 62px;
      justify-content: flex-start;
      padding: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      color: rgba(255, 255, 255, 0.88);
      font-size: clamp(2rem, 11vw, 3.45rem);
      font-weight: 500;
      line-height: 0.98;
      letter-spacing: -0.055em;
      text-align: left;
    }

    .tab.isActive,
    .tab:hover,
    .tab.isMenuActive {
      color: #ffc400;
    }

    .mobileOnlyCta {
      display: inline-flex;
      width: fit-content;
      min-height: 46px;
      margin-top: 28px;
      padding: 0 22px;
      border-radius: 999px;
      font-size: 0.96rem;
    }
  }
</style>

<script type="module">
  const root = document.querySelector("[data-topnav]");

  if (root) {
    const navBar = root.querySelector(".navBar");
    const menu = root.querySelector("[data-mega-menu]");
    const backdrop = root.querySelector("[data-nav-backdrop]");
    const tabs = Array.from(root.querySelectorAll("[data-tab]"));
    const triggers = Array.from(root.querySelectorAll("[data-menu-trigger]"));
    const panels = Array.from(root.querySelectorAll("[data-mega-panel]"));
    const megaLinks = Array.from(root.querySelectorAll(".megaMenu a"));
    const brand = root.querySelector(".brand");
    const navCta = root.querySelector(".navCta");
    const mobileContact = root.querySelector("[data-mobile-contact]");
    const mobileButton = root.querySelector("[data-mobile-menu-button]");
    const mobileNav = root.querySelector("[data-mobile-nav]");

    let closeTimer = null;
    let ticking = false;

    const getHashFromHref = (href) => {
      if (!href) return "";
      const hashIndex = href.indexOf("#");
      return hashIndex >= 0 ? href.slice(hashIndex + 1) : "";
    };

    const getTabSectionId = (tab) => {
      return tab.dataset.sectionId || getHashFromHref(tab.getAttribute("href") || "");
    };

    const getHeaderOffset = () => {
      const navHeight = navBar?.getBoundingClientRect().height ?? 76;
      return navHeight + 14;
    };

    const isMobile = () => window.matchMedia("(max-width: 860px)").matches;

    const setScrolled = () => {
      root.classList.toggle("isScrolled", window.scrollY > 18);
    };

    const clearCloseTimer = () => {
      if (closeTimer) {
        window.clearTimeout(closeTimer);
        closeTimer = null;
      }
    };

    const closeDesktopMega = () => {
      if (!menu || !backdrop) return;

      root.classList.remove("isMenuOpen");

      panels.forEach((panel) => {
        panel.hidden = true;
        panel.classList.remove("isActive");
      });

      triggers.forEach((trigger) => {
        trigger.classList.remove("isMenuActive");
      });

      window.setTimeout(() => {
        if (!root.classList.contains("isMenuOpen")) {
          menu.hidden = true;
          backdrop.hidden = true;
        }
      }, 220);
    };

    const openDesktopMega = (key) => {
      if (!menu || !backdrop || !key || isMobile()) return;

      clearCloseTimer();

      menu.hidden = false;
      backdrop.hidden = false;
      root.classList.add("isMenuOpen");

      panels.forEach((panel) => {
        const isActive = panel.getAttribute("data-mega-panel") === key;
        panel.hidden = !isActive;
        panel.classList.toggle("isActive", isActive);
      });

      triggers.forEach((trigger) => {
        trigger.classList.toggle(
          "isMenuActive",
          trigger.getAttribute("data-menu-trigger") === key
        );
      });
    };

    const scheduleClose = () => {
      if (isMobile()) return;
      clearCloseTimer();
      closeTimer = window.setTimeout(closeDesktopMega, 140);
    };

    const openMobileMenu = () => {
      if (!mobileButton || !mobileNav) return;

      closeDesktopMega();

      mobileButton.classList.add("is-open");
      mobileButton.setAttribute("aria-expanded", "true");
      mobileButton.setAttribute("aria-label", "Cerrar menú");

      mobileNav.classList.add("is-mobile-open");
      root.classList.add("isMobileMenuOpen");
      document.documentElement.classList.add("mobile-menu-open");
      document.body.classList.add("mobile-menu-open");
    };

    const closeMobileMenu = () => {
      if (!mobileButton || !mobileNav) return;

      mobileButton.classList.remove("is-open");
      mobileButton.setAttribute("aria-expanded", "false");
      mobileButton.setAttribute("aria-label", "Abrir menú");

      mobileNav.classList.remove("is-mobile-open");
      root.classList.remove("isMobileMenuOpen");
      document.documentElement.classList.remove("mobile-menu-open");
      document.body.classList.remove("mobile-menu-open");
    };

    const setActive = (id) => {
      tabs.forEach((tab) => {
        const tabId = getTabSectionId(tab);
        tab.classList.toggle("isActive", tabId === id);
      });

      navCta?.classList.toggle("isActive", id === "contacto");
      mobileContact?.classList.toggle("isActive", id === "contacto");
    };

    const sectionIds = Array.from(
      new Set([...tabs.map((tab) => getTabSectionId(tab)), "contacto"])
    ).filter(Boolean);

    const getSections = () => {
      return sectionIds.map((id) => document.getElementById(id)).filter(Boolean);
    };

    const updateActiveByScroll = () => {
      const sections = getSections();

      if (!sections.length) {
        setActive("inicio");
        ticking = false;
        return;
      }

      const offset = getHeaderOffset();
      const marker = window.scrollY + offset + window.innerHeight * 0.22;

      let currentId = sections[0].id;

      sections.forEach((section) => {
        if (marker >= section.offsetTop) {
          currentId = section.id;
        }
      });

      const bottomReached =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 8;

      if (bottomReached) {
        const lastSection = sections[sections.length - 1];
        if (lastSection?.id) currentId = lastSection.id;
      }

      setActive(currentId);
      ticking = false;
    };

    const requestActiveUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateActiveByScroll);
    };

    const scrollToHash = (href) => {
      const id = getHashFromHref(href);
      if (!id) return false;

      const target = document.getElementById(id);
      if (!target) return false;

      const offset = getHeaderOffset();
      const top = target.getBoundingClientRect().top + window.scrollY - offset;

      window.history.pushState(null, "", `#${id}`);
      window.scrollTo({
        top,
        behavior: "smooth",
      });

      setActive(id);
      closeDesktopMega();
      closeMobileMenu();

      return true;
    };

    triggers.forEach((trigger) => {
      const key = trigger.getAttribute("data-menu-trigger");

      trigger.addEventListener("mouseenter", () => openDesktopMega(key));
      trigger.addEventListener("focus", () => openDesktopMega(key));
    });

    tabs.forEach((tab) => {
      tab.addEventListener("click", (event) => {
        const href = tab.getAttribute("href") || "";

        if (href.includes("#")) {
          const handled = scrollToHash(href);
          if (handled) event.preventDefault();
        } else {
          closeDesktopMega();
          closeMobileMenu();
        }
      });
    });

    megaLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href") || "";

        if (href.includes("#")) {
          const handled = scrollToHash(href);
          if (handled) event.preventDefault();
        } else {
          closeDesktopMega();
        }
      });
    });

    mobileContact?.addEventListener("click", (event) => {
      const handled = scrollToHash("/#contacto");
      if (handled) event.preventDefault();
    });

    brand?.addEventListener("click", (event) => {
      const handled = scrollToHash("/#inicio");
      if (handled) event.preventDefault();
    });

    navCta?.addEventListener("click", (event) => {
      const handled = scrollToHash("/#contacto");
      if (handled) event.preventDefault();
    });

    mobileButton?.addEventListener("click", () => {
      const isOpen = mobileButton.classList.contains("is-open");
      isOpen ? closeMobileMenu() : openMobileMenu();
    });

    navBar?.addEventListener("mouseenter", clearCloseTimer);
    navBar?.addEventListener("mouseleave", scheduleClose);
    menu?.addEventListener("mouseenter", clearCloseTimer);
    menu?.addEventListener("mouseleave", scheduleClose);
    backdrop?.addEventListener("mouseenter", scheduleClose);
    backdrop?.addEventListener("click", closeDesktopMega);

    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeDesktopMega();
        closeMobileMenu();
      }
    });

    window.addEventListener(
      "scroll",
      () => {
        setScrolled();
        requestActiveUpdate();
      },
      { passive: true }
    );

    window.addEventListener("resize", () => {
      if (!isMobile()) closeMobileMenu();
      requestActiveUpdate();
    });

    window.addEventListener("load", () => {
      const initialHash = window.location.hash?.replace("#", "");

      if (initialHash) {
        const target = document.getElementById(initialHash);
        if (target) {
          window.setTimeout(() => {
            scrollToHash(`#${initialHash}`);
          }, 80);
          return;
        }
      }

      updateActiveByScroll();
    });

    setScrolled();
    updateActiveByScroll();
  }
</script>

