---
import Container from "@/ui/components/Container.astro";
import { waCotizarUrl } from "@/config/site";

const navGroups = [
  {
    key: "inicio",
    label: "Inicio",
    href: "/#inicio",
    hasMega: false,
  },
  {
  key: "nosotros",
  label: "Nosotros",
  href: "/nosotros",
  hasMega: false,
  sectionId: "nosotros",
},
  {
    key: "sectores",
    label: "Sectores",
    href: "/#sectores",
    hasMega: true,
    eyebrow: "Sectores",
    title: "Soluciones por tipo de operación",
    description:
      "Industria, obra y alquiler flexible requieren decisiones distintas. El objetivo es siempre el mismo: equipo correcto, disponibilidad real y respaldo técnico.",
    cards: [
      {
        title: "Industria y planta",
        subtitle: "Contratos, equipos dedicados y continuidad",
        href: "/#sectores",
        image: "https://images.unsplash.com/photo-1717386255773-1e3037c81788?q=80&w=2340&auto=format&fit=crop",
      },
      {
        title: "Construcción y obra",
        subtitle: "Entrega coordinada y soporte en sitio",
        href: "/#sectores",
        image: "./images/Firefly19.jpg",
      },
      {
        title: "Alquiler flexible",
        subtitle: "Planes según operación y duración",
        href: "/#sectores",
        image: "./images/Firefly9.jpg",
      },
    ],
    links: [
      { label: "Ver sectores", href: "/#sectores" },
      { label: "Consultar disponibilidad", href: waCotizarUrl },
    ],
  },
  {
    key: "negocio",
    label: "Sistema VMA",
    href: "/#negocio",
    hasMega: true,
    eyebrow: "Sistema VMA",
    title: "Unidades de negocio y método operativo",
    description:
      "Dos caminos para entender VMA: qué resolvemos y cómo trabajamos antes de recomendar un equipo.",
    cards: [
      {
        title: "Unidades de negocio",
        subtitle: "Alquiler, venta y servicio técnico",
        href: "/unidades",
        image: "./images/Firefly10-1.png",
      },
      {
        title: "Método VMA",
        subtitle: "Análisis, asesoramiento y proyección 360°",
        href: "/metodo",
        image: "/images/Metodo-VMA-Grids.png",
      },
      {
        title: "Continuidad operativa",
        subtitle: "La máquina correcta con respaldo real",
        href: "/#negocio",
        image: "/images/Firefly14.jpg",
      },
    ],
    links: [
      { label: "Ver sistema VMA", href: "/#negocio" },
      { label: "Unidades de negocio", href: "/unidades" },
      { label: "Lo que nos hace diferentes", href: "/metodo" },
    ],
  },
  {
    key: "equipos",
    label: "Equipos",
    href: "/#equipos",
    hasMega: true,
    eyebrow: "Equipos",
    title: "Maquinaria para trabajo en altura",
    description:
      "Plataformas, manipuladores y equipos para obra, industria y mantenimiento con criterio técnico de selección.",
    cards: [
      {
        title: "Articuladas",
        subtitle: "Alcance, altura y versatilidad",
        href: "/#equipos",
        image: "/images/nav/equipos-articuladas.jpg",
      },
      {
        title: "Tijera",
        subtitle: "Superficie estable en altura",
        href: "/#equipos",
        image: "/images/nav/equipos-tijera.jpg",
      },
      {
        title: "Manipuladores",
        subtitle: "Carga, alcance y operación industrial",
        href: "/#equipos",
        image: "/images/nav/equipos-manipuladores.jpg",
      },
    ],
    links: [
      { label: "Ver equipos", href: "/#equipos" },
      { label: "Pedir recomendación", href: waCotizarUrl },
    ],
  },
  {
    key: "ecosistema",
    label: "Ecosistema",
    href: "/#ecosistema",
    hasMega: true,
    eyebrow: "Ecosistema VMA",
    title: "Novedades y criterio técnico",
    description:
      "Contenido útil para decidir mejor: disponibilidad, selección de equipos, seguridad, costos y continuidad operativa.",
    cards: [
      {
        title: "Novedades",
        subtitle: "Actualizaciones del ecosistema VMA",
        href: "/#ecosistema",
        image: "/images/noticias.png",
      },
      {
        title: "Blog técnico",
        subtitle: "Criterios para elegir mejor",
        href: "/#ecosistema",
        image: "/images/Blog.png",
      },
      {
        title: "Guías operativas",
        subtitle: "Información para cotizar con contexto",
        href: "/#ecosistema",
        image: "/images/co.png",
      },
    ],
    links: [
      { label: "Ver ecosistema", href: "/#ecosistema" },
      { label: "Consultar por WhatsApp", href: waCotizarUrl },
    ],
  },
  {
    key: "faq",
    label: "FAQ",
    href: "/#faq",
    hasMega: false,
    eyebrow: "Preguntas frecuentes",
    title: "Antes de cotizar, resolvé lo importante",
    description:
      "Disponibilidad, zonas de operación, tiempos de respuesta, condiciones y soporte durante el uso del equipo.",
    cards: [
      {
        title: "Disponibilidad",
        subtitle: "Equipos sujetos a agenda",
        href: "/#faq",
        image: "/images/nav/faq-disponibilidad.jpg",
      },
      {
        title: "Cobertura",
        subtitle: "AMBA y zonas extendidas",
        href: "/#faq",
        image: "/images/nav/faq-cobertura.jpg",
      },
      {
        title: "Soporte",
        subtitle: "Acompañamiento técnico",
        href: "/#faq",
        image: "/images/nav/faq-soporte.jpg",
      },
    ],
    links: [
      { label: "Ver preguntas", href: "/#faq" },
      { label: "Consultar por WhatsApp", href: waCotizarUrl },
    ],
  },
];

const megaGroups = navGroups.filter((group) => group.hasMega);

const currentPath = Astro.url.pathname;
const isInternalPage = currentPath !== "/";

---

<header class:list={["topNav", { "isInternalPage": isInternalPage }]} data-topnav>
  <div class="navBackdrop" data-nav-backdrop hidden></div>

  <div class="navBar">
    <Container class="navInner">
      <a class="brand" href="/#inicio" aria-label="VMA Rental">
        <img
          class="brandImage"
          src="/brand/Isologotipo.png"
          alt="VMA Rental"
          loading="eager"
          decoding="async"
        />
      </a>

      <nav class="tabs" aria-label="Navegación principal">
        {
          navGroups.map((group) =>
            group.hasMega ? (
              <a
                class="tab"
                href={group.href}
                data-tab
                data-section-id={group.sectionId ?? group.key}
                data-menu-trigger={group.key}
              >
                {group.label}
              </a>
            ) : (
              <a
                class="tab"
                href={group.href}
                data-tab
                data-section-id={group.sectionId ?? group.key}
              >
                {group.label}
              </a>
            )
          )
        }
      </nav>

      <div class="right">
        <a class="navCta" href="/#contacto">
          Contacto
        </a>
      </div>
    </Container>
  </div>

  <div class="megaMenu" data-mega-menu hidden>
    <Container class="megaInner">
      {
        megaGroups.map((group) => (
          <section class="megaPanel" data-mega-panel={group.key} hidden>
            <div class="megaIntro">
              <p class="megaEyebrow">{group.eyebrow}</p>
              <h2 class="megaTitle">{group.title}</h2>
              <p class="megaDescription">{group.description}</p>
            </div>

            <div class="megaCards">
              {group.cards?.map((card) => (
                <a class="megaCard" href={card.href}>
                  <div
                    class="megaCardImage"
                    style={`--nav-card-image: url('${card.image}')`}
                    aria-hidden="true"
                  ></div>

                  <div class="megaCardBody">
                    <strong>{card.title}</strong>
                    <span>{card.subtitle}</span>
                  </div>
                </a>
              ))}
            </div>

            <aside class="megaAside">
              <p class="megaAsideTitle">Acciones</p>

              <div class="megaAsideLinks">
                {group.links?.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </div>
            </aside>
          </section>
        ))
      }
    </Container>
  </div>
</header>

<style>
  [hidden] {
    display: none !important;
  }

  .topNav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 9999;
    pointer-events: none;
  }

  .navBackdrop {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: auto;
    opacity: 0;
    background: rgba(10, 12, 14, 0.16);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: opacity 0.22s ease;
  }

  .topNav.isMenuOpen .navBackdrop {
    opacity: 1;
  }

  .topNav.isInternalPage .navBar {
    background: rgba(4, 7, 9, 0.78);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(22px) saturate(1.16);
    -webkit-backdrop-filter: blur(22px) saturate(1.16);
  }

  .navBar {
    position: relative;
    z-index: 3;
    width: 100%;
    pointer-events: auto;
    background: transparent;
    border-bottom: 1px solid transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
    transition:
      background 0.24s ease,
      border-color 0.24s ease,
      box-shadow 0.24s ease,
      backdrop-filter 0.24s ease;
  }

  .topNav.isScrolled .navBar,
  .topNav.isMenuOpen .navBar {
    background: rgba(4,7,9,0.58);
    border-color: rgba(255,255,255,0.08);
    box-shadow: 0 12px 40px rgba(0,0,0,0.18);
    backdrop-filter: blur(22px) saturate(1.16);
    -webkit-backdrop-filter: blur(7px) saturate(2);
  }

  .navBar :global(.container.navInner) {
    min-height: 72px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
    width: min(1639px, calc(100vw - 56px));
    margin: 0 auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    line-height: 0;
  }

  .brandImage {
    display: block;
    width: clamp(118px, 10vw, 156px);
    height: auto;
    max-height: 42px;
    object-fit: contain;
  }

  .tabs {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 45px;
    justify-self: center;
    min-width: 0;
  }

  .tab {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0;
    border-radius: 0;
    white-space: nowrap;
    background: transparent;
    box-shadow: none;
    font-weight: 500;
    font-size: 16px;
    color: rgba(234, 242, 247, 0.72);
    transition:
      color 0.18s ease,
      opacity 0.18s ease;
  }

  .tab:hover,
  .tab.isMenuActive {
    color: #ffc400;
    background: transparent;
  }

  .tab.isActive {
    color: #ffc400;
    background: transparent;
    font-weight: 800;
  }

  .right {
    display: inline-flex;
    align-items: center;
    justify-self: end;
  }

  .navCta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid rgba(255, 196, 0, 0.7);
    border-radius: 10px;
    background: rgba(255, 196, 0, 0.08);
    color: #ffc400;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .navCta:hover {
    background: #ffc400;
    border-color: #ffc400;
    color: #070707;
    box-shadow: 0 16px 44px rgba(255, 196, 0, 0.18);
    transform: translateY(-1px);
  }

  .megaMenu {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    z-index: 2;
    pointer-events: auto;
    background: rgba(246, 245, 241, 0.82);
    border-bottom: 1px solid rgba(16, 18, 20, 0.08);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(24px) saturate(1.18);
    -webkit-backdrop-filter: blur(24px) saturate(1.18);
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  .topNav.isMenuOpen .megaMenu {
    opacity: 1;
    transform: translateY(0);
  }

  .megaMenu :global(.container.megaInner) {
    width: min(1360px, calc(100vw - 56px));
    margin: 0 auto;
  }

  .megaPanel {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr) 220px;
    gap: 40px;
    padding: 34px 0 38px;
    align-items: start;
  }

  .megaPanel.isActive {
    display: grid !important;
  }

  .megaIntro {
    max-width: 300px;
  }

  .megaEyebrow {
    margin: 0 0 12px;
    color: #b58c00;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .megaTitle {
    margin: 0;
    color: #101214;
    font-size: clamp(1.85rem, 2.1vw, 2.5rem);
    line-height: 1.04;
    letter-spacing: -0.05em;
    font-weight: 600;
  }

  .megaDescription {
    margin: 16px 0 0;
    color: rgba(16, 18, 20, 0.62);
    font-size: 0.96rem;
    line-height: 1.6;
  }

  .megaCards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .megaCard {
    display: block;
    color: #101214;
  }

  .megaCardImage {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #d7d2c1;
    background-image:
      linear-gradient(
        135deg,
        rgba(255, 196, 0, 0.18),
        rgba(16, 18, 20, 0.12)
      ),
      var(--nav-card-image);
    background-size: cover;
    background-position: center;
    border-radius: 12px;
    transition:
      transform 0.28s ease,
      filter 0.28s ease;
  }

  .megaCard:hover .megaCardImage {
    transform: scale(1.025);
    filter: saturate(1.03) contrast(1.03);
  }

  .megaCardBody {
    padding-top: 14px;
  }

  .megaCardBody strong {
    display: block;
    color: #101214;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .megaCardBody span {
    display: block;
    margin-top: 6px;
    color: rgba(16, 18, 20, 0.58);
    font-size: 0.86rem;
    line-height: 1.42;
  }

  .megaAside {
    border-left: 1px solid rgba(16, 18, 20, 0.1);
    padding-left: 28px;
  }

  .megaAsideTitle {
    margin: 0 0 18px;
    color: #101214;
    font-size: 0.92rem;
    font-weight: 800;
  }

  .megaAsideLinks {
    display: grid;
    gap: 16px;
  }

  .megaAsideLinks a {
    color: rgba(16, 18, 20, 0.68);
    font-size: 0.95rem;
    line-height: 1.35;
    transition: color 0.18s ease;
  }

  .megaAsideLinks a:hover {
    color: #101214;
  }

  @media (max-width: 1180px) {
    .megaPanel {
      grid-template-columns: 280px minmax(0, 1fr);
    }

    .megaAside {
      grid-column: 1 / -1;
      border-left: 0;
      border-top: 1px solid rgba(16, 18, 20, 0.1);
      padding-left: 0;
      padding-top: 20px;
    }
  }

  @media (max-width: 980px) {
    .navBar :global(.container.navInner) {
      grid-template-columns: auto auto;
      justify-content: space-between;
      width: min(100vw - 32px, 1360px);
      min-height: 64px;
    }

    .tabs {
      display: none;
    }

    .megaMenu,
    .navBackdrop {
      display: none !important;
    }
  }
</style>

<script type="module">
  const root = document.querySelector("[data-topnav]");

  if (root) {
    const navBar = root.querySelector(".navBar");
    const menu = root.querySelector("[data-mega-menu]");
    const backdrop = root.querySelector("[data-nav-backdrop]");
    const tabs = Array.from(root.querySelectorAll("[data-tab]"));
    const triggers = Array.from(root.querySelectorAll("[data-menu-trigger]"));
    const panels = Array.from(root.querySelectorAll("[data-mega-panel]"));
    const megaLinks = Array.from(root.querySelectorAll(".megaMenu a"));
    const brand = root.querySelector(".brand");
    const navCta = root.querySelector(".navCta");

    let closeTimer = null;
    let ticking = false;

    const getHashFromHref = (href) => {
      if (!href) return "";
      const hashIndex = href.indexOf("#");
      return hashIndex >= 0 ? href.slice(hashIndex + 1) : "";
    };

    const getTabSectionId = (tab) => {
      return tab.dataset.sectionId || getHashFromHref(tab.getAttribute("href") || "");
    };

    const getHeaderOffset = () => {
      const navHeight = navBar?.getBoundingClientRect().height ?? 72;
      return navHeight + 24;
    };

    const getRouteActiveId = () => {
      const path = window.location.pathname;

      if (path === "/nosotros" || path.startsWith("/nosotros/")) {
        return "nosotros";
      }

      if (path === "/unidades" || path.startsWith("/unidades/")) {
        return "negocio";
      }

      if (path === "/metodo" || path.startsWith("/metodo/")) {
        return "negocio";
      }

      return "";
    };

    const setScrolled = () => {
      root.classList.toggle("isScrolled", window.scrollY > 18);
    };

    const clearCloseTimer = () => {
      if (closeTimer) {
        window.clearTimeout(closeTimer);
        closeTimer = null;
      }
    };

    const openMenu = (key) => {
      if (!menu || !backdrop || !key) return;

      clearCloseTimer();

      menu.hidden = false;
      backdrop.hidden = false;
      root.classList.add("isMenuOpen");

      panels.forEach((panel) => {
        const isActive = panel.getAttribute("data-mega-panel") === key;
        panel.hidden = !isActive;
        panel.classList.toggle("isActive", isActive);
      });

      triggers.forEach((trigger) => {
        trigger.classList.toggle(
          "isMenuActive",
          trigger.getAttribute("data-menu-trigger") === key
        );
      });
    };

    const closeMenu = () => {
      if (!menu || !backdrop) return;

      root.classList.remove("isMenuOpen");

      panels.forEach((panel) => {
        panel.hidden = true;
        panel.classList.remove("isActive");
      });

      triggers.forEach((trigger) => {
        trigger.classList.remove("isMenuActive");
      });

      window.setTimeout(() => {
        if (!root.classList.contains("isMenuOpen")) {
          menu.hidden = true;
          backdrop.hidden = true;
        }
      }, 220);
    };

    const scheduleClose = () => {
      clearCloseTimer();
      closeTimer = window.setTimeout(closeMenu, 140);
    };

    const setActive = (id) => {
      tabs.forEach((tab) => {
        const tabId = getTabSectionId(tab);
        tab.classList.toggle("isActive", tabId === id);
      });

      if (navCta) {
        navCta.classList.toggle("isActive", id === "contacto");
      }
    };

    const sectionIds = Array.from(
      new Set([
        ...tabs.map((tab) => getTabSectionId(tab)),
        "contacto",
      ])
    ).filter(Boolean);

    const getSections = () => {
      return sectionIds
        .map((id) => document.getElementById(id))
        .filter(Boolean);
    };

    const updateActiveByScroll = () => {
      const routeActiveId = getRouteActiveId();

      /*
        En páginas internas como /nosotros, /unidades o /metodo
        no dependemos del scroll del home.
      */
      if (routeActiveId && window.location.pathname !== "/") {
        setActive(routeActiveId);
        ticking = false;
        return;
      }

      const sections = getSections();
      if (!sections.length) {
        setActive(routeActiveId || "inicio");
        ticking = false;
        return;
      }

      const offset = getHeaderOffset();
      const marker = window.scrollY + offset + window.innerHeight * 0.22;

      let currentId = sections[0].id;

      sections.forEach((section) => {
        const top = section.offsetTop;
        if (marker >= top) {
          currentId = section.id;
        }
      });

      const bottomReached =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8;

      if (bottomReached) {
        const lastSection = sections[sections.length - 1];
        if (lastSection?.id) currentId = lastSection.id;
      }

      setActive(currentId);
      ticking = false;
    };

    const requestActiveUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateActiveByScroll);
    };

    const scrollToHash = (href) => {
      const id = getHashFromHref(href);
      if (!id) return false;

      const target = document.getElementById(id);
      if (!target) return false;

      const offset = getHeaderOffset();
      const top = target.getBoundingClientRect().top + window.scrollY - offset;

      window.history.pushState(null, "", `#${id}`);
      window.scrollTo({
        top,
        behavior: "smooth",
      });

      setActive(id);
      closeMenu();

      return true;
    };

    triggers.forEach((trigger) => {
      const key = trigger.getAttribute("data-menu-trigger");

      trigger.addEventListener("mouseenter", () => openMenu(key));
      trigger.addEventListener("focus", () => openMenu(key));
    });

    tabs.forEach((tab) => {
      tab.addEventListener("click", (event) => {
        const href = tab.getAttribute("href") || "";

        if (href.includes("#")) {
          const handled = scrollToHash(href);
          if (handled) {
            event.preventDefault();
          }
        } else {
          closeMenu();
        }
      });
    });

    megaLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href") || "";

        if (href.includes("#")) {
          const handled = scrollToHash(href);
          if (handled) {
            event.preventDefault();
          }
        } else {
          closeMenu();
        }
      });
    });

    brand?.addEventListener("click", (event) => {
      const handled = scrollToHash("/#inicio");
      if (handled) event.preventDefault();
    });

    navCta?.addEventListener("click", (event) => {
      const handled = scrollToHash("/#contacto");
      if (handled) event.preventDefault();
    });

    navBar?.addEventListener("mouseenter", clearCloseTimer);
    navBar?.addEventListener("mouseleave", scheduleClose);
    menu?.addEventListener("mouseenter", clearCloseTimer);
    menu?.addEventListener("mouseleave", scheduleClose);
    backdrop?.addEventListener("mouseenter", scheduleClose);
    backdrop?.addEventListener("click", closeMenu);

    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });

    setScrolled();
    updateActiveByScroll();

    window.addEventListener("scroll", () => {
      setScrolled();
      requestActiveUpdate();
    }, { passive: true });

    window.addEventListener("resize", requestActiveUpdate);

    window.addEventListener("load", () => {
      const routeActiveId = getRouteActiveId();

      if (routeActiveId && window.location.pathname !== "/") {
        setActive(routeActiveId);
        return;
      }

      const initialHash = window.location.hash?.replace("#", "");
      if (initialHash) {
        const target = document.getElementById(initialHash);
        if (target) {
          window.setTimeout(() => {
            scrollToHash(`#${initialHash}`);
          }, 80);
        }
      } else {
        setActive("inicio");
      }
    });
  }
</script>