<style is:global>
  @media (min-width: 761px) {
    .topNav .mobileContactLink {
      display: none !important;
    }
  }

  @media (max-width: 760px) {
    .topNav .mobileOnlyCta {
      display: none !important;
    }

    .topNav .mobileContactLink {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      min-width: 178px !important;
      min-height: 48px !important;
      padding: 0 22px !important;
      margin-top: 8px !important;
      border: 1px solid rgba(255, 196, 0, 0.72) !important;
      border-radius: 999px !important;
      background: transparent !important;
      box-shadow: none !important;
      color: #ffffff !important;
      text-decoration: none !important;
      font-size: clamp(20px, 5.5vw, 24px) !important;
      font-weight: 600 !important;
      line-height: 1 !important;
    }

    .topNav .tabs .tab:not(.mobileContactLink) {
      appearance: none !important;
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
      padding: 0 !important;
      margin: 0 !important;
      text-decoration: none !important;
    }

    /* En mobile no dejamos ningún active fijo */
    .topNav .tabs .tab.is-active,
    .topNav .tabs .mobileContactLink.is-active {
      color: #ffffff !important;
      border-color: rgba(255, 196, 0, 0.72) !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const mq = window.matchMedia("(max-width: 760px)");
    let savedScrollY = 0;
    let navigatingFromMenu = false;

    const getTopNav = () => document.querySelector("[data-topnav]");
    const getTabs = () => [...document.querySelectorAll("[data-topnav] [data-tab]")];

    const getHeaderOffset = () => {
      const nav = getTopNav();
      return Math.ceil(nav?.getBoundingClientRect().height || 72) + 12;
    };

    const normalizeMobileLinks = () => {
      if (!mq.matches) return;

      getTabs().forEach((tab) => {
        const mobileHref = tab.getAttribute("data-mobile-href");
        if (mobileHref) tab.setAttribute("href", mobileHref);
      });
    };

    const clearMobileActive = () => {
      if (!mq.matches) return;
      getTabs().forEach((tab) => tab.classList.remove("is-active"));
    };

    const closeMobileMenu = () => {
      const topNav = getTopNav();
      const button = document.querySelector("[data-mobile-menu-button]");
      const mobileNav = document.querySelector("[data-mobile-nav]");

      button?.setAttribute("aria-expanded", "false");

      topNav?.classList.remove(
        "is-open",
        "is-active",
        "is-menu-open",
        "menu-open",
        "nav-open",
        "mobile-open"
      );

      mobileNav?.classList.remove(
        "is-open",
        "is-active",
        "is-menu-open",
        "menu-open",
        "nav-open",
        "mobile-open"
      );

      document.documentElement.classList.remove(
        "is-menu-open",
        "menu-open",
        "nav-open",
        "mobile-open"
      );

      document.body.classList.remove(
        "is-menu-open",
        "menu-open",
        "nav-open",
        "mobile-open",
        "no-scroll",
        "overflow-hidden"
      );

      clearMobileActive();
    };

    const restoreScrollIfMenuOnly = () => {
      if (!mq.matches) return;
      if (navigatingFromMenu) return;

      const jumpedToTop = savedScrollY > 120 && window.scrollY < 40;

      if (jumpedToTop) {
        window.scrollTo({
          top: savedScrollY,
          behavior: "auto",
        });
      }

      clearMobileActive();
    };

    const scrollToSection = (sectionId) => {
      const target = document.getElementById(sectionId);
      if (!target) return false;

      const top =
        target.getBoundingClientRect().top +
        window.scrollY -
        getHeaderOffset();

      window.scrollTo({
        top: Math.max(0, top),
        behavior: "smooth",
      });

      return true;
    };

    const handleMobileMenuLink = (event) => {
      if (!mq.matches) return;

      const tab = event.target.closest?.("[data-topnav] [data-tab]");
      if (!tab) return;

      const href = tab.getAttribute("href") || "";
      if (!href) return;

      const url = new URL(href, window.location.origin);
      const sectionId = url.hash.replace("#", "");

      navigatingFromMenu = true;
      closeMobileMenu();

      setTimeout(() => {
        navigatingFromMenu = false;
      }, 900);

      if (!sectionId) return;

      const isHomeHash =
        url.pathname === "/" &&
        window.location.pathname === "/";

      if (!isHomeHash) {
        return;
      }

      event.preventDefault();

      history.replaceState(null, "", `/#${sectionId}`);

      requestAnimationFrame(() => {
        scrollToSection(sectionId);
      });
    };

    const bindMobileMenuButton = () => {
      const button = document.querySelector("[data-mobile-menu-button]");
      if (!button) return;

      button.addEventListener(
        "pointerdown",
        () => {
          if (!mq.matches) return;
          savedScrollY = window.scrollY;
        },
        true
      );

      button.addEventListener(
        "click",
        () => {
          if (!mq.matches) return;

          savedScrollY = savedScrollY || window.scrollY;

          setTimeout(restoreScrollIfMenuOnly, 80);
          setTimeout(restoreScrollIfMenuOnly, 240);
          setTimeout(clearMobileActive, 320);
        },
        true
      );
    };

    document.addEventListener("DOMContentLoaded", () => {
      normalizeMobileLinks();
      clearMobileActive();
      bindMobileMenuButton();
      document.addEventListener("click", handleMobileMenuLink, true);
    });

    window.addEventListener("resize", () => {
      normalizeMobileLinks();
      clearMobileActive();
    });

    window.VMA_HEADER_MOBILE_CLEAR_ACTIVE = clearMobileActive;
  })();
</script>
<!-- VMA_HEADER_NAV_FINAL_FIX_END -->
