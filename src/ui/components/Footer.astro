---
type Props = {
  emailComercial?: string;
  whatsappLabel?: string;
  address?: string;
  logoSrc?: string;
  logoAlt?: string;
};

const {
  emailComercial = "comercial@vmarental.com.ar",
  whatsappLabel = "[PENDIENTE]",
  address = "[DIRECCIÓN FÍSICA SI APLICA]",
  logoSrc = "/brand/Isologotipo.png",
  logoAlt = "VMA Rental",
} = Astro.props as Props;
---

<footer class="footer">
  {/* DIVISOR AMARILLO */}
  <div class="footerDivider" aria-hidden="true"></div>

  {/* LOGO + EMAIL GIGANTE */}
  <div class="footerHero">
    <a href="#inicio" class="footerLogo" aria-label={logoAlt}>
      <img src={logoSrc} alt={logoAlt} />
    </a>

    <div class="footerBigEmail">
      <a href={`mailto:${emailComercial}`}>{emailComercial}</a>
    </div>
  </div>

  {/* FOOTER MINIMAL */}
  <div class="footerMain">
    <div class="footerCols">
      <div class="footerCol">
        <h3 class="footerColTitle">VMA RENTAL</h3>
        <p class="footerColText">
          Alquiler y venta de maquinaria especializada para trabajo en altura,
          obra e industria. AMBA y zonas extendidas.
        </p>
      </div>

      <div class="footerCol">
        <h3 class="footerColTitle">SECCIONES</h3>
        <ul class="footerColList">
          <li><a href="#sectores">Sectores</a></li>
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#metodologia">Cómo trabajamos</a></li>
          <li><a href="#equipos">Equipos</a></li>
          <li><a href="#faq">FAQ</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>

      <div class="footerCol">
        <h3 class="footerColTitle">CONTACTO</h3>
        <ul class="footerColList">
          <li>
            <a href={`mailto:${emailComercial}`}>{emailComercial}</a>
          </li>
          <li>WhatsApp: {whatsappLabel}</li>
          <li>{address}</li>
        </ul>
      </div>
    </div>

    <div class="footerLegal">
      <p>© 2026 VMA Maquinarias SRL. Todos los derechos reservados.</p>
      <p>
        Diseño y desarrollo:
        <a
          href="https://vantorastudio.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Vantora Creative Studio
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #070707;
    width: 100%;
    padding: 0 80px 40px 80px;
    box-sizing: border-box;
  }

  /* DIVISOR AMARILLO */
  .footerDivider {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      #ffc400 20%,
      #ffc400 80%,
      transparent 100%
    );
    /* margin: 0 0 80px 0; */
    opacity: 0.4;
  }

  /* HERO: LOGO + EMAIL */
  .footerHero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 60px;
    margin-top: 60px;
    margin-bottom: 80px;
  }

  /* LOGO */
  .footerLogo {
    flex-shrink: 0;
    display: inline-block;
    transition: opacity 0.3s ease;
  }

  .footerLogo:hover {
    opacity: 0.7;
  }

  .footerLogo img {
    height: clamp(40px, 4vw, 64px);
    width: auto;
    display: block;
  }

  /* EMAIL GIGANTE */
  .footerBigEmail {
    flex: 1;
    text-align: right;
    min-width: 0;
  }

  .footerBigEmail a {
    color: #ffffff;
    font-size: clamp(1.2rem, 4.5vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    transition: color 0.3s ease;
    word-break: break-all;
    display: inline-block;
  }

  .footerBigEmail a:hover {
    color: #ffc400;
  }

  /* FOOTER MAIN */
  /* .footerMain {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 40px;
  } */

  .footerCols {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 80px;
    margin-bottom: 60px;
  }

  .footerColTitle {
    color: #ffc400;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    margin: 0 0 20px 0;
    font-family: inherit;
  }

  .footerColText {
    color: #c9c9c9;
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
    max-width: 36ch;
  }

  .footerColList {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footerColList li {
    color: #c9c9c9;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .footerColList li a {
    color: #c9c9c9;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footerColList li a:hover {
    color: #ffc400;
  }

  /* LEGAL */
  .footerLegal {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footerLegal p {
    color: #6b6b6b;
    font-size: 0.8rem;
    margin: 0;
  }

  .footerLegal a {
    color: #ffc400;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footerLegal a:hover {
    color: #ffffff;
  }

  /* TABLET */
  @media (max-width: 1024px) {
    .footer {
      padding: 0 32px 32px 32px;
    }

    /* .footerDivider {
      margin-bottom: 60px;
    } */

    .footerHero {
      margin-bottom: 80px;
      gap: 40px;
    }

    .footerCols {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  /* MOBILE */
  @media (max-width: 640px) {
    .footer {
      padding: 0 24px 24px 24px;
    }

    /* .footerDivider {
      margin-bottom: 40px;
    } */

    .footerHero {
      flex-direction: column;
      align-items: flex-start;
      gap: 40px;
    }

    .footerBigEmail {
      text-align: left;
      width: 100%;
    }

    .footerBigEmail a {
      font-size: clamp(1rem, 7vw, 1.8rem);
    }

    .footerCols {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 40px;
    }

    .footerLegal {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>