---
import { site, waCotizarUrl } from "@/config/site";

type Props = {
  emailComercial?: string;
  whatsappLabel?: string;
  address?: string;
  mapsHref?: string;
  logoSrc?: string;
  logoAlt?: string;
};

const {
  emailComercial = site.contact.emailComercial,
  whatsappLabel = "1128421008",
  address = "Calle 152 número 6359 ofic 301, Greenville, Hudson, Buenos Aires",
  mapsHref = "https://www.google.com/maps/search/?api=1&query=Calle%20152%20numero%206359%20ofic%20301%20Greenville%20Hudson%20Buenos%20Aires",
  logoSrc = "/brand/Isologotipo.png",
  logoAlt = "VMA Rental",
} = Astro.props as Props;

const currentPath = Astro.url.pathname;
const isHomePage = currentPath === "/" || currentPath === "/index.html";

const whatsappHref = waCotizarUrl || "https://wa.me/541128421008";
---

<footer class="footer">
  {isHomePage && (
    <div class="footerTopAction">
      <a class="footerBackTop" href="#inicio" aria-label="Volver arriba">
        <span>Volver arriba</span>
        <span aria-hidden="true">↑</span>
      </a>
    </div>
  )}

  <div class="footerDivider" aria-hidden="true"></div>

  <div class="footerHero">
    <a href="#inicio" class="footerLogo" aria-label={logoAlt}>
      <img src={logoSrc} alt={logoAlt} />
    </a>

    <div class="footerBigEmail">
      <a href={`mailto:${emailComercial}`}>{emailComercial}</a>
    </div>
  </div>

  <div class="footerMain">
    <div class="footerCols">
      <div class="footerCol">
        <h3 class="footerColTitle">VMA RENTAL</h3>
        <p class="footerColText">
          Alquiler de equipos de elevación y trabajo en altura para obra e industria. Disponibilidad real, soporte técnico y continuidad operativa.
        </p>
      </div>

      <div class="footerCol">
        <h3 class="footerColTitle">SECCIONES</h3>
        <ul class="footerColList">
          <li><a href="#inicio">Inicio</a></li>
          <li><a href="#equipos">Flota VMA</a></li>
          <li><a href="#sectores">Sectores</a></li>
          <li><a href="#sistema-vma">Sistema VMA</a></li>
          <li><a href="#faq">FAQ</a></li>
          <li><a href="/nosotros">Nosotros</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>

      <div class="footerCol">
        <h3 class="footerColTitle">CONTACTO</h3>
        <ul class="footerColList footerContactList">
          <li>
            <a href={`mailto:${emailComercial}`}>{emailComercial}</a>
          </li>
          <li>
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer">
              WhatsApp: {whatsappLabel}
            </a>
          </li>
          <li>
            <a href={mapsHref} target="_blank" rel="noopener noreferrer">
              {address}
            </a>
          </li>
        </ul>

      </div>
    </div>

    <div class="footerLegal">
      <p>© 2026 VMA Rental SRL. Todos los derechos reservados.</p>
      <p>
        Diseño y desarrollo:
        <a
          href="https://vantorastudio.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Vantora Creative Studio
        </a>
      </p>
    </div>
  </div>
  <a
    class="floatingWhatsapp"
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Cotizar por WhatsApp al ${whatsappLabel}`}
  >
    <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path d="M16.04 4C9.42 4 4.04 9.34 4.04 15.9c0 2.1.56 4.15 1.62 5.95L4 28l6.31-1.63a12.1 12.1 0 0 0 5.73 1.45C22.66 27.82 28 22.48 28 15.92 28 9.34 22.66 4 16.04 4Zm0 21.8c-1.82 0-3.6-.48-5.16-1.4l-.37-.22-3.74.97 1-3.62-.24-.38a9.83 9.83 0 0 1-1.5-5.23c0-5.45 4.49-9.88 10.01-9.88 5.5 0 9.98 4.43 9.98 9.88 0 5.44-4.48 9.87-9.98 9.87Zm5.48-7.4c-.3-.15-1.78-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.27-.46-2.42-1.47-.9-.8-1.5-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.48 0 1.46 1.08 2.88 1.23 3.08.15.2 2.13 3.22 5.16 4.52.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.78-.72 2.03-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z" />
    </svg>
  </a>
</footer>

<style>
  .footer {
    position: relative;
    background: #070707;
    width: 100%;
    padding: 0 80px 40px 80px;
    box-sizing: border-box;
  }

  .footerTopAction {
    position: relative;
    z-index: 4;
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 0 auto 18px;
    padding: 0 24px;
    transform: none;
    pointer-events: none;
  }

  .footerBackTop {
    min-height: 46px;
    min-width: 156px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 22px;
    border: 1px solid #ffffff;
    border-radius: 12px;
    background: #ffffff;
    color: #080808;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    letter-spacing: 0.01em;
    box-shadow:
      0 16px 42px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(255, 255, 255, 0.08);
    pointer-events: auto;
    transition:
      color 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .footerBackTop:hover {
    color: #080808;
    border-color: #ffc400;
    background: #ffc400;
    transform: translateY(-2px);
    box-shadow:
      0 18px 48px rgba(0, 0, 0, 0.48),
      0 0 0 4px rgba(255, 196, 0, 0.08);
  }


  .floatingWhatsapp {
    position: fixed !important;
    right: clamp(18px, 2.2vw, 32px) !important;
    bottom: calc(clamp(18px, 2.2vw, 32px) + env(safe-area-inset-bottom)) !important;
    z-index: 9999 !important;
    width: clamp(52px, 4.8vw, 62px) !important;
    height: clamp(52px, 4.8vw, 62px) !important;
    display: grid !important;
    place-items: center !important;
    overflow: hidden !important;
    border: 1px solid rgba(255, 196, 0, 0.52);
    border-radius: 999px;
    background: #ffc400;
    color: #080808;
    text-decoration: none;
    box-shadow:
      0 20px 54px rgba(0, 0, 0, 0.42),
      0 0 0 8px rgba(255, 196, 0, 0.08);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
  }

  .floatingWhatsapp svg {
    width: 28px !important;
    height: 28px !important;
    max-width: 28px !important;
    max-height: 28px !important;
    display: block;
    fill: currentColor;
  }

  .floatingWhatsapp:hover {
    background: #ffffff;
    transform: translateY(-3px) scale(1.03);
    box-shadow:
      0 24px 64px rgba(0, 0, 0, 0.5),
      0 0 0 10px rgba(255, 196, 0, 0.11);
  }

  .footerDivider {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      #ffc400 20%,
      #ffc400 80%,
      transparent 100%
    );
    opacity: 0.4;
  }

  .footerHero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 60px;
    margin-top: 60px;
    margin-bottom: 80px;
  }

  .footerLogo {
    flex-shrink: 0;
    display: inline-block;
    transition: opacity 0.3s ease;
  }

  .footerLogo:hover {
    opacity: 0.7;
  }

  .footerLogo img {
    height: clamp(40px, 4vw, 64px);
    width: auto;
    display: block;
  }

  .footerBigEmail {
    font-family: var(--font-body);
    flex: 1;
    text-align: right;
    min-width: 0;
  }

  .footerBigEmail a {
    font-family: var(--font-body);
    color: #ffffff;
    font-size: clamp(1.2rem, 4.5vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    transition: color 0.3s ease;
    word-break: break-all;
    display: inline-block;
  }

  .footerBigEmail a:hover {
    color: #ffc400;
  }

  .footerCols {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 80px;
    margin-bottom: 60px;
  }

  .footerColTitle {
    color: #ffc400;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    margin: 0 0 20px 0;
    font-family: var(--font-body);
  }

  .footerColText {
    color: #c9c9c9;
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
    max-width: 36ch;
  }

  .footerColList {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: var(--font-body);
  }

  .footerColList li {
    color: #c9c9c9;
    font-size: 0.9rem;
    line-height: 1.5;
    font-family: var(--font-body);
  }

  .footerColList li a {
    color: #c9c9c9;
    text-decoration: none;
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
    font-family: var(--font-body);
  }

  .footerColList li a:hover {
    color: #ffc400;
  }

  .footerContactList li a {
    color: #c9c9c9;
    font-weight: 500;
    border-bottom: 0;
    overflow-wrap: anywhere;
  }

  .footerContactList li a:hover {
    color: #ffc400;
  }



  .footerLegal {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--font-body);
  }

  .footerLegal p {
    color: #6b6b6b;
    font-size: 0.8rem;
    margin: 0;
    font-family: var(--font-body);
  }

  .footerLegal a {
    color: #ffc400;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.3s ease;
    font-family: var(--font-body);
  }

  .footerLegal a:hover {
    color: #ffffff;
  }

  @media (max-width: 1024px) {
    .footer {
      padding: 0 32px 32px 32px;
    }

    .footerHero {
      margin-bottom: 80px;
      gap: 40px;
    }

    .footerCols {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .footerTopAction {
      justify-content: center;
      margin: 0 auto 16px;
      padding: 0 18px;
      transform: none;
    }

    .footerBackTop {
      min-height: 44px;
      min-width: 148px;
      padding: 0 18px;
      border-radius: 11px;
      font-size: 0.76rem;
    }

    .floatingWhatsapp {
      right: 18px !important;
      bottom: calc(18px + env(safe-area-inset-bottom)) !important;
      width: 54px !important;
      height: 54px !important;
    }

    .floatingWhatsapp svg {
      width: 25px !important;
      height: 25px !important;
    }

    .footer {
      padding: 0 24px 24px 24px;
    }

    .footerHero {
      flex-direction: column;
      align-items: flex-start;
      gap: 40px;
    }

    .footerBigEmail {
      text-align: left;
      width: 100%;
    }

    .footerBigEmail a {
      font-size: clamp(1rem, 7vw, 1.8rem);
    }

    .footerCols {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 40px;
    }

    .footerLegal {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
