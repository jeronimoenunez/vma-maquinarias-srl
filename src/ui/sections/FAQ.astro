---
type FAQItemFlexible = {
  q?: string;
  question?: string;
  a?: string;
  answer?: string;
};

type Props = {
  kicker?: string;
  title?: string;
  items?: FAQItemFlexible[];
};

const {
  kicker = "Algunas preguntas",
  title = "Preguntas frecuentes",
  items = [],
} = Astro.props as Props;

const normalizedItems = items.map((item) => ({
  question: item.question ?? item.q ?? "",
  answer: item.answer ?? item.a ?? "",
}));
---

<section id="faq" class="faqSection">
  <div class="faqShell">
    <aside class="faqAside">
      <p class="faqKicker">{kicker}</p>
    </aside>

    <div class="faqContent">
      {title && <h2 class="faqTitle">{title}</h2>}

      <div class="faqList">
        {
          normalizedItems.map((item) => (
            <details class="faqItem">
              <summary class="faqSummary">
                <span class="faqQuestion">{item.question}</span>
                <span class="faqIcon" aria-hidden="true"></span>
              </summary>

              <div class="faqAnswer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faqSection {
    background: #ffffff;
    color: #080808;
    width: 100%;
    padding:
      clamp(72px, 8vw, 118px)
      clamp(30px, 4vw, 76px)
      clamp(88px, 9vw, 140px);
  }

  .faqShell {
    display: grid;
    grid-template-columns: minmax(220px, 0.34fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 86px);
    align-items: start;
    width: 100%;
  }

  .faqAside {
    position: sticky;
    top: clamp(96px, 12vh, 150px);
  }

  .faqKicker {
    margin: 0;
    color: rgba(8, 8, 8, 0.86);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    font-size: clamp(1rem, 1.18vw, 1.35rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .faqContent {
    width: 100%;
  }

  .faqTitle {
    margin: 0 0 clamp(36px, 4vw, 64px);
    max-width: 100%;
    color: #080808;
    font-family: var(--font-body);
    font-size: clamp(3rem,4vw,7rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.07em;
  }

  .faqList {
    width: 100%;
    border-top: 2px solid rgba(8, 8, 8, 0.9);
  }

  .faqItem {
    border-bottom: 2px solid rgba(8, 8, 8, 0.9);
  }

  .faqSummary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(24px, 3vw, 48px);
    align-items: center;
    min-height: clamp(106px, 10vw, 148px);
    padding: clamp(26px, 3vw, 42px) 0;
    user-select: none;
  }

  .faqSummary::-webkit-details-marker {
    display: none;
  }

  .faqQuestion {
    max-width: 34ch;
    color: #080808;
    font-family: var(--font-body);
    font-size: clamp(1.75rem, 2.55vw, 3.55rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.052em;
    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .faqIcon {
    position: relative;
    width: clamp(26px, 2.4vw, 42px);
    height: clamp(26px, 2.4vw, 42px);
    flex: 0 0 auto;
  }

  .faqIcon::before,
  .faqIcon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 2px;
    background: #080808;
    transform: translate(-50%, -50%);
    transition:
      transform 0.25s ease,
      background 0.25s ease;
  }

  .faqIcon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faqItem[open] .faqIcon::after {
    transform: translate(-50%, -50%) rotate(0deg) scaleX(0);
  }

  .faqItem:hover .faqQuestion,
  .faqItem[open] .faqQuestion {
    color: #000000;
    transform: translateX(6px);
  }

  .faqItem:hover .faqIcon::before,
  .faqItem:hover .faqIcon::after,
  .faqItem[open] .faqIcon::before,
  .faqItem[open] .faqIcon::after {
    background: #ffc400;
  }

  .faqAnswer {
    max-width: 100ch;
    padding: 0 clamp(54px, 6vw, 96px) clamp(32px, 3.4vw, 48px) 0;
  }

  .faqAnswer p {
    margin: 0;
    color: rgba(8, 8, 8, 0.66);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.08vw, 1.18rem);
    font-weight: 400;
    line-height: 1.58;
    letter-spacing: -0.018em;
  }

  @media (max-width: 980px) {
    .faqShell {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .faqAside {
      position: relative;
      top: auto;
    }

    .faqTitle {
      max-width: 12ch;
    }

    .faqQuestion {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .faqSection {
      padding: 56px 22px 76px;
    }

    .faqTitle {
      font-size: clamp(2.4rem, 12vw, 4rem);
    }

    .faqSummary {
      min-height: auto;
      padding: 28px 0;
    }

    .faqQuestion {
      font-size: clamp(1.45rem, 7vw, 2.4rem);
      letter-spacing: -0.046em;
    }

    .faqIcon {
      width: 28px;
      height: 28px;
    }

    .faqAnswer {
      padding-right: 0;
    }
  }
</style>