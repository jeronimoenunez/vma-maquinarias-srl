---
type FAQItemFlexible = {
  q?: string;
  question?: string;
  a?: string;
  answer?: string;
};

type Props = {
  kicker?: string;
  title?: string;
  items?: FAQItemFlexible[];
};

const {
  kicker = "PREGUNTAS FRECUENTES",
  title = "Respuestas operativas para decidir con información.",
  items = [],
} = Astro.props as Props;

// Normaliza: acepta tanto { q, a } como { question, answer }
const normalizedItems = items.map((item) => ({
  question: item.question ?? item.q ?? "",
  answer: item.answer ?? item.a ?? "",
}));
---

<div class="faqSection">
  <div class="faqInner">
    <header class="faqHeader">
      <p class="faqKicker">{kicker}</p>
      <h2 class="faqTitle">{title}</h2>
    </header>

    <div class="faqList">
      {
        normalizedItems.map((item) => (
          <details class="faqItem">
            <summary class="faqSummary">
              <span class="faqQuestion">{item.question}</span>
              <span class="faqIcon" aria-hidden="true" />
            </summary>
            <div class="faqAnswer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</div>

<style>
  .faqSection {
    background-color: #070707;
    min-height: 100vh;
    width: 100%;
    padding: 120px 80px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
  }

  .faqInner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  .faqHeader {
    margin-bottom: 80px;
  }

  .faqKicker {
    color: #ffc400;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    margin: 0 0 20px 0;
  }

  .faqTitle {
    color: #ffffff;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 22ch;
  }

  .faqList {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .faqItem {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: background 0.3s ease;
  }

  .faqItem:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .faqItem[open] {
    background: rgba(255, 196, 0, 0.03);
  }

  .faqSummary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0;
    user-select: none;
  }

  .faqSummary::-webkit-details-marker {
    display: none;
  }

  .faqQuestion {
    color: #ffffff;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    font-weight: 400;
    line-height: 1.4;
    flex: 1;
  }

  .faqItem:hover .faqQuestion,
  .faqItem[open] .faqQuestion {
    color: #ffc400;
  }

  .faqIcon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    position: relative;
  }

  .faqIcon::before,
  .faqIcon::after {
    content: "";
    position: absolute;
    background: #ffc400;
    transition: transform 0.3s ease;
  }

  .faqIcon::before {
    top: 50%;
    left: 0;
    right: 0;
    height: 1.5px;
    transform: translateY(-50%);
  }

  .faqIcon::after {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1.5px;
    transform: translateX(-50%);
  }

  .faqItem[open] .faqIcon::after {
    transform: translateX(-50%) scaleY(0);
  }

  .faqAnswer {
    padding: 0 0 28px 0;
    max-width: 78ch;
  }

  .faqAnswer p {
    color: #c9c9c9 !important;
    font-size: 0.98rem;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .faqSection {
      padding: 80px 32px;
    }
  }

  @media (max-width: 640px) {
    .faqSection {
      padding: 60px 24px;
      min-height: auto;
    }
    .faqTitle {
      font-size: 1.6rem;
    }
  }
</style>