---
type ServiceCard = {
  title: string;
  subtitle: string;
  image: { src: string; alt: string };
};

type Props = {
  moduleEyebrow?: string;
  moduleTitle?: string;
  heroEyebrow?: string;
  heroTitle?: string;
  heroCtaLabel?: string;
  heroCtaHref?: string;
  heroImage?: { src: string; alt: string };
  cards?: ServiceCard[];
};

const fallbackCards: ServiceCard[] = [
  {
    title: "Alquiler de equipos",
    subtitle: "Flota propia, disponibilidad real. El equipo correcto para tu operación, sin comprarlo.",
    image: {
      src: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&auto=format&fit=crop&q=80",
      alt: "Equipo de elevación en operación",
    },
  },
  {
    title: "Venta de equipos",
    subtitle: "Equipos nuevos con garantía de fábrica y usados con garantía de funcionalidad VMA Rental. Asesoramiento técnico incluido.",
    image: {
      src: "https://images.unsplash.com/photo-1565514020179-026b92b84bb6?w=800&auto=format&fit=crop&q=80",
      alt: "Maquinaria nueva lista para venta",
    },
  },
  {
    title: "Soporte técnico",
    subtitle:
      "Mantenimiento, repuestos y respuesta en sitio cuando la operación no puede frenar. Continuidad operativa.",
    image: {
      src: "https://images.unsplash.com/photo-1581092446327-9b52bd1570c2?w=800&auto=format&fit=crop&q=80",
      alt: "Técnico realizando mantenimiento",
    },
  },
];

const {
  moduleEyebrow = "CÓMO OPERAMOS",
  moduleTitle = "Tres formas de resolver",
  heroEyebrow = "No se trata solo de entregar una máquina",
  heroTitle =
    "Se trata de resolver una operación con criterio, plazos claros y acompañamiento real.",
  heroCtaLabel = "Ver cómo trabajamos",
  heroCtaHref = "#metodologia",
  heroImage = {
    src: "https://images.unsplash.com/photo-1581094288338-2314dddb7ece?w=1600&auto=format&fit=crop&q=80",
    alt: "Plataforma articulada en obra",
  },
  cards = fallbackCards,
} = Astro.props as Props;
---

<section id="servicios" class="serviceSection">
  <div class="heroBlock">
    <div class="heroText">
      <header class="moduleHeader">
        <p class="moduleEyebrow">{moduleEyebrow}</p>
        <h2 class="moduleTitle">{moduleTitle}</h2>
      </header>

      <p class="heroEyebrow">{heroEyebrow}</p>
      <h3 class="heroTitle">{heroTitle}</h3>
      <a class="heroBtn" href={heroCtaHref}>{heroCtaLabel}</a>
    </div>
    <div class="heroImage">
      <img src={heroImage.src} alt={heroImage.alt} loading="lazy" />
    </div>
  </div>

  <div class="cardGrid">
    {
      cards.map((card) => (
        <article class="card">
          <div class="cardImage">
            <img src={card.image.src} alt={card.image.alt} loading="lazy" />
          </div>
          <h4 class="cardTitle">{card.title}</h4>
          <p class="cardSubtitle">{card.subtitle}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
.serviceSection {
  background: #f5f5f5;
  padding: clamp(80px, 10vw, 140px) clamp(40px, 6vw, 120px) clamp(32px, 4vw, 56px);
  color: #2f2f2f;
  display: flex;
  flex-direction: column;
}

.moduleHeader {
  margin-bottom: clamp(72px, 8vw, 120px);
}

.moduleEyebrow {
  color: #ffc400;
  font-size: 0.78rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  font-weight: 700;
  margin: 0 0 12px 0;
}

.moduleTitle {
  color: #ffc400;
  font-size: clamp(1.4rem, 2vw, 1.8rem);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.01em;
  margin: 0;
}

.heroBlock {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(40px, 6vw, 100px);
  align-items: center;
  margin-bottom: clamp(72px, 8vw, 112px);
  width: 100%;
}

.heroText {
  grid-column: 1;
  max-width: 460px;
  padding-right: 0;
}

.heroEyebrow {
  color: #6b6b6b;
  font-size: 0.95rem;
  margin: 0 0 24px 0;
  line-height: 1.4;
}

.heroTitle {
  color: #2f2f2f;
  font-size: clamp(2rem, 3.8vw, 3.2rem);
  font-weight: 300;
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin: 0 0 40px 0;
  max-width: 18ch;
}

.heroBtn {
  display: inline-block;
  padding: 14px 32px;
  border: 1px solid #2f2f2f;
  background: transparent;
  color: #2f2f2f;
  font-size: 0.85rem;
  letter-spacing: 0.08em;
  text-decoration: none;
  transition: background 0.3s ease, color 0.3s ease;
}

.heroBtn:hover {
  background: #2f2f2f;
  color: #ffffff;
}

.heroImage {
  grid-column: 2 / 4;
  aspect-ratio: 16 / 9;
  min-height: clamp(360px, 34vw, 520px);
  overflow: hidden;
  width: 100%;
}

.heroImage img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cardGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(40px, 6vw, 100px);
  width: 100%;
}

.card {
  display: flex;
  flex-direction: column;
}

.cardImage {
  aspect-ratio: 16 / 10;
  overflow: hidden;
  margin-bottom: 24px;
}

.cardImage img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.6s ease;
}

.card:hover .cardImage img {
  transform: scale(1.04);
}

.cardTitle {
  color: #2f2f2f;
  font-size: clamp(1.1rem, 1.4vw, 1.3rem);
  font-weight: 500;
  line-height: 1.3;
  margin: 0 0 8px 0;
}

.cardSubtitle {
  color: #6b6b6b;
  font-size: 0.95rem;
  line-height: 1.5;
  margin: 0;
}

@media (min-width: 1920px) {
  .serviceSection {
    max-width: 1920px;
    margin-left: auto;
    margin-right: auto;
  }
}

@media (max-width: 1024px) {
  .serviceSection {
    padding: clamp(60px, 8vw, 100px) clamp(24px, 5vw, 48px);
  }

  .heroBlock {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .heroText,
  .heroImage {
    grid-column: 1;
  }

  .cardGrid {
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
}

@media (max-width: 640px) {
  .serviceSection {
    padding: 60px 24px;
  }

  .heroBlock,
  .cardGrid {
    gap: 24px;
  }

  .cardGrid {
    grid-template-columns: 1fr;
  }

  .heroTitle {
    font-size: clamp(1.6rem, 6vw, 2rem);
  }
}
</style>