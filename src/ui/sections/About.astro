---
type Props = {
  kicker?: string;
  statement?: string;
  ctaLabel?: string;
  ctaHref?: string;
};

const {
  kicker = "Nosotros",
  statement =
    "No queremos guardar estos 15 años de experiencia. Queremos ponerlos al servicio de tu operación: asesoramos antes de enviar un equipo, acompañamos la implementación y hacemos seguimiento técnico hasta que tu planificación se cumpla.",
  ctaLabel = "Conocer VMA",
  ctaHref = "/nosotros",
} = Astro.props as Props;

const lines = [
  "Conocemos el trabajo en altura",
  "desde adentro. Pero no queremos",
  "contártelo; queremos demostrártelo.",
];

const storyLines = [
  "VMA Rental nace de una idea simple:",
  "cuando una operación depende de altura,",
  "el equipo no puede fallar.",
];
---

<section id="nosotros" class="aboutSection" data-vma-about>
  <div class="aboutShell">
    <div class="aboutRule" aria-hidden="true"></div>

    <div class="aboutGrid">
      <aside class="aboutMeta">
        <p class="aboutKicker">{kicker}</p>
      </aside>

      <div class="aboutContent">
        <h2 class="aboutStatement" aria-label={statement}>
          {lines.map((line) => (
            <span class="paintLine paintLine--light" data-about-paint-line>
              {line}
            </span>
          ))}
        </h2>

        <a class="aboutCta" href={ctaHref}>
          <span>{ctaLabel}</span>
          <span class="aboutCtaArrow" aria-hidden="true">↘</span>
        </a>
      </div>
    </div>
  </div>

  <div class="aboutBlackSequence" data-about-dark-wrap>
    <div class="aboutImageStage">
      <img
        class="aboutImage"
        src="/videos/imgBackground1.jpg"
        alt=""
        loading="lazy"
        decoding="async"
      />

      <div class="aboutImageBrand" aria-label="Somos VMA Rental">
        <span class="aboutImageKicker">Somos</span>
        <strong class="aboutImageTitle">VMA Rental</strong>
      </div>
    </div>

    <div class="aboutDarkPanel">
      <div class="aboutDarkGrid">
        <aside class="aboutDarkMeta">
          <p class="aboutDarkKicker">Cómo trabajamos</p>
        </aside>

        <div class="aboutDarkContent">
          <h3 class="aboutDarkStatement" aria-label={storyLines.join(" ")}>
            {storyLines.map((line) => (
              <span class="paintLine paintLine--dark" data-story-paint-line>
                {line}
              </span>
            ))}
          </h3>

          <a class="aboutDarkCta" href="#contacto">
            <span>Hablemos de tu operación</span>
            <span class="aboutCtaArrow" aria-hidden="true">↘</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const bindPaintGroup = ({ rootSelector, lineSelector, startRatio, endRatio }) => {
      const root = document.querySelector(rootSelector);
      if (!root) return;

      const lines = [...root.querySelectorAll(lineSelector)];
      if (!lines.length) return;

      let ticking = false;

      const update = () => {
        const viewport = window.innerHeight || 1;
        const rect = root.getBoundingClientRect();

        const start = viewport * startRatio;
        const end = viewport * endRatio;
        const progress = clamp((start - rect.top) / (start - end), 0, 1);
        const lineCount = lines.length;

        lines.forEach((line, index) => {
          const lineProgress = clamp(progress * lineCount - index, 0, 1);
          line.style.setProperty("--paint", `${Math.round(lineProgress * 100)}%`);
        });

        ticking = false;
      };

      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(update);
      };

      update();
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
    };

    const bindDarkInset = () => {
      const sequence = document.querySelector("[data-about-dark-wrap]");
      const statement = document.querySelector(".aboutDarkStatement");
      if (!sequence || !statement) return;

      let ticking = false;

      const update = () => {
        const viewport = window.innerHeight || 1;
        const rect = statement.getBoundingClientRect();

        /*
          Imagen + bloque negro arrancan full-width.
          El aire lateral aparece recién cuando el texto empieza a activarse,
          así ambos se sienten como un solo bloque.
        */
        const start = viewport * 0.76;
        const end = viewport * 0.38;
        const progress = clamp((start - rect.top) / (start - end), 0, 1);

        const maxInset =
          window.innerWidth < 760
            ? 12
            : Math.min(window.innerWidth * 0.028, 48);

        const inset = Math.round(progress * maxInset);
        const radius = Math.round(progress * 34);

        sequence.style.setProperty("--dark-inset", `${inset}px`);
        sequence.style.setProperty("--dark-radius", `${radius}px`);

        ticking = false;
      };

      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(update);
      };

      update();
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
    };

    const bindAbout = () => {
      bindPaintGroup({
        rootSelector: ".aboutStatement",
        lineSelector: "[data-about-paint-line]",
        startRatio: 0.54,
        endRatio: 0.26,
      });

      bindPaintGroup({
        rootSelector: ".aboutDarkStatement",
        lineSelector: "[data-story-paint-line]",
        startRatio: 0.82,
        endRatio: 0.32,
      });

      bindDarkInset();
    };

    bindAbout();
    document.addEventListener("DOMContentLoaded", bindAbout, { once: true });
  })();
</script>

