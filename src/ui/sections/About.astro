---
type Props = {
  id?: string;
  props?: {
    kicker?: string;
    statement?: string;
    ctaLabel?: string;
    ctaHref?: string;
    title?: string;
    description?: string;
  };
};

const {
  id = "nosotros",
  props = {},
} = Astro.props as Props;

const kicker = props.kicker ?? "Nosotros";
const statement =
  props.statement ??
  "Conocemos el trabajo en altura. Por eso combinamos equipos, disponibilidad y asesoramiento operativo para que cada alquiler llegue con el equipo correcto.";

const ctaLabel = props.ctaLabel ?? "Conocé VMA";
const ctaHref = props.ctaHref ?? "#contacto";

const imageSrc = "/images/vma-version-b/quienes-somos-vma.png";
---

<section class="aboutB" id={id}>
  <div class="aboutB__card">
    <img
      class="aboutB__image"
      src={imageSrc}
      alt="Equipo VMA Rental en operación"
      loading="lazy"
      decoding="async"
    />

    <div class="aboutB__shade" aria-hidden="true"></div>

    <div class="aboutB__content">
      <p class="aboutB__kicker">{kicker}</p>

      <div class="aboutB__copy">
        <h2>VMA RENTAL</h2>
        <p>{statement}</p>

        <a class="aboutB__cta" href={ctaHref}>
          {ctaLabel}
          <span aria-hidden="true">↘</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .aboutB {
    position: relative;
    z-index: 1;
    width: 100%;
    background: #030303;
    border: 0 !important;
    outline: 0 !important;
    overflow: hidden;
  }

  .aboutB::before,
  .aboutB::after {
    display: none !important;
    content: none !important;
  }

  .aboutB__card {
    position: relative;
    min-height: clamp(460px, 48vw, 690px);
    overflow: hidden;
    border-radius: clamp(22px, 2.4vw, 34px);
    background: #070707;
    box-shadow:
      0 34px 100px rgba(0, 0, 0, 0.42),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .aboutB__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: saturate(0.94) contrast(1.02);
  }

  .aboutB__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(3, 3, 3, 0.04) 0%,
        rgba(3, 3, 3, 0.22) 38%,
        rgba(3, 3, 3, 0.78) 72%,
        rgba(3, 3, 3, 0.98) 100%
      ),
      linear-gradient(
        90deg,
        rgba(3, 3, 3, 0.08) 0%,
        rgba(3, 3, 3, 0.08) 42%,
        rgba(3, 3, 3, 0.46) 68%,
        rgba(3, 3, 3, 0.76) 100%
      );
    pointer-events: none;
  }

  .aboutB__content {
    position: relative;
    z-index: 2;
    min-height: inherit;
    display: grid;
    grid-template-columns: minmax(160px, 0.8fr) minmax(320px, 0.95fr);
    align-items: center;
    gap: clamp(28px, 5vw, 84px);
    padding: 0 3%;
  }

  .aboutB__kicker {
    align-self: center;
    margin: 0;
    color: #ffc400;
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .aboutB__copy {
    max-width: 560px;
    margin-left: auto;
    padding-top: clamp(120px, 18vw, 220px);
  }

  .aboutB__copy h2 {
    margin: 0 0 14px;
    color: #ffc400;
    font-size: clamp(2.8rem, 6vw, 5.75rem);
    line-height: 0.9;
    letter-spacing: -0.065em;
    font-weight: 900;
    text-transform: uppercase;
  }

  .aboutB__copy p {
    margin: 0;
    max-width: 520px;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.35rem, 2.1vw, 2.1rem);
    line-height: 1.28;
    letter-spacing: -0.035em;
    font-weight: 500;
  }

  .aboutB__cta {
    margin-top: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 42px;
    padding: 0 22px;
    border-radius: 8px;
    background: #ffffff;
    color: #080808;
    font-size: 0.92rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 0.22s ease,
      background 0.22s ease,
      color 0.22s ease;
  }

  .aboutB__cta:hover {
    transform: translateY(-1px);
    background: #ffc400;
    color: #030303;
  }

  @media (max-width: 860px) {
    .aboutB {
      padding: 0;
      margin: 0;
      background: #030303;
      overflow: hidden;
    }

    .aboutB__card {
      width: 100%;
      min-height: 560px;
      margin: 0;
      border-radius: 24px 24px 0 0;
      background: #070707;
      box-shadow:
        0 24px 70px rgba(0, 0, 0, 0.44),
        inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    }

    .aboutB__image {
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }

    .aboutB__shade {
      background:
        linear-gradient(
          180deg,
          rgba(3, 3, 3, 0.02) 0%,
          rgba(3, 3, 3, 0.12) 30%,
          rgba(3, 3, 3, 0.64) 60%,
          rgba(3, 3, 3, 0.98) 100%
        );
    }

    .aboutB__content {
      min-height: 560px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: flex-start;
      gap: 18px;
      padding: 28px 22px 30px;
    }

    .aboutB__kicker {
      order: 1;
      font-size: 0.78rem;
    }

    .aboutB__copy {
      order: 2;
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding-top: 0;
    }

    .aboutB__copy h2 {
      font-size: clamp(2.2rem, 13vw, 3.5rem);
      line-height: 0.92;
      margin-bottom: 12px;
    }

    .aboutB__copy p {
      max-width: 94%;
      font-size: clamp(1.12rem, 5.6vw, 1.45rem);
      line-height: 1.35;
    }

    .aboutB__cta {
      width: fit-content;
      min-height: 40px;
      margin-top: 22px;
      padding: 0 18px;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 420px) {
    .aboutB__card {
      min-height: 560px;
      border-radius: 24px 24px 0 0;
    }

    .aboutB__content {
      min-height: 560px;
    }
  }
</style>

<style is:global>
  #nosotros,
  section#nosotros {
    border-top: 0 !important;
    border-bottom: 0 !important;
    outline: 0 !important;
  }

  #nosotros::before,
  #nosotros::after,
  section#nosotros::before,
  section#nosotros::after {
    display: none !important;
    content: none !important;
  }
</style>
