<script is:inline>
  (() => {
    const bootCleanEquipmentCarousel = () => {
      const section =
        document.querySelector("[data-equipment-section]") ||
        document.querySelector("#equipos");

      if (!section || section.dataset.vmaCleanNativeCarousel === "true") return;

      section.dataset.vmaCleanNativeCarousel = "true";

      const isMobile = () => window.matchMedia("(max-width: 760px)").matches;

      const resetScroll = () => {
        if (!isMobile()) return;

        const grid = section.querySelector("[data-equipment-grid]");
        const activeMain = section.querySelector("[data-main-category].is-active");

        if (grid) grid.scrollLeft = 0;

        if (activeMain && typeof activeMain.scrollIntoView === "function") {
          activeMain.scrollIntoView({
            behavior: "smooth",
            inline: "center",
            block: "nearest",
          });
        }
      };

      section.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        if (
          target.closest("[data-main-category]") ||
          target.closest("[data-sub-category]")
        ) {
          setTimeout(resetScroll, 80);
          setTimeout(resetScroll, 240);
        }
      });

      window.addEventListener("resize", resetScroll);
      window.addEventListener("orientationchange", resetScroll);

      setTimeout(resetScroll, 300);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bootCleanEquipmentCarousel);
    } else {
      bootCleanEquipmentCarousel();
    }
  })();
</script>

