---
import { waCotizarUrl } from "@/config/site";

type Equipment = {
  id: string;
  category: "articulado" | "tijera" | "telescopico" | "otros";
  categoryLabel: string;
  name: string;
  description: string;
  specs: {
    height: string;
    power: string;
    capacity: string;
    operation: string;
  };
  image: { src: string; alt: string };
};

type Category = {
  id: "articulado" | "tijera" | "telescopico" | "otros";
  label: string;
};

type Props = {
  moduleEyebrow?: string;
  moduleTitle?: string;
  categories?: Category[];
  equipment?: Equipment[];
  ctaLabel?: string;
  ctaHref?: string;
};

const fallbackCategories: Category[] = [
  { id: "articulado", label: "Plataformas articuladas" },
  { id: "tijera", label: "Plataformas tijera" },
  { id: "telescopico", label: "Manipuladores telescópicos" },
  { id: "otros", label: "Otros equipos" },
];

const fallbackEquipment: Equipment[] = [
  {
    id: "brazo-16m",
    category: "articulado",
    categoryLabel: "Plataforma articulada",
    name: "Brazo articulado 16m",
    description:
      "Plataforma articulada para trabajos en altura con alcance horizontal extendido. Ideal para fachadas y montajes estructurales.",
    specs: {
      height: "16m",
      power: "Diésel",
      capacity: "230kg",
      operation: "Doble plataforma",
    },
    image: {
      src: "https://images.unsplash.com/photo-1581094288338-2314dddb7ece?w=1600&auto=format&fit=crop&q=80",
      alt: "Brazo articulado de 16 metros en operación",
    },
  },
  {
    id: "tijera-8m",
    category: "tijera",
    categoryLabel: "Plataforma tijera",
    name: "Tijera eléctrica 8m",
    description:
      "Plataforma tijera eléctrica para trabajos interiores. Operación silenciosa y cero emisiones, ideal para naves industriales y obra terminada.",
    specs: {
      height: "8m",
      power: "Eléctrica",
      capacity: "230kg",
      operation: "Interior",
    },
    image: {
      src: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1600&auto=format&fit=crop&q=80",
      alt: "Plataforma tijera eléctrica de 8 metros",
    },
  },
  {
    id: "tijera-12m",
    category: "tijera",
    categoryLabel: "Plataforma tijera",
    name: "Tijera diésel 12m",
    description:
      "Plataforma tijera diésel para superficies irregulares y exteriores. Resistente a condiciones de obra exigentes.",
    specs: {
      height: "12m",
      power: "Diésel",
      capacity: "320kg",
      operation: "Exterior",
    },
    image: {
      src: "https://images.unsplash.com/photo-1565514020179-026b92b84bb6?w=1600&auto=format&fit=crop&q=80",
      alt: "Plataforma tijera diésel de 12 metros",
    },
  },
  {
    id: "telescopico-20m",
    category: "telescopico",
    categoryLabel: "Manipulador telescópico",
    name: "Telescópico 20m",
    description:
      "Manipulador telescópico de gran alcance vertical y horizontal. Para trabajos en altura con precisión de posicionamiento.",
    specs: {
      height: "20m",
      power: "Diésel",
      capacity: "200kg",
      operation: "Mixto",
    },
    image: {
      src: "https://images.unsplash.com/photo-1530124566582-a618bc2615dc?w=1600&auto=format&fit=crop&q=80",
      alt: "Manipulador telescópico de 20 metros en obra",
    },
  },
];

const props = Astro.props as Props;

const moduleEyebrow = props.moduleEyebrow ?? "FLOTA VMA";
const moduleTitle = props.moduleTitle ?? "Equipos disponibles";
const categories = props.categories ?? fallbackCategories;
const equipment = props.equipment ?? fallbackEquipment;
const ctaLabel = props.ctaLabel ?? "Solicitar cotización";

/*
  Si home.ts manda "#contacto", igual usamos WhatsApp para este CTA
  porque el objetivo es enviar contexto directo al comercial.
*/
const baseCtaHref =
  props.ctaHref && !props.ctaHref.startsWith("#") ? props.ctaHref : waCotizarUrl;
---

<section id="equipos" class="equipmentSection" data-equipment-section>
  <header class="moduleHeader">
    <p class="moduleEyebrow">{moduleEyebrow}</p>
    <h2 class="moduleTitle">{moduleTitle}</h2>
  </header>

  <nav class="categoryNav" aria-label="Categorías de equipos">
    {
      categories.map((cat, idx) => (
        <button
          class={`categoryBtn ${idx === 0 ? "is-active" : ""}`}
          data-category={cat.id}
          type="button"
        >
          {cat.label}
        </button>
      ))
    }
  </nav>

  <div class="equipmentStage">
    {
      equipment.map((eq, idx) => (
        <article
          class={`equipmentCard ${idx === 0 ? "is-active" : ""}`}
          data-equipment-id={eq.id}
          data-category={eq.category}
          data-category-label={eq.categoryLabel}
          data-equipment-name={eq.name}
          data-equipment-description={eq.description}
          data-height={eq.specs.height}
          data-power={eq.specs.power}
          data-capacity={eq.specs.capacity}
          data-operation={eq.specs.operation}
        >
          <div class="equipmentImage">
            <img src={eq.image.src} alt={eq.image.alt} loading="lazy" />
          </div>

          <div class="equipmentInfo">
            <p class="equipmentCategory">{eq.categoryLabel}</p>
            <h3 class="equipmentName">{eq.name}</h3>
            <p class="equipmentDescription">{eq.description}</p>

            <dl class="equipmentSpecs">
              <div class="spec">
                <dt>Altura máxima</dt>
                <dd>{eq.specs.height}</dd>
              </div>
              <div class="spec">
                <dt>Energía</dt>
                <dd>{eq.specs.power}</dd>
              </div>
              <div class="spec">
                <dt>Capacidad</dt>
                <dd>{eq.specs.capacity}</dd>
              </div>
              <div class="spec">
                <dt>Operación</dt>
                <dd>{eq.specs.operation}</dd>
              </div>
            </dl>

            <a
              class="equipmentCta"
              href={baseCtaHref}
              data-equipment-cta
              data-base-href={baseCtaHref}
            >
              <span>{ctaLabel}</span>
              <span aria-hidden="true">↘</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <div class="equipmentNote">
    <p>Disponibilidad de flota 100%. Manuales y datos técnicos disponibles.</p>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector<HTMLElement>("[data-equipment-section]");
    if (!section) return;

    const categoryBtns = section.querySelectorAll<HTMLButtonElement>(".categoryBtn");
    const equipmentCards = section.querySelectorAll<HTMLElement>(".equipmentCard");

    function buildQuoteUrl(card: HTMLElement, baseHref: string): string {
      const name = card.dataset.equipmentName ?? "";
      const category = card.dataset.categoryLabel ?? "";
      const description = card.dataset.equipmentDescription ?? "";
      const height = card.dataset.height ?? "";
      const power = card.dataset.power ?? "";
      const capacity = card.dataset.capacity ?? "";
      const operation = card.dataset.operation ?? "";

      const message = [
        "Hola VMA Rental, quiero solicitar una cotización.",
        "",
        `Equipo seleccionado: ${name}`,
        `Categoría: ${category}`,
        `Altura máxima: ${height}`,
        `Energía: ${power}`,
        `Capacidad: ${capacity}`,
        `Operación: ${operation}`,
        "",
        `Contexto: ${description}`,
        "",
        "Quedo atento para avanzar con la cotización.",
      ].join("\n");

      const encoded = encodeURIComponent(message);

      if (baseHref.includes("wa.me/")) {
        const separator = baseHref.includes("?") ? "&" : "?";
        return `${baseHref}${separator}text=${encoded}`;
      }

      if (baseHref.includes("api.whatsapp.com/send")) {
        const separator = baseHref.includes("?") ? "&" : "?";
        return `${baseHref}${separator}text=${encoded}`;
      }

      return baseHref;
    }

    function updateCta(card: HTMLElement): void {
      const cta = card.querySelector<HTMLAnchorElement>("[data-equipment-cta]");
      if (!cta) return;

      const baseHref = cta.dataset.baseHref ?? cta.href;
      cta.href = buildQuoteUrl(card, baseHref);
    }

    function activateCategory(categoryId: string): void {
      categoryBtns.forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.category === categoryId);
      });

      let foundFirst = false;

      equipmentCards.forEach((card) => {
        const matches = card.dataset.category === categoryId;
        const shouldActivate = matches && !foundFirst;

        card.classList.toggle("is-active", shouldActivate);

        if (shouldActivate) {
          foundFirst = true;
          updateCta(card);
        }
      });
    }

    const activeCard = section.querySelector<HTMLElement>(".equipmentCard.is-active");
    if (activeCard) updateCta(activeCard);

    categoryBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.category;
        if (cat) activateCategory(cat);
      });
    });
  });
</script>

<style>
  .equipmentSection,
  .equipmentSection * {
    box-sizing: border-box;
  }

  .equipmentSection {
    background: #070707;
    padding:clamp(80px,10vw,140px) clamp(40px,3.7vw,120px);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
  }

  .moduleHeader {
    margin-bottom: 48px;
    padding: 0;
  }

  .moduleEyebrow {
    color: #ffc400;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 12px;
    font-family: var(--font-body);
  }

  .moduleTitle {
    color: #ffffff;
    font-family: var(--font-body);
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .categoryNav {
    font-family: var(--font-body);
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0 0 64px;
    padding: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    list-style: none;
  }

  .categoryBtn {
    font-family: var(--font-body);
    flex-shrink: 0;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    padding: 16px 24px;
    margin: 0;
    cursor: pointer;
    position: relative;
    font-family: inherit;
    white-space: nowrap;
    transition:
      color 260ms ease,
      background 260ms ease,
      box-shadow 260ms ease;
  }

  .categoryBtn::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 24px;
    right: 24px;
    height: 1px;
    background: #ffc400;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .categoryBtn:hover {
    color: rgba(255, 255, 255, 0.88);
  }

  .categoryBtn.is-active {
    color: #ffc400;
  }

  .categoryBtn.is-active::after {
    transform: scaleX(1);
  }

  .equipmentStage {
    position: relative;
    width: 100%;
    min-height: 400px;
    margin: 0;
    padding: 0;
  }

  .equipmentCard {
    display: none;
    width: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    transform: translateY(14px);
    filter: blur(5px);
    pointer-events: none;
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .equipmentCard.is-active {
    display: grid;
    grid-template-columns: 60% 40%;
    gap: clamp(40px, 6vw, 100px);
    align-items: center;
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    pointer-events: auto;
    animation: fadeIn 0.5s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .equipmentImage {
    aspect-ratio: 16 / 11;
    overflow: hidden;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: clamp(18px, 1.4vw, 28px);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .equipmentImage img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
    margin: 0;
    padding: 0;
    transform: scale(1.012);
    transition:
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.3s ease;
  }

  .equipmentCard.is-active .equipmentImage {
    border-color: rgba(255, 196, 0, 0.82);
    box-shadow:
      0 0 0 1px rgba(255, 196, 0, 0.35),
      0 24px 72px rgba(255, 196, 0, 0.1);
  }

  .equipmentCard.is-active .equipmentImage img {
    transform: scale(1);
  }

  .equipmentCard.is-active:hover .equipmentImage {
    border-color: #ffc400;
    box-shadow:
      0 0 0 1px rgba(255, 196, 0, 0.55),
      0 28px 86px rgba(255, 196, 0, 0.16);
  }

  .equipmentCard.is-active:hover .equipmentImage img {
    transform: scale(1.025);
  }

  .equipmentInfo {
    padding: 0;
    margin: 0;
    font-family: var(--font-body);
  }

  .equipmentCategory {
    color: #ffc400;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 16px;
  }

  .equipmentName {
    color: #ffffff;
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
  }

  .equipmentDescription {
    color: #c9c9c9;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 32px;
    max-width: 42ch;
  }

  .equipmentSpecs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 0 0 40px;
    padding: 24px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    list-style: none;
  }

  .spec {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
  }

  .spec dt {
    color: #6b6b6b;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0;
  }

  .spec dd {
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 400;
    margin: 0;
  }

  .equipmentCta {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 54px;
    padding: 0 32px;
    border: 1px solid rgba(255, 196, 0, 0.82);
    border-radius: 10px;
    background: rgba(255, 196, 0, 0.08);
    color: #ffc400;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      gap 0.3s ease;
  }

  .equipmentCta:hover {
    background: #ffc400;
    color: #080808;
    border-color: #ffc400;
    box-shadow: 0 18px 48px rgba(255, 196, 0, 0.18);
    gap: 16px;
  }

  .equipmentNote {
    margin-top: 80px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .equipmentNote p {
    color: #6b6b6b;
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 1920px) {
    .equipmentSection {
      max-width: 1920px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 1024px) {
    .equipmentSection {
      padding:
        clamp(60px, 8vw, 100px)
        clamp(24px, 5vw, 48px);
    }

    .equipmentCard.is-active {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .equipmentName {
      font-size: clamp(1.6rem, 4vw, 2rem);
    }
  }

  @media (max-width: 640px) {
    .equipmentSection {
      padding: 60px 24px;
    }

    .categoryNav {
      margin-bottom: 40px;
    }

    .categoryBtn {
      padding: 12px 16px;
      font-size: 0.82rem;
    }

    .equipmentSpecs {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .equipmentName {
      font-size: 1.5rem;
    }

    .equipmentDescription {
      font-size: 0.95rem;
    }

    .equipmentCta {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .equipmentCard,
    .equipmentImage,
    .equipmentImage img,
    .categoryBtn,
    .equipmentCta {
      transition: none;
      animation: none;
    }
  }
</style>