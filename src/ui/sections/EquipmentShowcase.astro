    const mq = window.matchMedia("(max-width: 760px)");

    const getSection = () =>
      document.querySelector("[data-equipment-section]") ||
      document.querySelector("#equipos");

    const forceMobileCarousel = () => {
      if (!mq.matches) return;

      const section = getSection();
      if (!section) return;

      const carousel = section.querySelector("[data-equipment-carousel]");
      const grid = section.querySelector("[data-equipment-grid]");
      const cards = [...section.querySelectorAll("[data-machine-card].is-visible")]
        .filter((card) => {
          const style = getComputedStyle(card);
          return style.display !== "none" && style.visibility !== "hidden";
        });

      if (!carousel || !grid) return;

      carousel.style.setProperty("width", "100%", "important");
      carousel.style.setProperty("max-width", "100vw", "important");
      carousel.style.setProperty("overflow-x", "auto", "important");
      carousel.style.setProperty("overflow-y", "visible", "important");
      carousel.style.setProperty("-webkit-overflow-scrolling", "touch", "important");
      carousel.style.setProperty("touch-action", "pan-x", "important");
      carousel.style.setProperty("scroll-snap-type", "x mandatory", "important");
      carousel.style.setProperty("transform", "none", "important");
      carousel.style.setProperty("pointer-events", "auto", "important");

      grid.style.setProperty("display", "flex", "important");
      grid.style.setProperty("flex-wrap", "nowrap", "important");
      grid.style.setProperty("width", "max-content", "important");
      grid.style.setProperty("min-width", "max-content", "important");
      grid.style.setProperty("max-width", "none", "important");
      grid.style.setProperty("overflow", "visible", "important");
      grid.style.setProperty("transform", "none", "important");
      grid.style.setProperty("translate", "none", "important");
      grid.style.setProperty("touch-action", "pan-x", "important");
      grid.style.setProperty("pointer-events", "auto", "important");

      cards.forEach((card) => {
        card.style.setProperty("flex", "0 0 310px", "important");
        card.style.setProperty("width", "310px", "important");
        card.style.setProperty("min-width", "310px", "important");
        card.style.setProperty("max-width", "310px", "important");
        card.style.setProperty("transform", "none", "important");
        card.style.setProperty("pointer-events", "auto", "important");
        card.style.setProperty("touch-action", "manipulation", "important");
      });
    };

    let startX = 0;
    let startY = 0;
    let moved = false;
    let syntheticClickRunning = false;

    document.addEventListener("pointerdown", (event) => {
      if (!mq.matches) return;

      const card = event.target.closest?.("#equipos [data-machine-card].is-visible");
      if (!card) return;

      startX = event.clientX;
      startY = event.clientY;
      moved = false;
    }, true);

    document.addEventListener("pointermove", (event) => {
      if (!mq.matches) return;

      const dx = Math.abs(event.clientX - startX);
      const dy = Math.abs(event.clientY - startY);

      if (dx > 12 || dy > 12) {
        moved = true;
      }
    }, true);

    document.addEventListener("pointerup", (event) => {
      if (!mq.matches) return;
      if (moved) return;

      const card = event.target.closest?.("#equipos [data-machine-card].is-visible");
      if (!card) return;
      if (syntheticClickRunning) return;

      syntheticClickRunning = true;

      /*
        Esto dispara el listener original:
        cards.forEach((c) => c.addEventListener("click", () => openDetail(c)))
      */
      card.dispatchEvent(
        new MouseEvent("click", {
          bubbles: true,
          cancelable: true,
          view: window,
        })
      );

      setTimeout(() => {
        const section = getSection();
        const detail = section?.querySelector("[data-detail-panel]");

        if (detail?.classList.contains("is-active")) {
          detail.removeAttribute("hidden");
          detail.setAttribute("aria-hidden", "false");
        }

        syntheticClickRunning = false;
      }, 80);
    }, true);

    document.addEventListener("click", (event) => {
      const filter = event.target.closest?.(
        "#equipos [data-main-category], #equipos [data-sub-category]"
      );

      if (!filter) return;

      setTimeout(forceMobileCarousel, 80);
      setTimeout(forceMobileCarousel, 220);
      setTimeout(forceMobileCarousel, 500);
    }, true);

    document.addEventListener("DOMContentLoaded", () => {
      forceMobileCarousel();
      setTimeout(forceMobileCarousel, 250);
      setTimeout(forceMobileCarousel, 700);
    });

    window.addEventListener("resize", forceMobileCarousel);
    window.addEventListener("orientationchange", () => {
      setTimeout(forceMobileCarousel, 250);
    });

    window.VMA_MOBILE_EQUIPMENT_FINAL = {
      forceMobileCarousel,
    };
  })();
</script>
<!-- VMA_MOBILE_EQUIPMENT_FINAL_FIX_END -->

