<script is:inline>
  (() => {
    const bootNativeMobileEquipmentScroll = () => {
      const section =
        document.querySelector("[data-equipment-section]") ||
        document.querySelector("#equipos");

      if (!section) return;

      const grid = section.querySelector("[data-equipment-grid]");
      if (!grid) return;

      section.dataset.vmaNativeMobileScrollFinal = "true";

      const isMobile = () => window.matchMedia("(max-width: 760px)").matches;

      const repair = () => {
        if (!isMobile()) return;

        grid.style.setProperty("display", "flex", "important");
        grid.style.setProperty("flex-wrap", "nowrap", "important");
        grid.style.setProperty("overflow-x", "auto", "important");
        grid.style.setProperty("overflow-y", "hidden", "important");
        grid.style.setProperty("-webkit-overflow-scrolling", "touch", "important");
        grid.style.setProperty("touch-action", "pan-x pan-y", "important");
        grid.style.setProperty("transform", "none", "important");
        grid.style.setProperty("width", "100vw", "important");
        grid.style.setProperty("min-width", "100vw", "important");
        grid.style.setProperty("max-width", "100vw", "important");

        section.querySelectorAll("[data-machine-card]").forEach((card) => {
          const visible = card.classList.contains("is-visible");

          if (!visible) {
            card.style.setProperty("display", "none", "important");
            return;
          }

          card.style.setProperty("display", "flex", "important");
          card.style.setProperty("flex", "0 0 78vw", "important");
          card.style.setProperty("width", "78vw", "important");
          card.style.setProperty("min-width", "78vw", "important");
          card.style.setProperty("max-width", "78vw", "important");
          card.style.setProperty("transform", "none", "important");
        });
      };

      repair();

      section.addEventListener("click", () => {
        window.setTimeout(repair, 80);
        window.setTimeout(repair, 220);
      });

      window.addEventListener("resize", repair);

      const observer = new MutationObserver(() => {
        window.requestAnimationFrame(repair);
      });

      observer.observe(section, {
        subtree: true,
        attributes: true,
        attributeFilter: ["class", "style", "hidden"],
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bootNativeMobileEquipmentScroll);
    } else {
      bootNativeMobileEquipmentScroll();
    }
  })();
</script>




