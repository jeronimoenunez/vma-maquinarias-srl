---
type Equipment = {
  id: string;
  category: "articulado" | "tijera" | "telescopico" | "otros";
  categoryLabel: string;
  name: string;
  description: string;
  specs: {
    height: string;
    power: string;
    capacity: string;
    operation: string;
  };
  image: { src: string; alt: string };
};

type Category = {
  id: "articulado" | "tijera" | "telescopico" | "otros";
  label: string;
};

type Props = {
  moduleEyebrow?: string;
  moduleTitle?: string;
  categories?: Category[];
  equipment?: Equipment[];
  ctaLabel?: string;
  ctaHref?: string;
};

const fallbackCategories: Category[] = [
  { id: "articulado", label: "Plataformas articuladas" },
  { id: "tijera", label: "Plataformas tijera" },
  { id: "telescopico", label: "Manipuladores telescópicos" },
  { id: "otros", label: "Otros equipos" },
];

const fallbackEquipment: Equipment[] = [
  {
    id: "brazo-16m",
    category: "articulado",
    categoryLabel: "Plataforma articulada",
    name: "Brazo articulado 16m",
    description:
      "Plataforma articulada para trabajos en altura con alcance horizontal extendido. Ideal para fachadas y montajes estructurales.",
    specs: {
      height: "16m",
      power: "Diésel",
      capacity: "230kg",
      operation: "Doble plataforma",
    },
    image: {
      src: "https://images.unsplash.com/photo-1581094288338-2314dddb7ece?w=1600&auto=format&fit=crop&q=80",
      alt: "Brazo articulado de 16 metros en operación",
    },
  },
  {
    id: "tijera-8m",
    category: "tijera",
    categoryLabel: "Plataforma tijera",
    name: "Tijera eléctrica 8m",
    description:
      "Plataforma tijera eléctrica para trabajos interiores. Operación silenciosa y cero emisiones, ideal para naves industriales y obra terminada.",
    specs: {
      height: "8m",
      power: "Eléctrica",
      capacity: "230kg",
      operation: "Interior",
    },
    image: {
      src: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1600&auto=format&fit=crop&q=80",
      alt: "Plataforma tijera eléctrica de 8 metros",
    },
  },
  {
    id: "tijera-12m",
    category: "tijera",
    categoryLabel: "Plataforma tijera",
    name: "Tijera diésel 12m",
    description:
      "Plataforma tijera diésel para superficies irregulares y exteriores. Resistente a condiciones de obra exigentes.",
    specs: {
      height: "12m",
      power: "Diésel",
      capacity: "320kg",
      operation: "Exterior",
    },
    image: {
      src: "https://images.unsplash.com/photo-1565514020179-026b92b84bb6?w=1600&auto=format&fit=crop&q=80",
      alt: "Plataforma tijera diésel de 12 metros",
    },
  },
  {
    id: "telescopico-20m",
    category: "telescopico",
    categoryLabel: "Manipulador telescópico",
    name: "Telescópico 20m",
    description:
      "Manipulador telescópico de gran alcance vertical y horizontal. Para trabajos en altura con precisión de posicionamiento.",
    specs: {
      height: "20m",
      power: "Diésel",
      capacity: "200kg",
      operation: "Mixto",
    },
    image: {
      src: "https://images.unsplash.com/photo-1530124566582-a618bc2615dc?w=1600&auto=format&fit=crop&q=80",
      alt: "Manipulador telescópico de 20 metros en obra",
    },
  },
];

const props = Astro.props as Props;

const moduleEyebrow = props.moduleEyebrow ?? "FLOTA VMA";
const moduleTitle = props.moduleTitle ?? "Equipos disponibles";
const categories = props.categories ?? fallbackCategories;
const equipment = props.equipment ?? fallbackEquipment;
const ctaLabel = props.ctaLabel ?? "Solicitar cotización";
const ctaHref = props.ctaHref ?? "#contacto";
---

<section id="equipos" class="equipmentSection">
  <header class="moduleHeader">
    <p class="moduleEyebrow">{moduleEyebrow}</p>
    <h2 class="moduleTitle">{moduleTitle}</h2>
  </header>

  <nav class="categoryNav" aria-label="Categorías de equipos">
    {
      categories.map((cat, idx) => (
        <button
          class={`categoryBtn ${idx === 0 ? "is-active" : ""}`}
          data-category={cat.id}
          type="button"
        >
          {cat.label}
        </button>
      ))
    }
  </nav>

  <div class="equipmentStage">
    {
      equipment.map((eq, idx) => (
        <article
          class={`equipmentCard ${idx === 0 ? "is-active" : ""}`}
          data-equipment-id={eq.id}
          data-category={eq.category}
        >
          <div class="equipmentImage">
            <img src={eq.image.src} alt={eq.image.alt} loading="lazy" />
          </div>

          <div class="equipmentInfo">
            <p class="equipmentCategory">{eq.categoryLabel}</p>
            <h3 class="equipmentName">{eq.name}</h3>
            <p class="equipmentDescription">{eq.description}</p>

            <dl class="equipmentSpecs">
              <div class="spec">
                <dt>Altura máxima</dt>
                <dd>{eq.specs.height}</dd>
              </div>
              <div class="spec">
                <dt>Energía</dt>
                <dd>{eq.specs.power}</dd>
              </div>
              <div class="spec">
                <dt>Capacidad</dt>
                <dd>{eq.specs.capacity}</dd>
              </div>
              <div class="spec">
                <dt>Operación</dt>
                <dd>{eq.specs.operation}</dd>
              </div>
            </dl>

            <a class="equipmentCta" href={ctaHref}>{ctaLabel}</a>
          </div>
        </article>
      ))
    }
  </div>

  <div class="equipmentNote">
    <p>
      Disponibilidad de flota 100%. Manuales y datos técnicos disponibles.
    </p>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const categoryBtns = document.querySelectorAll<HTMLButtonElement>(
      ".categoryBtn"
    );
    const equipmentCards = document.querySelectorAll<HTMLElement>(
      ".equipmentCard"
    );

    function activateCategory(categoryId: string): void {
      categoryBtns.forEach((btn) => {
        if (btn.dataset.category === categoryId) {
          btn.classList.add("is-active");
        } else {
          btn.classList.remove("is-active");
        }
      });

      let foundFirst = false;
      equipmentCards.forEach((card) => {
        const matches = card.dataset.category === categoryId;
        if (matches && !foundFirst) {
          card.classList.add("is-active");
          foundFirst = true;
        } else {
          card.classList.remove("is-active");
        }
      });
    }

    categoryBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.category;
        if (cat) activateCategory(cat);
      });
    });
  });
</script>

<style>
  .equipmentSection,
  .equipmentSection * {
    box-sizing: border-box;
  }

  .equipmentSection {
    background: #070707;
    padding-top: clamp(80px, 10vw, 140px) !important;
    padding-bottom: clamp(80px, 10vw, 140px) !important;
    padding-left: clamp(40px, 6vw, 120px) !important;
    padding-right: clamp(40px, 6vw, 120px) !important;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
  }

  .moduleHeader {
    margin-bottom: 48px;
    padding: 0;
  }

  .moduleEyebrow {
    color: #ffc400;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 12px 0;
  }

  .moduleTitle {
    color: #ffffff;
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .categoryNav {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0 0 64px 0;
    padding: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    list-style: none;
  }

  .categoryBtn {
    flex-shrink: 0;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    padding: 16px 24px;
    margin: 0;
    cursor: pointer;
    position: relative;
    transition: color 0.3s ease;
    font-family: inherit;
    white-space: nowrap;
  }

  .categoryBtn::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 24px;
    right: 24px;
    height: 1px;
    background: #ffc400;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .categoryBtn:hover {
    color: rgba(255, 255, 255, 0.85);
  }

  .categoryBtn.is-active {
    color: #ffffff;
  }

  .categoryBtn.is-active::after {
    transform: scaleX(1);
  }

  .equipmentStage {
    position: relative;
    width: 100%;
    min-height: 400px;
    margin: 0;
    padding: 0;
  }

  .equipmentCard {
    display: none;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .equipmentCard.is-active {
    display: grid;
    grid-template-columns: 60% 40%;
    gap: clamp(40px, 6vw, 100px);
    align-items: center;
    animation: fadeIn 0.5s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .equipmentImage {
    aspect-ratio: 16 / 11;
    overflow: hidden;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .equipmentImage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    margin: 0;
    padding: 0;
  }

  .equipmentInfo {
    padding: 0;
    margin: 0;
  }

  .equipmentCategory {
    color: #ffc400;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 16px 0;
  }

  .equipmentName {
    color: #ffffff;
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 20px 0;
  }

  .equipmentDescription {
    color: #c9c9c9;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 32px 0;
    max-width: 42ch;
  }

  .equipmentSpecs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 0 0 40px 0;
    padding: 24px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    list-style: none;
  }

  .spec {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
  }

  .spec dt {
    color: #6b6b6b;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0;
  }

  .spec dd {
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 400;
    margin: 0;
  }

  .equipmentCta {
    display: inline-block;
    padding: 14px 32px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: transparent;
    color: #ffffff;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .equipmentCta:hover {
    background: #ffffff;
    color: #1a1a1a;
    border-color: #ffffff;
  }

  .equipmentNote {
    margin-top: 80px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .equipmentNote p {
    color: #6b6b6b;
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 1920px) {
    .equipmentSection {
      max-width: 1920px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 1024px) {
    .equipmentSection {
      padding-top: clamp(60px, 8vw, 100px) !important;
      padding-bottom: clamp(60px, 8vw, 100px) !important;
      padding-left: clamp(24px, 5vw, 48px) !important;
      padding-right: clamp(24px, 5vw, 48px) !important;
    }

    .equipmentCard.is-active {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .equipmentName {
      font-size: clamp(1.6rem, 4vw, 2rem);
    }
  }

  @media (max-width: 640px) {
    .equipmentSection {
      padding-top: 60px !important;
      padding-bottom: 60px !important;
      padding-left: 24px !important;
      padding-right: 24px !important;
    }

    .categoryNav {
      gap: 0;
      margin-bottom: 40px;
    }

    .categoryBtn {
      padding: 12px 16px;
      font-size: 0.82rem;
    }

    .equipmentSpecs {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .equipmentName {
      font-size: 1.5rem;
    }

    .equipmentDescription {
      font-size: 0.95rem;
    }
  }
</style>