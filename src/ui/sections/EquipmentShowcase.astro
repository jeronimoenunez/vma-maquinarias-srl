<script type="module">
  (() => {
    const section = document.querySelector("[data-equipment-section]");
    if (!section) return;

    const detail = section.querySelector("[data-detail-panel]");
    const closeBtn = section.querySelector("[data-close-detail]");

    const isMobile = () => window.matchMedia("(max-width: 760px)").matches;

    const syncLock = () => {
      const open = Boolean(detail?.classList.contains("is-active") && isMobile());
      document.documentElement.classList.toggle("vma-equipment-modal-open", open);
      document.body.classList.toggle("vma-equipment-modal-open", open);
    };

    if (detail) {
      const observer = new MutationObserver(syncLock);
      observer.observe(detail, { attributes: true, attributeFilter: ["class"] });

      detail.addEventListener("click", (event) => {
        if (!isMobile()) return;
        if (event.target === detail) closeBtn?.click();
      });
    }

    window.addEventListener("resize", syncLock);

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && detail?.classList.contains("is-active")) {
        closeBtn?.click();
      }
    });

    syncLock();
  })();
</script>

