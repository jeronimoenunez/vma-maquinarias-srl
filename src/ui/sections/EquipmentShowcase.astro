<script is:inline>
  (() => {
    const bootEquipmentNavAutoScroll = () => {
      const section =
        document.querySelector("[data-equipment-section]") ||
        document.querySelector("#equipos");

      if (!section || section.dataset.vmaNavAutoScrollReady === "true") return;

      section.dataset.vmaNavAutoScrollReady = "true";

      const isMobile = () => window.matchMedia("(max-width: 760px)").matches;

      const scrollButtonIntoView = (button) => {
        if (!button || !isMobile()) return;

        const scroller =
          button.closest(".catNav") ||
          button.closest(".subNav") ||
          button.closest(".vmaMobileMainFilter") ||
          button.closest(".vmaMobileSubfilter");

        if (!scroller) return;

        window.requestAnimationFrame(() => {
          const buttonRect = button.getBoundingClientRect();
          const scrollerRect = scroller.getBoundingClientRect();

          const currentLeft = scroller.scrollLeft;
          const buttonCenter = buttonRect.left - scrollerRect.left + buttonRect.width / 2;
          const targetLeft = currentLeft + buttonCenter - scrollerRect.width / 2;

          scroller.scrollTo({
            left: Math.max(0, targetLeft),
            behavior: "smooth",
          });
        });
      };

      const mainButtons = Array.from(
        section.querySelectorAll("[data-main-category]")
      );

      const subButtons = Array.from(
        section.querySelectorAll("[data-sub-category]")
      );

      mainButtons.forEach((button) => {
        button.addEventListener("click", () => {
          scrollButtonIntoView(button);
        });
      });

      subButtons.forEach((button) => {
        button.addEventListener("click", () => {
          scrollButtonIntoView(button);
        });
      });

      const observer = new MutationObserver(() => {
        const activeMain = section.querySelector("[data-main-category].is-active");
        const activeSub = section.querySelector("[data-sub-category].is-active");

        if (activeMain) scrollButtonIntoView(activeMain);
        if (activeSub) scrollButtonIntoView(activeSub);
      });

      observer.observe(section, {
        subtree: true,
        attributes: true,
        attributeFilter: ["class"],
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bootEquipmentNavAutoScroll);
    } else {
      bootEquipmentNavAutoScroll();
    }
  })();
</script>


