  | "brazo-telescopico"
  | "unipersonal"
  | "manipulador-carga";

type SubCategoryId =
  | "tijera-diesel-4x4"
  | "tijera-electricas"
  | "tijera-electricas-4x4"
  | "brazo-articulado-diesel-4x4"
  | "brazo-articulado-electrico"
  | "brazo-telescopico"
  | "unipersonal"
  | "manipulador-carga";

type EquipmentItem = {
  id: string;
  mainCategory: MainCategoryId;
  subCategory: SubCategoryId;
  eyebrow: string;
  title: string;
  subtitle?: string;
  description: string;
  specs: {
    height: string;
    power: string;
    capacity: string;
    operation: string;
  };
  image: {
    src: string;
    alt: string;
  };
  manualHref?: string;
};

type Props = {
  moduleEyebrow?: string;
  moduleTitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
};

const props = Astro.props as Props;

const moduleEyebrow = props.moduleEyebrow ?? "FLOTA VMA";
const moduleTitle = props.moduleTitle ?? "Equipos disponibles";
const ctaLabel = props.ctaLabel ?? "Solicitar cotización";

const baseCtaHref =
  props.ctaHref && !props.ctaHref.startsWith("#") ? props.ctaHref : waCotizarUrl;

const mainCategories: Array<{
  id: MainCategoryId;
  label: string;
  defaultSubCategory: SubCategoryId;
  hasSubmenu: boolean;
}> = [
  { id: "tijera", label: "Tijeras", defaultSubCategory: "tijera-diesel-4x4", hasSubmenu: true },
