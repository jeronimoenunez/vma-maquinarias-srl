const defaultItem = equipment.find((item) => item.id === "tijera-diesel-4x4") ?? equipment[0];

function buildQuoteHref(item: EquipmentItem): string {
  const message = [
    "Hola VMA Rental, quiero solicitar una cotización.",
    "",
    `Equipo seleccionado: ${item.title}${item.subtitle ? ` ${item.subtitle}` : ""}`,
    `Categoría: ${item.eyebrow}`,
    `Altura máxima: ${item.specs.height}`,
    `Energía: ${item.specs.power}`,
    `Capacidad: ${item.specs.capacity}`,
    `Operación: ${item.specs.operation}`,
    "",
    "Quedo atento para avanzar con la cotización.",
  ].join("\n");

  const encoded = encodeURIComponent(message);

  if (baseCtaHref.includes("wa.me/") || baseCtaHref.includes("api.whatsapp.com/send")) {
    const separator = baseCtaHref.includes("?") ? "&" : "?";
    return `${baseCtaHref}${separator}text=${encoded}`;
  }

  return baseCtaHref;
}
---

<section id="equipos" class="eqSection" data-equipment-section>
  <div class="eqShell">
    <header class="eqHeader">
      <p class="eqEyebrow">{moduleEyebrow}</p>
      <h2 class="eqTitle">{moduleTitle}</h2>
    </header>

    <nav class="catNav" aria-label="Categorías de equipos">
      {mainCategories.map((cat, index) => (
        <button
          class={`catBtn ${index === 0 ? "is-active" : ""}`}
          type="button"
          data-main-category={cat.id}
          data-default-sub={cat.defaultSubCategory}
          data-has-submenu={String(cat.hasSubmenu)}
        >
          {cat.label}
        </button>
      ))}
    </nav>

    <div class="subNavWrap" aria-label="Filtros de energía">
      {mainCategories.filter((cat) => cat.hasSubmenu).map((cat, index) => (
        <div class={`subNav ${index === 0 ? "is-active" : ""}`} data-sub-group={cat.id}>
          {subCategories[cat.id].map((sub, subIndex) => (
            <button
              class={`subBtn ${index === 0 && subIndex === 0 ? "is-active is-visible" : ""}`}
              type="button"
              data-parent-category={cat.id}
              data-sub-category={sub.id}
            >
              {sub.label}
            </button>
          ))}
        </div>
      ))}
    </div>

    <div class="eqContent">
      <div class="eqCarousel" data-equipment-carousel hidden>
        <button class="arrowBtn arrowBtn--prev" type="button" data-carousel-prev>‹</button>

        <div class="eqGrid" data-equipment-grid>
          {equipment.map((item) => (
            <button
              class="card"
              type="button"
              data-machine-card
              data-id={item.id}
              data-main-category={item.mainCategory}
              data-sub-category={item.subCategory}
              data-eyebrow={item.eyebrow}
              data-title={item.title}
              data-subtitle={item.subtitle ?? ""}
              data-description={item.description}
              data-height={item.specs.height}
              data-power={item.specs.power}
              data-capacity={item.specs.capacity}
              data-operation={item.specs.operation}
              data-image-src={item.image.src}
              data-image-alt={item.image.alt}
              data-manual-href={item.manualHref ?? ""}
              data-quote-href={buildQuoteHref(item)}
            >
              <span class="cardImg">
                <img src={item.image.src} alt={item.image.alt} loading="lazy" />
              </span>
              <span class="cardMeta">
                <span class="cardEyebrow">{item.eyebrow}</span>
                <span class="cardName">
                  {item.title}
                  {item.subtitle ? <small>{item.subtitle}</small> : null}
                </span>
              </span>
            </button>
          ))}
        </div>

        <button class="arrowBtn arrowBtn--next" type="button" data-carousel-next>›</button>
      </div>

      <article class="eqDetail" data-detail-panel data-active-equipment={defaultItem.id}>
        <button class="detailX" type="button" data-close-detail aria-label="Cerrar detalle">×</button>
        <button class="dtArrow dtArrow--prev" type="button" data-detail-prev hidden>‹</button>
        <button class="dtArrow dtArrow--next" type="button" data-detail-next hidden>›</button>

        <div class="dtImg">
          <img data-detail-image src={defaultItem.image.src} alt={defaultItem.image.alt} loading="lazy" />
        </div>

        <div class="dtInfo">
          <p class="dtEyebrow" data-detail-eyebrow>{defaultItem.eyebrow}</p>
          <h3 class="dtTitle">
            <span data-detail-title>{defaultItem.title}</span>
            <span data-detail-subtitle>{defaultItem.subtitle}</span>
          </h3>
          <p class="dtDesc" data-detail-description>{defaultItem.description}</p>

          <dl class="dtSpecs">
            <div class="spec"><dt>Altura máxima</dt><dd data-detail-height>{defaultItem.specs.height}</dd></div>
            <div class="spec"><dt>Energía</dt><dd data-detail-power>{defaultItem.specs.power}</dd></div>
            <div class="spec"><dt>Capacidad</dt><dd data-detail-capacity>{defaultItem.specs.capacity}</dd></div>
            <div class="spec"><dt>Operación</dt><dd data-detail-operation>{defaultItem.specs.operation}</dd></div>
          </dl>

          <div class="dtActions">
            <a class="actPrimary" href={buildQuoteHref(defaultItem)} data-detail-quote>
              <span>{ctaLabel}</span><span aria-hidden="true">↘</span>
            </a>
            <a class="actSecondary" href={defaultItem.manualHref ?? "#"} download data-detail-manual>
              Descargar Manual
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector<HTMLElement>("[data-equipment-section]");
    if (!section || section.dataset.vmaEquipmentReady === "true") return;

    section.dataset.vmaEquipmentReady = "true";
    section.dataset.vmaCleanNativeCarousel = "true";

    const mainBtns = [...section.querySelectorAll<HTMLButtonElement>("[data-main-category]")];
    const subGroups = [...section.querySelectorAll<HTMLElement>("[data-sub-group]")];
    const subBtns = [...section.querySelectorAll<HTMLButtonElement>("[data-sub-category]")];
    const cards = [...section.querySelectorAll<HTMLButtonElement>("[data-machine-card]")];

    const detail = section.querySelector<HTMLElement>("[data-detail-panel]");
    const carousel = section.querySelector<HTMLElement>("[data-equipment-carousel]");
    const grid = section.querySelector<HTMLElement>("[data-equipment-grid]");

    const prevBtn = section.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const nextBtn = section.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const detailPrevBtn = section.querySelector<HTMLButtonElement>("[data-detail-prev]");
    const detailNextBtn = section.querySelector<HTMLButtonElement>("[data-detail-next]");
    const closeBtn = section.querySelector<HTMLButtonElement>("[data-close-detail]");

    const detailImage = section.querySelector<HTMLImageElement>("[data-detail-image]");
    const detailEyebrow = section.querySelector<HTMLElement>("[data-detail-eyebrow]");
    const detailTitle = section.querySelector<HTMLElement>("[data-detail-title]");
    const detailSubtitle = section.querySelector<HTMLElement>("[data-detail-subtitle]");
    const detailDescription = section.querySelector<HTMLElement>("[data-detail-description]");
    const detailHeight = section.querySelector<HTMLElement>("[data-detail-height]");
    const detailPower = section.querySelector<HTMLElement>("[data-detail-power]");
    const detailCapacity = section.querySelector<HTMLElement>("[data-detail-capacity]");
    const detailOperation = section.querySelector<HTMLElement>("[data-detail-operation]");
    const detailQuote = section.querySelector<HTMLAnchorElement>("[data-detail-quote]");
    const detailManual = section.querySelector<HTMLAnchorElement>("[data-detail-manual]");

    const isMobile = () => window.matchMedia("(max-width: 760px)").matches;

    let activeMainCategory = "tijera";
    let activeSubCategory = "tijera-diesel-4x4";
    let activeItemId: string | null = null;

    let pointerStartX = 0;
    let pointerStartY = 0;
    let pointerMoved = false;

    const activeSubByMain: Record<string, string> = {
      tijera: "tijera-diesel-4x4",
      "brazo-articulado": "brazo-articulado-diesel-4x4",
      "brazo-telescopico": "brazo-telescopico",
      unipersonal: "unipersonal",
      "manipulador-carga": "manipulador-carga",
    };

    function getCardsBySubCategory(subCategory: string) {
      return cards.filter((card) => card.dataset.subCategory === subCategory);
    }

    function getVisibleCards() {
      return cards.filter((card) => card.classList.contains("is-visible"));
    }

    function getSelectedCard() {
      return cards.find((card) => card.dataset.id === activeItemId);
    }

    function centerButton(button?: HTMLElement | null) {
      if (!button || !isMobile()) return;

      const scroller = button.closest<HTMLElement>(".catNav, .subNav");
      if (!scroller) return;

      window.requestAnimationFrame(() => {
        const buttonRect = button.getBoundingClientRect();
        const scrollerRect = scroller.getBoundingClientRect();
        const buttonCenter = buttonRect.left - scrollerRect.left + buttonRect.width / 2;
        const targetLeft = scroller.scrollLeft + buttonCenter - scrollerRect.width / 2;

        scroller.scrollTo({
          left: Math.max(0, targetLeft),
          behavior: "smooth",
        });
      });
    }

    function syncNavigation() {
      mainBtns.forEach((button) => {
        button.classList.toggle("is-active", button.dataset.mainCategory === activeMainCategory);
      });

      subGroups.forEach((group) => {
        group.classList.toggle("is-active", group.dataset.subGroup === activeMainCategory);
      });

      subBtns.forEach((button) => {
        const belongs = button.dataset.parentCategory === activeMainCategory;
        button.classList.toggle("is-visible", belongs);
        button.classList.toggle("is-active", belongs && button.dataset.subCategory === activeSubCategory);
      });

      centerButton(section?.querySelector<HTMLElement>("[data-main-category].is-active") ?? null);
centerButton(section?.querySelector<HTMLElement>("[data-sub-category].is-active") ?? null);
    }

    function syncCards() {
      const visibleCards = getCardsBySubCategory(activeSubCategory);
      const hasVisibleCards = visibleCards.length > 0;

      cards.forEach((card) => {
        const isVisible = card.dataset.subCategory === activeSubCategory;
        const isSelected = activeItemId !== null && card.dataset.id === activeItemId;

        card.classList.toggle("is-visible", isVisible);
        card.classList.toggle("is-selected", isVisible && isSelected);
      });

      carousel?.toggleAttribute("hidden", !hasVisibleCards);
      carousel?.classList.toggle("is-active", hasVisibleCards);
      grid?.classList.toggle("is-active", hasVisibleCards);
      grid?.classList.toggle("has-selection", activeItemId !== null);

      if (grid && isMobile()) {
        window.requestAnimationFrame(() => {
          grid.scrollLeft = 0;
        });
      }

      return visibleCards;
    }

    function syncDetailArrows() {
      const visibleCards = getVisibleCards();
      const canNavigate = visibleCards.length > 1;
      const open = activeItemId !== null;

      prevBtn?.toggleAttribute("hidden", !canNavigate || isMobile());
      nextBtn?.toggleAttribute("hidden", !canNavigate || isMobile());

      detailPrevBtn?.toggleAttribute("hidden", !open || !canNavigate || isMobile());
      detailNextBtn?.toggleAttribute("hidden", !open || !canNavigate || isMobile());
    }

    function lockMobileModal(open: boolean) {
      if (!isMobile()) {
        document.documentElement.classList.remove("vma-equipment-modal-open");
        document.body.classList.remove("vma-equipment-modal-open");
        return;
      }

      document.documentElement.classList.toggle("vma-equipment-modal-open", open);
      document.body.classList.toggle("vma-equipment-modal-open", open);
    }

    function fillDetail(card: HTMLButtonElement) {
      if (!detail) return;

      if (detailImage) {
        detailImage.src = card.dataset.imageSrc ?? "";
        detailImage.alt = card.dataset.imageAlt ?? "";
      }

      if (detailEyebrow) detailEyebrow.textContent = card.dataset.eyebrow ?? "";
      if (detailTitle) detailTitle.textContent = card.dataset.title ?? "";
      if (detailSubtitle) detailSubtitle.textContent = card.dataset.subtitle ?? "";
      if (detailDescription) detailDescription.textContent = card.dataset.description ?? "";
      if (detailHeight) detailHeight.textContent = card.dataset.height ?? "";
      if (detailPower) detailPower.textContent = card.dataset.power ?? "";
      if (detailCapacity) detailCapacity.textContent = card.dataset.capacity ?? "";
      if (detailOperation) detailOperation.textContent = card.dataset.operation ?? "";
      if (detailQuote) detailQuote.href = card.dataset.quoteHref ?? "#";

      if (detailManual) {
        const manualHref = card.dataset.manualHref ?? "";
        detailManual.href = manualHref || "#";
        detailManual.toggleAttribute("aria-disabled", !manualHref);
      }

      detail.dataset.activeEquipment = card.dataset.id ?? "";
      detail.classList.add("is-active");
      detail.setAttribute("aria-hidden", "false");
      lockMobileModal(true);
    }

    function openDetail(card: HTMLButtonElement, opts?: { scrollCard?: boolean }) {
      const mainCategory = card.dataset.mainCategory;
      const subCategory = card.dataset.subCategory;
      const itemId = card.dataset.id;

      if (!mainCategory || !subCategory || !itemId) return;

      activeMainCategory = mainCategory;
      activeSubCategory = subCategory;
      activeSubByMain[mainCategory] = subCategory;
      activeItemId = itemId;

      syncNavigation();
      syncCards();
      fillDetail(card);
      syncDetailArrows();

      if (opts?.scrollCard) {
        card.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
      }
    }

    function closeDetail() {
      activeItemId = null;
      detail?.classList.remove("is-active");
      detail?.setAttribute("aria-hidden", "true");

      cards.forEach((card) => card.classList.remove("is-selected"));
      grid?.classList.remove("has-selection");

      lockMobileModal(false);
      syncNavigation();
      syncCards();
      syncDetailArrows();
    }

    function openSubCategory(mainCategory: string, subCategory: string) {
      activeMainCategory = mainCategory;
      activeSubCategory = subCategory;
      activeSubByMain[mainCategory] = subCategory;
      activeItemId = null;

      detail?.classList.remove("is-active");
      detail?.setAttribute("aria-hidden", "true");
      lockMobileModal(false);

      syncNavigation();
      syncCards();
      syncDetailArrows();
    }

    function openMainCategory(mainCategory: string) {
      const button = mainBtns.find((btn) => btn.dataset.mainCategory === mainCategory);
      const fallbackSubCategory = button?.dataset.defaultSub ?? "";
      const subCategory = activeSubByMain[mainCategory] ?? fallbackSubCategory;

      if (!subCategory) return;
      openSubCategory(mainCategory, subCategory);
    }

    function selectRelativeCard(direction: "prev" | "next") {
      const visibleCards = getVisibleCards();
      if (!visibleCards.length) return;

      const selectedCard = getSelectedCard();
      const currentIndex = selectedCard ? visibleCards.indexOf(selectedCard) : -1;
      const nextIndex =
        direction === "next"
          ? (currentIndex + 1) % visibleCards.length
          : (currentIndex - 1 + visibleCards.length) % visibleCards.length;

      const nextCard = visibleCards[nextIndex];
      if (!nextCard) return;

      openDetail(nextCard, { scrollCard: true });
    }

    function scrollCarousel(direction: "prev" | "next") {
      if (!grid) return;

      const firstCard = getVisibleCards()[0];
      const cardWidth = firstCard?.offsetWidth ?? 240;
      const amount = (cardWidth + 18) * 2;

      grid.scrollBy({
        left: direction === "next" ? amount : -amount,
        behavior: "smooth",
      });
    }

    mainBtns.forEach((button) => {
      button.addEventListener("click", () => {
        const mainCategory = button.dataset.mainCategory;
        if (!mainCategory) return;

        openMainCategory(mainCategory);
        centerButton(button);
      });
    });

    subBtns.forEach((button) => {
      button.addEventListener("click", () => {
        const mainCategory = button.dataset.parentCategory;
        const subCategory = button.dataset.subCategory;

        if (!mainCategory || !subCategory) return;

        openSubCategory(mainCategory, subCategory);
        centerButton(button);
      });
    });

    if (grid) {
      grid.addEventListener(
        "pointerdown",
        (event) => {
          if (!isMobile()) return;
          pointerStartX = event.clientX;
          pointerStartY = event.clientY;
          pointerMoved = false;
        },
        { passive: true }
      );

      grid.addEventListener(
        "pointermove",
        (event) => {
          if (!isMobile()) return;

          const dx = Math.abs(event.clientX - pointerStartX);
          const dy = Math.abs(event.clientY - pointerStartY);

          if (dx > 10 || dy > 10) {
            pointerMoved = true;
          }
        },
        { passive: true }
      );
    }

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        if (isMobile() && pointerMoved) {
          pointerMoved = false;
          return;
        }

        openDetail(card);

        window.setTimeout(() => {
          pointerMoved = false;
        }, 80);
      });
    });

    prevBtn?.addEventListener("click", () => scrollCarousel("prev"));
    nextBtn?.addEventListener("click", () => scrollCarousel("next"));
    detailPrevBtn?.addEventListener("click", () => selectRelativeCard("prev"));
    detailNextBtn?.addEventListener("click", () => selectRelativeCard("next"));
    closeBtn?.addEventListener("click", () => closeDetail());

    detail?.addEventListener("click", (event) => {
      if (!isMobile()) return;
      if (event.target === detail) closeDetail();
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && detail?.classList.contains("is-active")) {
        closeDetail();
      }
    });

    window.addEventListener("resize", () => {
      syncDetailArrows();
      lockMobileModal(Boolean(detail?.classList.contains("is-active")));
    });

    openSubCategory("tijera", "tijera-diesel-4x4");
  });
</script>

