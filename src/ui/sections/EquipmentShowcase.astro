<script is:inline>
  (() => {
    const initVmaEquipmentDragCarousel = () => {
      const section =
        document.querySelector("[data-equipment-section]") ||
        document.querySelector("#equipos");

      if (!section) return;

      const grids = Array.from(
        section.querySelectorAll(".eqGrid, [data-equipment-grid]")
      );

      if (!grids.length) return;

      const isMobile = () => window.matchMedia("(max-width: 760px)").matches;

      grids.forEach((grid) => {
        if (grid.dataset.vmaDragCarouselFinal === "true") return;
        grid.dataset.vmaDragCarouselFinal = "true";

        let pointerId = null;
        let isDragging = false;
        let startX = 0;
        let startScrollLeft = 0;
        let moved = false;

        const prepareGrid = () => {
          if (!isMobile()) return;

          grid.style.display = "flex";
          grid.style.flexDirection = "row";
          grid.style.flexWrap = "nowrap";
          grid.style.overflowX = "auto";
          grid.style.overflowY = "hidden";
          grid.style.webkitOverflowScrolling = "touch";
          grid.style.touchAction = "pan-y";

          const visibleCards = Array.from(grid.querySelectorAll(".card.is-visible"));

          visibleCards.forEach((card) => {
            card.style.flex = "0 0 min(78vw, 310px)";
            card.style.width = "min(78vw, 310px)";
            card.style.minWidth = "min(78vw, 310px)";
            card.style.maxWidth = "min(78vw, 310px)";
          });
        };

        const onPointerDown = (event) => {
          if (!isMobile()) return;
          if (event.button !== undefined && event.button !== 0) return;

          prepareGrid();

          pointerId = event.pointerId;
          isDragging = true;
          moved = false;
          startX = event.clientX;
          startScrollLeft = grid.scrollLeft;

          grid.classList.add("is-vma-dragging");

          try {
            grid.setPointerCapture(pointerId);
          } catch (_) {}
        };

        const onPointerMove = (event) => {
          if (!isMobile()) return;
          if (!isDragging) return;
          if (pointerId !== null && event.pointerId !== pointerId) return;

          const deltaX = event.clientX - startX;

          if (Math.abs(deltaX) > 3) {
            moved = true;
            grid.scrollLeft = startScrollLeft - deltaX;
            event.preventDefault();
          }
        };

        const onPointerUp = (event) => {
          if (!isMobile()) return;

          if (pointerId !== null) {
            try {
              grid.releasePointerCapture(pointerId);
            } catch (_) {}
          }

          pointerId = null;
          isDragging = false;
          grid.classList.remove("is-vma-dragging");

          window.setTimeout(() => {
            moved = false;
          }, 120);
        };

        grid.addEventListener("pointerdown", onPointerDown, { passive: true });
        grid.addEventListener("pointermove", onPointerMove, { passive: false });
        grid.addEventListener("pointerup", onPointerUp, { passive: true });
        grid.addEventListener("pointercancel", onPointerUp, { passive: true });
        grid.addEventListener("pointerleave", onPointerUp, { passive: true });

        grid.addEventListener(
          "click",
          (event) => {
            if (!moved) return;
            event.preventDefault();
            event.stopPropagation();
          },
          true
        );

        prepareGrid();

        const observer = new MutationObserver(() => {
          prepareGrid();
        });

        observer.observe(grid, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ["class", "style"],
        });
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initVmaEquipmentDragCarousel);
    } else {
      initVmaEquipmentDragCarousel();
    }

    window.addEventListener("resize", initVmaEquipmentDragCarousel);
  })();
</script>

