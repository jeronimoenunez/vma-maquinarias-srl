---
type CardData = {
  kicker: string;
  title: string;
  subtitle: string;
  href: string;
  images: string[];
  autoplay?: boolean;
};

type Props = {
  kicker?: string;
  title?: string;
  cards?: CardData[];
};

const fallbackCards: CardData[] = [
  {
    kicker: "UNIDADES DE NEGOCIO",
    title: "Alquiler, venta de equipos y servicio técnico.",
    subtitle:
      "Tres líneas de trabajo para resolver disponibilidad, inversión y continuidad operativa.",
    href: "/unidades",
    images: [
      "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1600&auto=format&fit=crop&q=80",
      "https://images.unsplash.com/photo-1581094288338-2314dddb7ece?w=1600&auto=format&fit=crop&q=80",
      "https://images.unsplash.com/photo-1581092446327-9b52bd1570c2?w=1600&auto=format&fit=crop&q=80",
    ],
    autoplay: true,
  },
  {
    kicker: "MÉTODO VMA",
    title: "Lo que nos hace diferentes.",
    subtitle:
      "Análisis, asesoramiento comprometido y proyección 360° antes de mover un equipo.",
    href: "/metodo",
    images: [
      "https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=1600&auto=format&fit=crop&q=80",
    ],
    autoplay: false,
  },
];

const {
  kicker = "SISTEMA VMA",
  title = "Dos formas de entender cómo resolvemos una operación.",
  cards,
} = Astro.props as Partial<Props>;

const safeCards = Array.isArray(cards) && cards.length ? cards : fallbackCards;
---

<section id="negocio" class="businessSection" data-business-cards>
  <div class="businessShell">
    <div class="businessRule" aria-hidden="true"></div>

    <header class="businessHeader">
      <p class="businessKicker">{kicker}</p>
      <h2 class="businessTitle">{title}</h2>
    </header>

    <div class="businessGrid">
      {
        safeCards.map((card, cardIndex) => (
          <a
            href={card.href}
            class={`businessCard ${card.autoplay ? "businessCard--carousel" : ""}`}
            data-business-card={cardIndex}
            aria-label={`Ver ${card.title}`}
          >
            <div class="businessImageFrame">
              <div class="businessImageStack">
                {card.images.map((src, imageIndex) => (
                  <img
                    class={`businessImage ${imageIndex === 0 ? "isActive" : ""}`}
                    src={src}
                    alt=""
                    loading={imageIndex === 0 ? "eager" : "lazy"}
                    decoding="async"
                    data-business-slide
                  />
                ))}
              </div>

              <div class="businessOverlay" aria-hidden="true"></div>
            </div>

            <div class="businessMeta">
              <span>{card.kicker}</span>
            </div>

            <div class="businessText">
              <span class="businessArrow" aria-hidden="true">↘</span>
              <h3>{card.title}</h3>
              <p>{card.subtitle}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const bindBusinessCards = () => {
      const cards = document.querySelectorAll(".businessCard--carousel");

      cards.forEach((card) => {
        const slides = [...card.querySelectorAll("[data-business-slide]")];
        if (slides.length <= 1) return;

        let index = 0;

        window.setInterval(() => {
          slides[index].classList.remove("isActive");
          index = (index + 1) % slides.length;
          slides[index].classList.add("isActive");
        }, 3600);
      });
    };

    bindBusinessCards();
    document.addEventListener("DOMContentLoaded", bindBusinessCards, { once: true });
  })();
</script>

<style>
  .businessSection {
    background: #050505;
    color: #ffffff;
    padding:
      clamp(58px, 6vw, 92px)
      clamp(30px, 4vw, 76px)
      clamp(76px, 8vw, 120px);
  }

  .businessShell {
    width: 100%;
  }

  .businessRule {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.76);
    margin-bottom: clamp(38px, 4vw, 64px);
  }

  .businessHeader {
    display: grid;
    grid-template-columns: minmax(220px, 0.36fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 86px);
    align-items: start;
    margin-bottom: clamp(38px, 4.8vw, 74px);
  }

  .businessKicker {
    margin: 0;
    color: #ffc400;
    font-family: var(--font-body);
    font-size: clamp(1.02rem, 1.16vw, 1.36rem);
    font-weight: 400;
    text-transform: none;
  }

  .businessTitle {
    margin: 0;
    max-width: 100%;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: clamp(2.6rem, 4.65vw, 6.15rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.068em;
    text-wrap: balance;
  }

  .businessGrid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 3vw, 44px);
  }

  .businessCard {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
    min-height: clamp(570px, 68svh, 760px);
    color: #ffffff;
    text-decoration: none;
    opacity: 1;
    filter: none;
    transition:
      opacity 0.35s ease,
      filter 0.35s ease,
      transform 0.35s ease;
  }

  .businessImageFrame {
    position: relative;
    aspect-ratio: 16 / 9.6;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: clamp(18px, 1.6vw, 28px);
    background: #121212;
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.35s ease;
  }

  .businessImageStack {
    position: absolute;
    inset: 0;
  }

  .businessImage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.035);
    filter: saturate(0.92) contrast(0.98);
    transition:
      opacity 0.9s ease,
      transform 7s ease,
      filter 0.35s ease;
  }

  .businessImage.isActive {
    opacity: 1;
    transform: scale(1);
  }

  .businessOverlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.04) 0%,
        rgba(0, 0, 0, 0.04) 46%,
        rgba(0, 0, 0, 0.26) 100%
      );
    pointer-events: none;
    transition: background 0.35s ease;
  }

  .businessMeta {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 44px;
    padding: 0 18px;
    margin-top: clamp(20px, 2vw, 28px);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.88);
    font-family: var(--font-body);
    font-size: clamp(0.86rem, 0.95vw, 1rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease;
  }

  .businessText {
    position: relative;
    padding-top: clamp(22px, 2.2vw, 34px);
    padding-right: clamp(30px, 4vw, 80px);
    font-family: var(--font-body);
  }

  .businessText h3 {
    margin: 0;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: clamp(2.35rem, 3.6vw, 5rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.066em;
    text-wrap: balance;
    transition: color 0.3s ease;
  }

  .businessText p {
    max-width: 60ch;
    margin: clamp(14px, 1.4vw, 22px) 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-family: var(--font-body);
    font-size: clamp(0.96rem, 1vw, 1.08rem);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.018em;
    transition: color 0.3s ease;
  }

  .businessArrow {
    position: absolute;
    top: clamp(28px, 2.4vw, 42px);
    right: 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: clamp(1.6rem, 2vw, 2.35rem);
    line-height: 1;
    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  /* Hover activo */
  .businessCard:hover {
    transform: translateY(-4px);
  }

  .businessCard:hover .businessImageFrame {
    border-color: #ffc400;
    box-shadow:
      0 0 0 1px rgba(255, 196, 0, 0.45),
      0 26px 78px rgba(255, 196, 0, 0.12);
  }

  .businessCard:hover .businessImage.isActive {
    transform: scale(1.035);
    filter: saturate(1.05) contrast(1.02);
  }

  .businessCard:hover .businessOverlay {
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.02) 0%,
        rgba(0, 0, 0, 0.03) 46%,
        rgba(0, 0, 0, 0.18) 100%
      );
  }

  .businessCard:hover .businessMeta {
    color: #ffc400;
    border-color: rgba(255, 196, 0, 0.82);
    background: rgba(255, 196, 0, 0.08);
  }

  .businessCard:hover .businessText p {
    color: #ffc400;
  }

  .businessCard:hover .businessArrow {
    color: #ffc400;
    transform: translate(5px, 5px);
  }

  /* Card no enfocada cuando otra está en hover */
  .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) {
    opacity: 0.52;
    filter: grayscale(1);
  }

  .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessImage {
    filter: grayscale(1) saturate(0) contrast(0.92) brightness(0.72);
  }

  .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessMeta {
    color: rgba(255, 255, 255, 0.34);
    border-color: rgba(255, 255, 255, 0.22);
    background: transparent;
  }

  .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessText h3 {
    color: rgba(255, 255, 255, 0.42);
  }

  .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessText p {
    color: rgba(255, 255, 255, 0.28);
  }

  .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessArrow {
    color: rgba(255, 255, 255, 0.24);
  }

  @media (max-width: 980px) {
    .businessHeader,
    .businessGrid {
      grid-template-columns: 1fr;
    }

    .businessTitle {
      max-width: 14ch;
    }

    .businessCard {
      min-height: auto;
    }

    .businessImageFrame {
      aspect-ratio: 16 / 10;
    }

    .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) {
      opacity: 1;
      filter: none;
    }

    .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessImage {
      filter: saturate(0.92) contrast(0.98);
    }

    .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessMeta {
      color: rgba(255, 255, 255, 0.88);
      border-color: rgba(255, 255, 255, 0.55);
    }

    .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessText h3 {
      color: #ffffff;
    }

    .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessText p {
      color: rgba(255, 255, 255, 0.72);
    }
  }

  @media (max-width: 640px) {
    .businessSection {
      padding: 56px 22px 76px;
    }

    .businessImageFrame {
      aspect-ratio: 4 / 3;
      border-radius: 24px;
    }

    .businessText {
      padding-right: 0;
    }

    .businessText h3 {
      font-size: clamp(2rem, 10vw, 3.45rem);
    }

    .businessArrow {
      position: static;
      display: block;
      margin-bottom: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .businessCard,
    .businessImage,
    .businessImageFrame,
    .businessMeta,
    .businessText h3,
    .businessText p,
    .businessArrow {
      transition: none;
    }
  }
</style>