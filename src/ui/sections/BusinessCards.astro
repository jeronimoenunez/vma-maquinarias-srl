---
type CardData = {
  kicker: string;
  title: string;
  subtitle: string;
  href: string;
  images: string[];
  autoplay?: boolean;
  variant?: "image" | "logo";
};

type Props = {
  kicker?: string;
  title?: string;
  cards?: CardData[];
};

const fallbackCards: CardData[] = [
  {
    kicker: "UNIDADES DE NEGOCIO",
    title: "Alquiler, venta de equipos y servicio técnico.",
    subtitle:
      "Tres líneas de trabajo para resolver disponibilidad, inversión y continuidad operativa.",
    href: "#contacto",
    images: [
      "/images/IMG_20250703_094445389_HDR.jpg",
      "/images/vma-version-b/banner-hs18e.png",
      "/images/Star-6.png",
    ],
    autoplay: true,
    variant: "image",
  },
  {
    kicker: "MÉTODO VMA",
    title: "Lo que nos hace diferentes.",
    subtitle:
      "Análisis, asesoramiento comprometido y proyección 360° antes de mover un equipo.",
    href: "#contacto",
    images: [],
    autoplay: false,
    variant: "logo",
  },
];

const {
  kicker = "SISTEMA VMA",
  title = "Dos formas de entender cómo resolvemos una operación.",
  cards,
} = Astro.props as Partial<Props>;

const safeCards = Array.isArray(cards) && cards.length ? cards : fallbackCards;
---

<section id="negocio" class="businessSection" data-business-cards>
  <div class="businessShell">
    <!-- <header class="businessHeader">
      <p class="businessKicker">{kicker}</p>
      <h2 class="businessTitle">{title}</h2>
    </header> -->

    <div class="businessGrid">
      {
        safeCards.map((card, cardIndex) => (
          <a
            href={card.href}
            class={`businessCard ${card.autoplay ? "businessCard--carousel" : ""}`}
            data-business-card={cardIndex}
            aria-label={`Ver ${card.title}`}
          >
            <div class="businessImageFrame">
              {
                card.variant === "logo" ? (
                  <div class="businessLogoFrame" aria-hidden="true">
                    <span class="businessLogoMark">M</span>
                  </div>
                ) : (
                  <div class="businessImageStack">
                    {card.images.map((src, imageIndex) => (
                      <img
                        class={`businessImage ${imageIndex === 0 ? "isActive" : ""}`}
                        src={src}
                        alt=""
                        loading={imageIndex === 0 ? "eager" : "lazy"}
                        decoding="async"
                        data-business-slide
                      />
                    ))}
                  </div>
                )
              }

              <div class="businessOverlay" aria-hidden="true"></div>
            </div>

            <div class="businessMeta">
              <span>{card.kicker}</span>
            </div>

            <div class="businessText">
              <span class="businessArrow" aria-hidden="true">↘</span>
              <h3>{card.title}</h3>
              <p>{card.subtitle}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const initBusinessCards = () => {
      const cards = document.querySelectorAll(".businessCard--carousel");

      cards.forEach((card) => {
        if (card.dataset.carouselReady === "true") return;
        card.dataset.carouselReady = "true";

        const slides = [...card.querySelectorAll("[data-business-slide]")];
        if (slides.length <= 1) return;

        let index = 0;

        window.setInterval(() => {
          slides[index].classList.remove("isActive");
          index = (index + 1) % slides.length;
          slides[index].classList.add("isActive");
        }, 3600);
      });
    };

    initBusinessCards();
    document.addEventListener("DOMContentLoaded", initBusinessCards, { once: true });
  })();
</script>

<style>
  .businessSection {
    position: relative;
    z-index: 2;
    width: 100%;
    background: #030303;
    color: #ffffff;
    overflow: hidden;
    border-radius: clamp(24px, 3vw, 44px) clamp(24px, 3vw, 44px) 0 0;
    margin-top: clamp(-22px, -2vw, -8px);
  }

  .businessShell {
    /* width: min(100%, 1440px); */
    margin: 0 auto;
    padding:
      clamp(58px, 6vw, 92px)
      clamp(28px, 4.8vw, 86px)
      clamp(54px, 5.6vw, 86px);
  }

  .businessHeader {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) minmax(0, 1fr);
    gap: clamp(26px, 5vw, 82px);
    align-items: start;
    margin-bottom: clamp(34px, 4.4vw, 66px);
  }

  .businessKicker {
    margin: 0;
    color: #ffc400;
    font-family: var(--font-body);
    font-size: clamp(0.76rem, 0.8vw, 0.94rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .businessTitle {
    margin: 0;
    max-width: 13ch;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: clamp(3.1rem, 5.25vw, 6.2rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.074em;
    text-wrap: balance;
  }

  .businessGrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 42px);
    align-items: start;
  }

  .businessCard {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto;
    min-width: 0;
    color: #ffffff;
    text-decoration: none;
    transition:
      opacity 240ms ease,
      filter 240ms ease,
      transform 240ms ease;
  }

  .businessImageFrame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9.15;
    overflow: hidden;
    border-radius: clamp(18px, 1.7vw, 28px);
    background: #d9d9d9;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      border-color 240ms ease,
      box-shadow 240ms ease,
      transform 240ms ease;
  }

  .businessImageStack {
    position: absolute;
    inset: 0;
  }

  .businessImage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.025);
    filter: saturate(0.92) contrast(1.02);
    transition:
      opacity 800ms ease,
      transform 6200ms ease,
      filter 240ms ease;
  }

  .businessImage.isActive {
    opacity: 1;
    transform: scale(1);
  }

  .businessLogoFrame {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 50% 4%, rgba(255, 255, 255, 0.96), rgba(228, 228, 228, 0.94) 48%, rgba(196, 196, 196, 0.94) 100%);
  }

  .businessLogoMark {
    color: #000000;
    font-family: var(--font-body);
    font-size: clamp(8rem, 16vw, 17rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.14em;
    transform: scaleX(1.16);
  }

  .businessOverlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.03) 0%,
        rgba(0, 0, 0, 0.04) 48%,
        rgba(0, 0, 0, 0.22) 100%
      );
    pointer-events: none;
  }

  .businessMeta {
    width: fit-content;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: clamp(16px, 1.7vw, 22px);
    padding: 0 16px;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 9px;
    background: rgba(5, 5, 5, 0.48);
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--font-body);
    font-size: clamp(0.68rem, 0.72vw, 0.82rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      color 220ms ease,
      border-color 220ms ease,
      background 220ms ease;
  }

  .businessText {
    position: relative;
    min-height: clamp(150px, 12vw, 210px);
    padding-top: clamp(20px, 2vw, 30px);
    padding-right: clamp(32px, 4vw, 72px);
    font-family: var(--font-body);
  }

  .businessText h3 {
    margin: 0;
    max-width: 15ch;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: clamp(2.2rem, 3.35vw, 4.5rem);
    font-weight: 400;
    line-height: 0.99;
    letter-spacing: -0.07em;
    text-wrap: balance;
    transition: color 220ms ease;
  }

  .businessText p {
    max-width: 54ch;
    margin: clamp(12px, 1.2vw, 18px) 0 0;
    color: rgba(255, 255, 255, 0.66);
    font-family: var(--font-body);
    font-size: clamp(0.8rem, 0.84vw, 0.95rem);
    font-weight: 400;
    line-height: 1.42;
    letter-spacing: -0.018em;
    transition: color 220ms ease;
  }

  .businessArrow {
    position: absolute;
    top: clamp(24px, 2.3vw, 38px);
    right: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: clamp(1.45rem, 1.8vw, 2.1rem);
    line-height: 1;
    transition:
      color 220ms ease,
      transform 220ms ease;
  }

  .businessCard:hover {
    transform: translateY(-3px);
  }

  .businessCard:hover .businessImageFrame {
    border-color: rgba(255, 196, 0, 0.88);
    box-shadow:
      0 0 0 1px rgba(255, 196, 0, 0.28),
      0 24px 70px rgba(255, 196, 0, 0.09);
  }

  .businessCard:hover .businessImage.isActive {
    transform: scale(1.035);
    filter: saturate(1.04) contrast(1.04);
  }

  .businessCard:hover .businessMeta {
    color: #ffc400;
    border-color: rgba(255, 196, 0, 0.82);
    background: rgba(255, 196, 0, 0.08);
  }

  .businessCard:hover .businessText p,
  .businessCard:hover .businessArrow {
    color: #ffc400;
  }

  .businessCard:hover .businessArrow {
    transform: translate(4px, 4px);
  }

  @supports selector(:has(*)) {
    .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) {
      opacity: 0.52;
      filter: grayscale(1);
    }

    .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessImage {
      filter: grayscale(1) saturate(0) contrast(0.9) brightness(0.76);
    }

    .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessText h3 {
      color: rgba(255, 255, 255, 0.42);
    }

    .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessText p,
    .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessArrow {
      color: rgba(255, 255, 255, 0.28);
    }
  }

  @media (max-width: 1080px) {
    .businessShell {
      padding:
        clamp(50px, 7vw, 74px)
        24px
        clamp(50px, 7vw, 74px);
    }

    .businessHeader {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 30px;
    }

    .businessTitle {
      max-width: 13ch;
      font-size: clamp(2.6rem, 8vw, 5rem);
    }

    .businessGrid {
      gap: 22px;
    }
  }

  @media (max-width: 760px) {
    .businessSection {
      border-radius: 26px 26px 0 0;
      margin-top: -10px;
    }

    .businessShell {
      padding: 42px 14px 50px;
    }

    .businessHeader {
      text-align: left;
      margin-bottom: 24px;
    }

    .businessKicker {
      font-size: 0.68rem;
      letter-spacing: 0.12em;
    }

    .businessTitle {
      max-width: 12.5ch;
      font-size: clamp(2.05rem, 9.6vw, 3rem);
      line-height: 1;
      letter-spacing: -0.06em;
    }

    .businessGrid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .businessImageFrame {
      aspect-ratio: 16 / 10.8;
      border-radius: 22px;
    }

    .businessLogoMark {
      font-size: clamp(7rem, 35vw, 10rem);
    }

    .businessMeta {
      min-height: 34px;
      margin-top: 14px;
      padding: 0 13px;
      font-size: 0.62rem;
    }

    .businessText {
      min-height: auto;
      padding-top: 16px;
      padding-right: 30px;
    }

    .businessText h3 {
      max-width: 13ch;
      font-size: clamp(1.75rem, 8.6vw, 2.55rem);
      line-height: 1;
    }

    .businessText p {
      max-width: 33ch;
      font-size: 0.78rem;
    }

    .businessArrow {
      top: 18px;
      font-size: 1.4rem;
    }

    @supports selector(:has(*)) {
      .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) {
        opacity: 1;
        filter: none;
      }

      .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessImage {
        filter: saturate(0.92) contrast(1.02);
      }

      .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessText h3 {
        color: #ffffff;
      }

      .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessText p,
      .businessGrid:has(.businessCard:hover) .businessCard:not(:hover) .businessArrow {
        color: rgba(255, 255, 255, 0.66);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .businessCard,
    .businessImage,
    .businessImageFrame,
    .businessMeta,
    .businessText h3,
    .businessText p,
    .businessArrow {
      transition: none;
    }
  }
</style>
