---
type Props = {
  kicker?: string;
  title?: string;
  titleAccent?: string;
  subtitle?: string;
  whatsappHref?: string;
  emailComercial?: string;
  whatsappLabel?: string;
  cobertura?: string;
};

const {
  kicker = "CONTACTO",
  title = "Respuesta inmediata.",
  titleAccent = "Cotización online.",
  subtitle =
    "Completá tus datos y te respondemos con una cotización. Para consultas urgentes, escribinos directo por WhatsApp.",
  whatsappHref = "#",
  emailComercial = "comercial@vmarental.com.ar",
  whatsappLabel = "[PENDIENTE]",
  cobertura = "Cobertura donde esté tu planta o tu obra",
} = Astro.props as Props;
---

<div class="contactSection">
  <div class="contactInner">
    <!-- <header class="contactHeader">
      <p class="contactKicker">{kicker}</p>
      <h2 class="contactTitle">
        {title}<br />
        <span class="contactTitleAccent">{titleAccent}</span>
      </h2>

      <div class="contactStats">
        <div class="contactStat">
          <p class="contactStatLabel">Respuesta</p>
          <p class="contactStatValue">Inmediata</p>
        </div>
        <div class="contactStat">
          <p class="contactStatLabel">Cotización</p>
          <p class="contactStatValue">Online, sin compromiso</p>
        </div>
        <div class="contactStat">
          <p class="contactStatLabel">Cobertura</p>
          <p class="contactStatValue">{cobertura}</p>
        </div>
      </div>
    </header> -->

    <!-- <div class="contactDivider" aria-hidden="true"></div> -->

    <div class="contactGrid">
      <aside class="contactInfo">
        <h3 class="contactInfoTitle">Contactanos.</h3>
        <p class="contactInfoText">{subtitle}</p>

        <dl class="contactDetails">
          <div class="contactDetail">
            <dt>Email comercial</dt>
            <dd>
              <a href={`mailto:${emailComercial}`}>{emailComercial}</a>
            </dd>
          </div>
          <div class="contactDetail">
            <dt>WhatsApp</dt>
            <dd>{whatsappLabel}</dd>
          </div>
        </dl>
      </aside>

      <form class="contactForm" action={whatsappHref} method="GET">
        <div class="formRow formRow--2">
          <label class="formField">
            <span class="formLabel">Nombre *</span>
            <input
              class="formInput"
              name="nombre"
              autocomplete="given-name"
              required
            />
          </label>
          <label class="formField">
            <span class="formLabel">Apellido *</span>
            <input
              class="formInput"
              name="apellido"
              autocomplete="family-name"
              required
            />
          </label>
        </div>

        <label class="formField">
          <span class="formLabel">Empresa</span>
          <input
            class="formInput"
            name="empresa"
            autocomplete="organization"
          />
        </label>

        <div class="formRow formRow--2">
          <label class="formField">
            <span class="formLabel">Email *</span>
            <input
              class="formInput"
              type="email"
              name="email"
              autocomplete="email"
              required
            />
          </label>
          <label class="formField">
            <span class="formLabel">Teléfono *</span>
            <input
              class="formInput"
              type="tel"
              name="telefono"
              autocomplete="tel"
              required
            />
          </label>
        </div>

        <label class="formField">
          <span class="formLabel">Tipo de consulta</span>
          <select class="formInput formSelect" name="tipoConsulta">
            <option value="alquiler">Alquiler</option>
            <option value="venta">Venta</option>
            <option value="soporte">Soporte técnico</option>
          </select>
        </label>

        <label class="formField">
          <span class="formLabel">Mensaje</span>
          <textarea
            class="formInput formTextarea"
            name="mensaje"
            rows="4"
            placeholder="Contanos altura de trabajo, zona, fecha estimada y duración del proyecto"
          ></textarea>
        </label>

        <div class="formActions">
          <button class="formBtn formBtn--primary" type="submit">
            Enviar consulta
          </button>
          <a class="formBtn formBtn--ghost" href={whatsappHref}>
            <span>Cotizar por WhatsApp</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  .contactSection {
    background-color: #070707;
    width: 100%;
    padding: 120px 80px;
    box-sizing: border-box;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .contactInner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  .contactHeader {
    margin-bottom: 80px;
  }

  .contactKicker {
    color: #6b6b6b;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 32px 0;
  }

  .contactTitle {
    color: #ffffff;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 48px 0;
    max-width: 18ch;
  }

  .contactTitleAccent {
    color: #ffc400;
    font-style: italic;
    font-weight: 300;
  }

  .contactStats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .contactStat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contactStatLabel {
    color: #6b6b6b;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0;
  }

  .contactStatValue {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 400;
    margin: 0;
  }

  .contactDivider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: 80px 0;
  }

  .contactGrid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 80px;
    align-items: start;
  }

  .contactInfo {
    position: sticky;
    top: 100px;
  }

  .contactInfoTitle {
    font-family: var(--font-body);
    color: #ffc400;
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 24px 0;
  }

  .contactInfoText {
    font-family: var(--font-body);
    color: #c9c9c9;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 40px 0;
    max-width: 42ch;
  }

  .contactDetails {
    font-family: var(--font-body);
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0;
  }

  .contactDetail {
    font-family: var(--font-body);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contactDetail dt {
    font-family: var(--font-body);
    color: #6b6b6b;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .contactDetail dd {
    font-family: var(--font-body);
    color: #ffffff;
    font-size: 0.95rem;
    margin: 0;
  }

  .contactDetail dd a {
    font-family: var(--font-body);
    color: #ffc400;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contactDetail dd a:hover {
    color: #ffffff;
  }

  .contactForm {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .formRow {
    display: grid;
    gap: 24px;
  }

  .formRow--2 {
    grid-template-columns: 1fr 1fr;
  }

  .formField {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .formLabel {
    font-family: var(--font-body);
    color: #6b6b6b;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .formInput {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    padding: 12px 0;
    font-size: 1rem;
    font-family: var(--font-body);
    transition: border-color 0.3s ease;
    border-radius: 0;
    outline: none;
  }

  .formInput:focus {
    border-bottom-color: #ffc400;
  }

  .formInput::placeholder {
    color: #6b6b6b;
  }

  .formSelect {
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8' fill='none'%3e%3cpath d='M1 1L6 6L11 1' stroke='%23ffc400' stroke-width='1.5'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 4px center;
    padding-right: 24px;
  }

  .formSelect option {
    background: #070707;
    color: #ffffff;
  }

  .formTextarea {
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 16px;
    resize: vertical;
    min-height: 120px;
    font-family: inherit;
    line-height: 1.6;
  }

  .formTextarea:focus {
    border-color: #ffc400;
  }

  .formActions {
    display: flex;
    gap: 16px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .formBtn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s ease;
    font-family: var(--font-body);
  }

  .formBtn--primary {
    background: #ffc400;
    color: #070707;
  }

  .formBtn--primary:hover {
    background: #ffffff;
  }

  .formBtn--ghost {
    background: transparent;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .formBtn--ghost:hover {
    border-color: #ffc400;
    color: #ffc400;
    gap: 16px;
  }

  @media (max-width: 1024px) {
    .contactSection {
      padding: 80px 32px;
    }

    .contactGrid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .contactInfo {
      position: static;
    }

    .contactStats {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .contactSection {
      padding: 60px 24px;
    }

    .contactHeader {
      margin-bottom: 60px;
    }

    .contactDivider {
      margin: 60px 0;
    }

    .formRow--2 {
      grid-template-columns: 1fr;
    }

    .formActions {
      flex-direction: column;
    }

    .formBtn {
      justify-content: center;
      width: 100%;
    }
  }
</style>