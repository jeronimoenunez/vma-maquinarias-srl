---
type Props = {
  kicker?: string;
  title?: string;
  titleAccent?: string;
  subtitle?: string;
  whatsappHref?: string;
  emailComercial?: string;
  whatsappLabel?: string;
  cobertura?: string;
};

const {
  kicker = "CONTACTO",
  title = "Respuesta inmediata.",
  titleAccent = "Cotización online.",
  subtitle =
    "Completá tus datos y te respondemos con una cotización. Para consultas urgentes, escribinos directo por WhatsApp.",
  whatsappHref = "#",
  emailComercial = "comercial@vmarental.com.ar",
  whatsappLabel = "[PENDIENTE]",
  cobertura = "Cobertura donde esté tu planta o tu obra",
} = Astro.props as Props;

const contactApiUrl =
  import.meta.env.PUBLIC_VMA_CONTACT_API_URL ||
  "https://agente.vantorastudio.com/api/vma/contact";
---

<div class="contactSection">
  <div class="contactInner">

    <div class="contactGrid">
      <aside class="contactInfo">
        <h3 class="contactInfoTitle">Contactanos.</h3>
        <p class="contactInfoText">{subtitle}</p>

        <dl class="contactDetails">
          <div class="contactDetail">
            <dt>Email comercial</dt>
            <dd>
              <a class="contactDetailLink" href={`mailto:${emailComercial}`}>{emailComercial}</a>
            </dd>
          </div>
          <div class="contactDetail">
            <dt>WhatsApp</dt>
            <dd>
              <a class="contactDetailLink" href={whatsappHref} target="_blank" rel="noopener noreferrer">{whatsappLabel}</a>
            </dd>
          </div>
        </dl>
      </aside>

      <form class="contactForm" data-vma-contact-form data-whatsapp-href={whatsappHref}>
        <div class="vmaHoneypot" aria-hidden="true">
          <input
            id="website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
            aria-label="Website"
          />
        </div>
        <div class="formRow formRow--2">
          <label class="formField">
            <span class="formLabel">Nombre *</span>
            <input
              class="formInput"
              name="nombre"
              autocomplete="given-name"
              required
            />
          </label>
          <label class="formField">
            <span class="formLabel">Apellido *</span>
            <input
              class="formInput"
              name="apellido"
              autocomplete="family-name"
              required
            />
          </label>
        </div>

        <label class="formField">
          <span class="formLabel">Empresa</span>
          <input
            class="formInput"
            name="empresa"
            autocomplete="organization"
          />
        </label>

        <div class="formRow formRow--2">
          <label class="formField">
            <span class="formLabel">Email *</span>
            <input
              class="formInput"
              type="email"
              name="email"
              autocomplete="email"
              required
            />
          </label>
          <label class="formField">
            <span class="formLabel">Teléfono *</span>
            <input
              class="formInput"
              type="tel"
              name="telefono"
              autocomplete="tel"
              required
            />
          </label>
        </div>

        <label class="formField">
          <span class="formLabel">Tipo de consulta</span>
          <select class="formInput formSelect" name="tipoConsulta">
            <option value="alquiler">Alquiler</option>
            <option value="venta">Venta</option>
            <option value="soporte">Soporte técnico</option>
          </select>
        </label>

        <label class="formField">
          <span class="formLabel">Mensaje</span>
          <textarea
            class="formInput formTextarea"
            name="mensaje"
            rows="4"
            placeholder="Contanos altura de trabajo, zona, fecha estimada y duración del proyecto"
          ></textarea>
        </label>

        <div class="formActions">
          <button class="formBtn formBtn--primary" type="submit">
            Enviar consulta
          </button>
          <a class="formBtn formBtn--ghost" href={whatsappHref}>
            <span>Cotizar por WhatsApp</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="contactFormStatus" data-vma-contact-status aria-live="polite"></div>
      </form>
    </div>
  </div>
</div>


<script define:vars={{ contactApiUrl }}>
  const form = document.querySelector("[data-vma-contact-form]");
  const status = document.querySelector("[data-vma-contact-status]");

  const escapeHtml = (value) =>
    String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  const normalizeFirstName = (value) => {
    const clean = String(value || "").trim();
    if (!clean) return "ahí";
    return clean.split(/\s+/)[0];
  };

  const labelTipoConsulta = (value) => {
    const map = {
      alquiler: "Alquiler de equipos",
      venta: "Venta de equipos",
      soporte: "Soporte técnico",
    };

    return map[value] || value || "Consulta comercial";
  };

  const buildAdvisorHref = (baseHref, payload) => {
    const lines = [
      "Hola VMA Rental, acabo de completar el formulario web.",
      "",
      `Nombre: ${payload.nombre} ${payload.apellido}`,
      payload.empresa ? `Empresa: ${payload.empresa}` : "",
      `Email: ${payload.email}`,
      `Teléfono: ${payload.telefono}`,
      `Tipo de consulta: ${labelTipoConsulta(payload.tipoConsulta)}`,
      payload.mensaje ? `Mensaje: ${payload.mensaje}` : "",
      "",
      "Quedo atento para avanzar con un asesor.",
    ].filter(Boolean);

    const encoded = encodeURIComponent(lines.join("\n"));
    const href = baseHref || "https://wa.me/541128421008";

    if (href.includes("wa.me/") || href.includes("api.whatsapp.com/send")) {
      return `${href}${href.includes("?") ? "&" : "?"}text=${encoded}`;
    }

    return `https://wa.me/541128421008?text=${encoded}`;
  };

  const renderSuccess = (payload, whatsappHref) => {
    const firstName = normalizeFirstName(payload.nombre);
    const advisorHref = buildAdvisorHref(whatsappHref, payload);

    status.setAttribute("data-state", "success-card");

    status.innerHTML = `
      <article class="contactSuccessCard" role="dialog" aria-modal="true" aria-label="Consulta enviada">
        <button class="contactSuccessClose" type="button" data-contact-success-close aria-label="Cerrar confirmación">×</button>

        <div class="contactSuccessIcon" aria-hidden="true">✓</div>

        <h3>Listo, ${escapeHtml(firstName)}</h3>

        <p class="contactSuccessIntro">
          Recibimos tu consulta y el equipo comercial te va a responder.
        </p>

        <div class="contactSuccessData">
          <p class="contactSuccessKicker">Datos procesados</p>

          <dl>
            <div>
              <dt>Nombre</dt>
              <dd>${escapeHtml(`${payload.nombre} ${payload.apellido}`.trim())}</dd>
            </div>

            <div>
              <dt>Empresa</dt>
              <dd>${escapeHtml(payload.empresa || "No informada")}</dd>
            </div>

            <div>
              <dt>Email</dt>
              <dd>${escapeHtml(payload.email)}</dd>
            </div>

            <div>
              <dt>Teléfono</dt>
              <dd>${escapeHtml(payload.telefono)}</dd>
            </div>

            <div>
              <dt>Consulta</dt>
              <dd>${escapeHtml(labelTipoConsulta(payload.tipoConsulta))}</dd>
            </div>

            <div>
              <dt>Mensaje</dt>
              <dd>${escapeHtml(payload.mensaje || "Sin mensaje adicional")}</dd>
            </div>
          </dl>
        </div>
        <a class="contactSuccessWhatsapp" href="${advisorHref}" target="_blank" rel="noopener noreferrer">
          Hablar con un asesor
          <span aria-hidden="true">→</span>
        </a>

        <p class="contactSuccessTimer" data-contact-success-timer>
          Esta confirmación se cierra en 20 segundos.
        </p>
      </article>
    `;

    let secondsLeft = 20;
    const closeButton = status.querySelector("[data-contact-success-close]");
    const timer = status.querySelector("[data-contact-success-timer]");

    const closeModal = () => {
      status.textContent = "";
      status.removeAttribute("data-state");
    };

    closeButton?.addEventListener("click", closeModal);

    const interval = window.setInterval(() => {
      secondsLeft -= 1;

      if (timer) {
        timer.textContent = `Esta confirmación se cierra en ${secondsLeft} segundos.`;
      }

      if (secondsLeft <= 0) {
        window.clearInterval(interval);
        closeModal();
      }
    }, 1000);

    status.addEventListener(
      "click",
      (event) => {
        if (event.target === status) {
          window.clearInterval(interval);
          closeModal();
        }
      },
      { once: true }
    );

    window.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          window.clearInterval(interval);
          closeModal();
        }
      },
      { once: true }
    );
  };

  if (form && status) {
    form.setAttribute("data-vma-contact-endpoint", contactApiUrl);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const endpoint = form.getAttribute("data-vma-contact-endpoint");
      const whatsappHref = form.getAttribute("data-whatsapp-href") || "";
      const submitButton = form.querySelector('button[type="submit"], input[type="submit"]');

      const setStatus = (message, state) => {
        status.textContent = message;
        status.setAttribute("data-state", state);
      };

      const formData = new FormData(form);

      const payload = {
        nombre: String(formData.get("nombre") || "").trim(),
        apellido: String(formData.get("apellido") || "").trim(),
        empresa: String(formData.get("empresa") || "").trim(),
        email: String(formData.get("email") || "").trim(),
        telefono: String(formData.get("telefono") || "").trim(),
        tipoConsulta: String(formData.get("tipoConsulta") || "").trim(),
        mensaje: String(formData.get("mensaje") || "").trim(),
        origen: window.location.href,
        source: "vma-web-contact-form",
        website: String(formData.get("website") || "").trim(),
      };

      if (!payload.nombre || !payload.apellido || !payload.email || !payload.telefono) {
        setStatus("Completá nombre, apellido, email y teléfono para enviar la consulta.", "error");
        return;
      }

      try {
        setStatus("Estamos enviando tu consulta...", "loading");

        if (submitButton) {
          submitButton.setAttribute("disabled", "true");
          submitButton.setAttribute("aria-busy", "true");
        }

        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        const data = await response.json().catch(() => null);

        if (!response.ok || !data?.ok) {
          throw new Error(data?.error || "contact_send_failed");
        }

        renderSuccess(payload, whatsappHref);
        form.reset();
      } catch (error) {
        console.error("VMA contact form error", error);
        setStatus("No pudimos enviar la consulta. Probá por WhatsApp o intentá nuevamente.", "error");
      } finally {
        if (submitButton) {
          submitButton.removeAttribute("disabled");
          submitButton.removeAttribute("aria-busy");
        }
      }
    });
  }
</script>

<style>
  .contactSection {
    background-color: #070707;
    width: 100%;
    padding: 120px 80px;
    box-sizing: border-box;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .contactInner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  .contactHeader {
    margin-bottom: 80px;
  }

  .contactKicker {
    color: #6b6b6b;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 32px 0;
  }

  .contactTitle {
    color: #ffffff;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 48px 0;
    max-width: 18ch;
  }

  .contactTitleAccent {
    color: #ffc400;
    font-style: italic;
    font-weight: 300;
  }

  .contactStats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .contactStat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contactStatLabel {
    color: #6b6b6b;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0;
  }

  .contactStatValue {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 400;
    margin: 0;
  }

  .contactDivider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: 80px 0;
  }

  .contactGrid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 80px;
    align-items: start;
  }

  .contactInfo {
    position: sticky;
    top: 100px;
  }

  .contactInfoTitle {
    font-family: var(--font-body);
    color: #ffc400;
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 24px 0;
  }

  .contactInfoText {
    font-family: var(--font-body);
    color: #c9c9c9;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 40px 0;
    max-width: 42ch;
  }

  .contactDetails {
    font-family: var(--font-body);
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0;
  }

  .contactDetail {
    font-family: var(--font-body);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contactDetail dt {
    font-family: var(--font-body);
    color: #6b6b6b;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .contactDetail dd {
    font-family: var(--font-body);
    color: #ffffff;
    font-size: 0.95rem;
    margin: 0;
  }

  .contactDetail dd a,
  .contactDetailLink {
    width: fit-content;
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    color: #ffc400;
    font-family: var(--font-body);
    font-size: clamp(1.18rem, 1.55vw, 1.48rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1.18;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 196, 0, 0.58);
    overflow-wrap: anywhere;
    word-break: normal;
    transition:
      color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .contactDetail dd a:hover,
  .contactDetailLink:hover {
    color: #ffffff;
    border-color: #ffffff;
    transform: translateX(2px);
  }

  .contactForm {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .formRow {
    display: grid;
    gap: 24px;
  }

  .formRow--2 {
    grid-template-columns: 1fr 1fr;
  }

  .formField {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .formLabel {
    font-family: var(--font-body);
    color: #6b6b6b;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .formInput {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    padding: 12px 0;
    font-size: 1rem;
    font-family: var(--font-body);
    transition: border-color 0.3s ease;
    border-radius: 0;
    outline: none;
  }

  .formInput:focus {
    border-bottom-color: #ffc400;
  }

  .formInput::placeholder {
    color: #6b6b6b;
  }

  .formSelect {
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8' fill='none'%3e%3cpath d='M1 1L6 6L11 1' stroke='%23ffc400' stroke-width='1.5'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 4px center;
    padding-right: 24px;
  }

  .formSelect option {
    background: #070707;
    color: #ffffff;
  }

  .formTextarea {
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 16px;
    resize: vertical;
    min-height: 120px;
    font-family: inherit;
    line-height: 1.6;
  }

  .formTextarea:focus {
    border-color: #ffc400;
  }

  .formActions {
    display: flex;
    gap: 16px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .formBtn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s ease;
    font-family: var(--font-body);
  }

  .formBtn--primary {
    background: #ffc400;
    color: #070707;
  }

  .formBtn--primary:hover {
    background: #ffffff;
  }

  .formBtn--ghost {
    background: transparent;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .formBtn--ghost:hover {
    border-color: #ffc400;
    color: #ffc400;
    gap: 16px;
  }

  @media (max-width: 1024px) {
    .contactSection {
      padding: 80px 32px;
    }

    .contactGrid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .contactInfo {
      position: static;
    }

    .contactStats {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .contactSection {
      padding: 60px 24px;
    }

    .contactHeader {
      margin-bottom: 60px;
    }

    .contactDivider {
      margin: 60px 0;
    }

    .formRow--2 {
      grid-template-columns: 1fr;
    }

    .formActions {
      flex-direction: column;
    }

    .formBtn {
      justify-content: center;
      width: 100%;
    }

    .contactDetails {
      gap: 28px;
    }

    .contactDetail {
      gap: 7px;
    }

    .contactDetail dd a,
    .contactDetailLink {
      font-size: clamp(1.18rem, 5.4vw, 1.42rem);
      line-height: 1.18;
    }
  }

  .vmaHoneypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .contactFormStatus {
    min-height: 1.35em;
    margin-top: 0.85rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.72);
  }

  .contactFormStatus[data-state="loading"] {
    color: rgba(255, 255, 255, 0.78);
  }

  .contactFormStatus[data-state="success"] {
    color: #ffc400;
  }

  .contactFormStatus[data-state="error"] {
    color: #ff6b6b;
  }


  .contactFormStatus[data-state="success-card"] {
    color: inherit;
  }

  .contactSuccessCard {
    margin-top: 28px;
    padding: clamp(24px, 3vw, 34px);
    border: 1px solid rgba(255, 196, 0, 0.5);
    border-radius: 22px;
    background:
      radial-gradient(circle at 88% 12%, rgba(255, 196, 0, 0.12), transparent 34%),
      rgba(255, 255, 255, 0.045);
    color: #ffffff;
    box-shadow: 0 22px 80px rgba(0, 0, 0, 0.28);
  }

  .contactSuccessIcon {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    margin-bottom: 20px;
    border-radius: 999px;
    background: #ffc400;
    color: #070707;
    font-size: 1.7rem;
    font-weight: 900;
  }

  .contactSuccessCard h3 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .contactSuccessIntro {
    max-width: 56ch;
    margin: 14px 0 26px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1rem;
    line-height: 1.55;
  }

  .contactSuccessData {
    margin-top: 24px;
  }

  .contactSuccessKicker {
    margin: 0 0 12px;
    color: #ffc400;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .contactSuccessData dl {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .contactSuccessData div {
    display: grid;
    grid-template-columns: minmax(120px, 0.45fr) minmax(0, 1fr);
    gap: 18px;
    padding: 13px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .contactSuccessData dt {
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contactSuccessData dd {
    margin: 0;
    color: #ffffff;
    font-size: 0.94rem;
    font-weight: 700;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .contactSuccessNotice {
    margin-top: 22px;
    padding: 16px 18px;
    border-left: 4px solid #ffc400;
    border-radius: 12px;
    background: rgba(255, 196, 0, 0.1);
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .contactSuccessNotice strong {
    color: #ffc400;
  }

  .contactSuccessWhatsapp {
    width: fit-content;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
    padding: 0 28px;
    border-radius: 999px;
    background: #25d366;
    color: #07140b;
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 900;
    text-decoration: none;
    transition:
      transform 0.22s ease,
      gap 0.22s ease,
      filter 0.22s ease;
  }

  .contactSuccessWhatsapp:hover {
    gap: 16px;
    transform: translateY(-2px);
    filter: brightness(1.04);
  }

  @media (max-width: 640px) {
    .contactSuccessData div {
      grid-template-columns: 1fr;
