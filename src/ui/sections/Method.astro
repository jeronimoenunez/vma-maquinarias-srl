---
type MethodCard = {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  image?: {
    src: string;
    alt: string;
  };
  variant?: "image" | "logo";
};

type Props = {
  kicker?: string;
  title?: string;
  cards?: MethodCard[];
};

const {
  kicker = "SISTEMA VMA",
  title = "Dos formas de entender cómo resolvemos una operación.",
  cards = [
    {
      eyebrow: "UNIDADES DE NEGOCIO",
      title: "Alquiler, venta de equipos y servicio técnico.",
      description:
        "Tres líneas de trabajo para resolver disponibilidad, inversión y continuidad operativa.",
      href: "#contacto",
      image: {
        src: "/images/IMG_20250703_094445389_HDR.jpg",
        alt: "Equipo de elevación VMA Rental en operación",
      },
      variant: "image",
    },
    {
      eyebrow: "MÉTODO VMA",
      title: "Lo que nos hace diferentes.",
      description:
        "Análisis, asesoramiento comprometido y proyección 360° antes de mover un equipo.",
      href: "#contacto",
      variant: "logo",
    },
  ],
} = Astro.props as Partial<Props>;
---

<section id="negocio" class="methodSection">
  <div class="methodShell">
    <div class="methodHeader">
      <p class="methodKicker">{kicker}</p>
      <h2 class="methodTitle">{title}</h2>
    </div>

    <div class="methodGrid">
      {
        cards.map((card) => (
          <a class="methodCard" href={card.href || "#contacto"}>
            <div class="methodMedia">
              {
                card.variant === "logo" ? (
                  <div class="methodLogoBox" aria-hidden="true">
                    <span class="methodLogoMark">M</span>
                  </div>
                ) : (
                  <img
                    src={card.image?.src}
                    alt={card.image?.alt || card.title}
                    loading="lazy"
                    decoding="async"
                  />
                )
              }
              <div class="methodMediaOverlay" aria-hidden="true"></div>
            </div>

            <div class="methodBody">
              {card.eyebrow && <span class="methodPill">{card.eyebrow}</span>}

              <div class="methodText">
                <h3>{card.title}</h3>
                {card.description && <p>{card.description}</p>}
              </div>

              <span class="methodArrow" aria-hidden="true">↘</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .methodSection {
    position: relative;
    z-index: 2;
    background: #030303;
    color: #ffffff;
    overflow: hidden;
    border-radius: clamp(22px, 3vw, 42px) clamp(22px, 3vw, 42px) 0 0;
    margin-top: clamp(-12px, -1.4vw, -4px);
  }

  .methodShell {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding:
      clamp(58px, 7vw, 110px)
      clamp(22px, 5vw, 92px)
      clamp(56px, 7vw, 104px);
  }

  .methodHeader {
    display: grid;
    grid-template-columns: minmax(140px, 0.36fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 84px);
    align-items: start;
    margin-bottom: clamp(34px, 5vw, 72px);
  }

  .methodKicker {
    margin: 0;
    color: #ffc400;
    font-family: var(--font-body);
    font-size: clamp(0.68rem, 0.72vw, 0.82rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .methodTitle {
    margin: 0;
    max-width: 13.4ch;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: clamp(3rem, 5.6vw, 6.9rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.07em;
    text-wrap: balance;
  }

  .methodGrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 2.2vw, 32px);
  }

  .methodCard {
    position: relative;
    display: grid;
    grid-template-rows: minmax(260px, 1fr) auto;
    min-height: clamp(500px, 45vw, 650px);
    overflow: hidden;
    border-radius: clamp(18px, 2vw, 30px);
    background: #080808;
    color: #ffffff;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 26px 70px rgba(0, 0, 0, 0.24);
  }

  .methodMedia {
    position: relative;
    min-height: clamp(250px, 27vw, 390px);
    overflow: hidden;
    background: #d9d9d9;
  }

  .methodMedia img {
    width: 100%;
    height: 100%;
    max-width: none;
    display: block;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.78) contrast(1.05);
    transform: scale(1.01);
    transition: transform 520ms ease, filter 520ms ease;
  }

  .methodCard:hover .methodMedia img {
    transform: scale(1.045);
    filter: saturate(0.94) contrast(1.08);
  }

  .methodMediaOverlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.05) 0%,
        rgba(0, 0, 0, 0.18) 58%,
        rgba(0, 0, 0, 0.52) 100%
      );
    pointer-events: none;
  }

  .methodLogoBox {
    width: 100%;
    height: 100%;
    min-height: clamp(250px, 27vw, 390px);
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 50% 10%, rgba(255, 255, 255, 0.92), rgba(225, 225, 225, 0.92) 48%, rgba(205, 205, 205, 0.92) 100%);
  }

  .methodLogoMark {
    color: #000000;
    font-family: var(--font-body);
    font-size: clamp(8rem, 16vw, 18rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.14em;
    transform: scaleX(1.16);
  }

  .methodBody {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 18px;
    padding: clamp(22px, 2.5vw, 34px);
    background:
      linear-gradient(180deg, rgba(8, 8, 8, 0.92), #030303 68%);
    min-height: clamp(190px, 15vw, 245px);
  }

  .methodPill {
    grid-column: 1 / -1;
    width: fit-content;
    margin-top: -44px;
    padding: 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.26);
    border-radius: 999px;
    background: rgba(3, 3, 3, 0.72);
    color: rgba(255, 255, 255, 0.74);
    font-family: var(--font-body);
    font-size: clamp(0.58rem, 0.62vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .methodText h3 {
    margin: 0;
    max-width: 14ch;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: clamp(2rem, 3.3vw, 4.25rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.066em;
  }

  .methodText p {
    margin: clamp(14px, 1.2vw, 18px) 0 0;
    max-width: 48ch;
    color: rgba(255, 255, 255, 0.68);
    font-family: var(--font-body);
    font-size: clamp(0.82rem, 0.9vw, 1rem);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.018em;
  }

  .methodArrow {
    color: rgba(255, 255, 255, 0.7);
    font-size: clamp(1.4rem, 1.8vw, 2.2rem);
    line-height: 1;
    transform: translateY(4px);
    transition: color 180ms ease, transform 180ms ease;
  }

  .methodCard:hover .methodArrow {
    color: #ffc400;
    transform: translate(4px, 8px);
  }

  @media (max-width: 1180px) {
    .methodShell {
      padding:
        clamp(52px, 7vw, 78px)
        24px
        clamp(54px, 7vw, 78px);
    }

    .methodHeader {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 34px;
    }

    .methodTitle {
      max-width: 13ch;
      font-size: clamp(2.7rem, 8vw, 5.4rem);
    }
  }

  @media (max-width: 860px) {
    .methodSection {
      border-radius: 28px 28px 0 0;
    }

    .methodShell {
      padding: 44px 16px 52px;
    }

    .methodHeader {
      text-align: left;
      margin-bottom: 26px;
    }

    .methodTitle {
      max-width: 14ch;
      font-size: clamp(2.15rem, 10vw, 3.8rem);
      line-height: 0.98;
    }

    .methodGrid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .methodCard {
      min-height: auto;
      grid-template-rows: auto auto;
      border-radius: 22px;
    }

    .methodMedia {
      min-height: 220px;
      height: 220px;
    }

    .methodLogoBox {
      min-height: 220px;
    }

    .methodLogoMark {
      font-size: clamp(7rem, 34vw, 10rem);
    }

    .methodBody {
      min-height: 150px;
      padding: 20px;
    }

    .methodPill {
      margin-top: -38px;
      padding: 7px 12px;
      font-size: 0.58rem;
    }

    .methodText h3 {
      max-width: 15ch;
      font-size: clamp(1.65rem, 8vw, 2.65rem);
      line-height: 0.98;
    }

    .methodText p {
      max-width: 32ch;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 520px) {
    .methodShell {
      padding: 38px 14px 46px;
    }

    .methodTitle {
      font-size: clamp(1.95rem, 9.4vw, 2.75rem);
      letter-spacing: -0.058em;
    }

    .methodMedia {
      height: 190px;
      min-height: 190px;
    }

    .methodLogoBox {
      min-height: 190px;
    }

    .methodBody {
      padding: 18px;
      gap: 12px;
    }

    .methodText h3 {
      font-size: clamp(1.5rem, 7.2vw, 2.1rem);
    }

    .methodText p {
      font-size: 0.78rem;
    }

    .methodArrow {
      font-size: 1.35rem;
    }
  }
</style>
