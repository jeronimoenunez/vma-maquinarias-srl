---
type Step = {
  number: string;
  title: string;
  description: string;
  image?: { src: string; alt: string };
};

type Props = {
  moduleEyebrow?: string;
  moduleTitle?: string;
  heroEyebrow?: string;
  heroTitle?: string;
  heroCtaLabel?: string;
  heroCtaHref?: string;
  heroImage?: { src: string; alt: string };
  steps?: Step[];
};

const FALLBACK_HERO_IMAGE = {
  src: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1600&auto=format&fit=crop&q=80",
  alt: "Equipo de elevación operando en obra",
};

const FALLBACK_STEP_IMAGES = [
  {
    src: "https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=800&auto=format&fit=crop&q=80",
    alt: "Planos técnicos y especificación de obra",
  },
  {
    src: "https://images.unsplash.com/photo-1530124566582-a618bc2615dc?w=800&auto=format&fit=crop&q=80",
    alt: "Coordinación logística y planificación",
  },
  {
    src: "https://images.unsplash.com/photo-1581092446327-9b52bd1570c2?w=800&auto=format&fit=crop&q=80",
    alt: "Técnico realizando soporte en sitio",
  },
];

const fallbackSteps: Step[] = [
  {
    number: "01",
    title: "Especificación",
    description:
      "Definimos juntos altura, superficie, energía y zona. La cotización refleja exactamente el equipo que tu operación necesita — ni más capacidad de la que pagás, ni menos de la que requerís.",
    image: FALLBACK_STEP_IMAGES[0],
  },
  {
    number: "02",
    title: "Coordinación",
    description:
      "Confirmamos disponibilidad, programamos entrega y validamos requisitos del sitio. El equipo llega cuando dijimos que iba a llegar — porque coordinamos antes, no después.",
    image: FALLBACK_STEP_IMAGES[1],
  },
  {
    number: "03",
    title: "Operación y respaldo",
    description:
      "Soporte técnico activo durante todo el alquiler. Si algo requiere intervención, respondemos en sitio o reemplazamos la unidad. Continuidad operativa es la definición del sistema.",
    image: FALLBACK_STEP_IMAGES[2],
  },
];

const props = Astro.props as Props;

const moduleEyebrow = props.moduleEyebrow ?? "MÉTODO VMA";
const moduleTitle = props.moduleTitle ?? "Cómo trabajamos";
const heroEyebrow = props.heroEyebrow ?? "Análisis — Diseño — Implementación";
const heroTitle =
  props.heroTitle ??
  "No enviamos una máquina sin entender tu flujo de trabajo. Optimizamos tu espacio. Cuidamos tus costos.";
const heroCtaLabel = props.heroCtaLabel ?? "Ver equipos disponibles";
const heroCtaHref = props.heroCtaHref ?? "#equipos";
const heroImage = props.heroImage ?? FALLBACK_HERO_IMAGE;

const incomingSteps = Array.isArray(props.steps) && props.steps.length > 0
  ? props.steps
  : fallbackSteps;

const steps: Step[] = incomingSteps.map((step, index) => ({
  number: step.number ?? String(index + 1).padStart(2, "0"),
  title: step.title ?? fallbackSteps[index]?.title ?? "",
  description: step.description ?? fallbackSteps[index]?.description ?? "",
  image: step.image ?? FALLBACK_STEP_IMAGES[index] ?? FALLBACK_STEP_IMAGES[0],
}));
---

<section id="metodologia" class="methodSection">
  <div class="heroBlock">
    <div class="heroText" data-reveal>
      <header class="moduleHeader">
        <p class="moduleEyebrow">{moduleEyebrow}</p>
        <h2 class="moduleTitle">{moduleTitle}</h2>
      </header>

      <p class="heroEyebrow">{heroEyebrow}</p>
      <h3 class="heroTitle">{heroTitle}</h3>
      <a class="heroBtn" href={heroCtaHref}>{heroCtaLabel}</a>
    </div>
    <div class="heroImage" data-reveal style="--reveal-delay: 120ms">
      <img src={heroImage.src} alt={heroImage.alt} loading="lazy" />
    </div>
  </div>

  <div class="stepsGrid">
    {
      steps.map((step) => (
        <article class="step vma-panel-hover" data-reveal style={`--reveal-delay: ${120 * (steps.indexOf(step) + 1)}ms`}>
          <div class="stepImage">
            <img src={step.image!.src} alt={step.image!.alt} loading="lazy" />
          </div>
          <span class="stepNumber">{step.number}</span>
          <h4 class="stepTitle">{step.title}</h4>
          <p class="stepDescription">{step.description}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
.methodSection {
  background: #f5f5f5;
  padding: clamp(40px, 5vw, 72px) clamp(40px, 6vw, 120px) clamp(80px, 10vw, 140px);
  color: #2f2f2f;
  display: flex;
  flex-direction: column;
}

.moduleHeader {
  margin-bottom: clamp(72px, 8vw, 120px);
}

.moduleEyebrow {
  color: #ffc400;
  font-size: 0.78rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  font-weight: 700;
  margin: 0 0 12px 0;
}

.moduleTitle {
  color: #ffc400;
  font-size: clamp(1.4rem, 2vw, 1.8rem);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.01em;
  margin: 0;
}

.heroBlock {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(40px, 6vw, 100px);
  align-items: center;
  margin-bottom: clamp(72px, 8vw, 112px);
  width: 100%;
}

.heroText {
  grid-column: 1;
  max-width: 460px;
  padding-right: 0;
}

.heroEyebrow {
  color: #6b6b6b;
  font-size: 0.95rem;
  margin: 0 0 24px 0;
  line-height: 1.4;
}

.heroTitle {
  color: #2f2f2f;
  font-size: clamp(1.6rem, 2.6vw, 2.4rem);
  font-weight: 300;
  line-height: 1.3;
  letter-spacing: -0.01em;
  margin: 0 0 40px 0;
  max-width: 30ch;
}

.heroBtn {
  display: inline-block;
  padding: 14px 32px;
  border: 1px solid #2f2f2f;
  background: transparent;
  color: #2f2f2f;
  font-size: 0.85rem;
  letter-spacing: 0.08em;
  text-decoration: none;
  transition: background 0.3s ease, color 0.3s ease;
}

.heroBtn:hover {
  background: #2f2f2f;
  color: #ffffff;
}

.heroImage {
  grid-column: 2 / 4;
  aspect-ratio: 16 / 9;
  min-height: clamp(360px, 34vw, 520px);
  overflow: hidden;
  width: 100%;
}

.heroImage img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.stepsGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(40px, 6vw, 100px);
  width: 100%;
}

.step {
  display: flex;
  flex-direction: column;
}

.stepImage {
  aspect-ratio: 16 / 10;
  overflow: hidden;
  margin-bottom: 24px;
}

.stepImage img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.6s ease;
}

.step:hover .stepImage img {
  transform: scale(1.04);
}

.stepNumber {
  color: #ffc400;
  font-family: var(--font-display, inherit);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  margin-bottom: 8px;
  display: block;
}

.stepTitle {
  color: #2f2f2f;
  font-size: clamp(1.1rem, 1.4vw, 1.3rem);
  font-weight: 500;
  line-height: 1.3;
  margin: 0 0 8px 0;
}

.stepDescription {
  color: #6b6b6b;
  font-size: 0.95rem;
  line-height: 1.5;
  margin: 0;
}

@media (min-width: 1920px) {
  .methodSection {
    max-width: 1920px;
    margin-left: auto;
    margin-right: auto;
  }
}

@media (max-width: 1024px) {
  .methodSection {
    padding: clamp(60px, 8vw, 100px) clamp(24px, 5vw, 48px);
  }

  .heroBlock {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .heroText,
  .heroImage {
    grid-column: 1;
  }

  .stepsGrid {
    grid-template-columns: 1fr;
    gap: 48px;
  }
}

@media (max-width: 640px) {
  .methodSection {
    padding: 60px 24px;
  }

  .heroBlock,
  .stepsGrid {
    gap: 32px;
  }

  .heroTitle {
    font-size: clamp(1.3rem, 5vw, 1.7rem);
  }
}
</style>