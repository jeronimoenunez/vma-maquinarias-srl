---
type FeatureCard = {
  id: string;
  href: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image: { src: string; alt: string };
  size: "hero" | "regular";
};

type Props = {
  kicker?: string;
  title?: string;
  cards?: FeatureCard[];
};

const fallbackCards: FeatureCard[] = [
  {
    id: "industria",
    href: "#contacto",
    eyebrow: "SECTOR",
    title: "Industria y planta",
    subtitle:
      "Contratos a medida. Equipos dedicados. Un solo interlocutor para toda la operación.",
    image: {
      src: "https://images.unsplash.com/photo-1717386255773-1e3037c81788?q=80&w=2340&auto=format&fit=crop",
      alt: "Planta industrial con maquinaria operativa",
    },
    size: "hero",
  },
  {
    id: "construccion",
    href: "#contacto",
    eyebrow: "SECTOR",
    title: "Construcción y obra",
    subtitle:
      "Disponibilidad inmediata. Entrega coordinada. Soporte en sitio.",
    image: {
      src: "/images/Firefly19.jpg",
      alt: "Obra en construcción con equipos de elevación",
    },
    size: "regular",
  },
  {
    id: "alquiler",
    href: "#contacto",
    eyebrow: "SECTOR",
    title: "Alquiler flexible",
    subtitle:
      "Planes para industria, planes para obra, planes para lo que necesites resolver.",
    image: {
      src: "/images/IMG_20250703_094445389_HDR.jpg",
      alt: "Plataforma articulada en operación",
    },
    size: "regular",
  },
];

const {
  kicker = "DÓNDE OPERAMOS",
  title = "Cada sector tiene su lógica. El equipo correcto depende de entenderla.",
  cards,
} = Astro.props as Partial<Props>;

const safeCards = Array.isArray(cards) && cards.length ? cards : fallbackCards;
---

<section
  id="sectores"
  class="sectorsSection"
  data-vma-sectors-carousel
  style={`--slides: ${safeCards.length};`}
>
  <div class="sectorsShell">
    <div class="sectorsRule" aria-hidden="true"></div>

    <div class="sectorsLayout">
      <div class="sectorsCopy">
        <p class="kicker">{kicker}</p>
        <h2 class="title">{title}</h2>
      </div>

      <div class="sectorsCarousel">
        <div class="sectorFrame" aria-label="Sectores donde opera VMA Rental">
          {
            safeCards.map((card, index) => (
              <article
                class={`sectorSlide ${index === 0 ? "isActive" : ""}`}
                data-sector-slide
                data-slide-index={index}
                data-href={card.href}
                aria-hidden={index === 0 ? "false" : "true"}
              >
                <img
                  class="cardImg"
                  src={card.image.src}
                  alt={card.image.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />

                <div class="cardOverlay" aria-hidden="true"></div>

                <a class="cardContent" href={card.href}>
                  {card.eyebrow && <span class="cardEyebrow">{card.eyebrow}</span>}
                  <h3 class="cardTitle">{card.title}</h3>
                  {card.subtitle && <p class="cardSubtitle">{card.subtitle}</p>}
                </a>
              </article>
            ))
          }

          <button
            class="sectorArrow sectorArrow--prev"
            type="button"
            aria-label="Ver sector anterior"
            data-sector-prev
          >
            ‹
          </button>

          <button
            class="sectorArrow sectorArrow--next"
            type="button"
            aria-label="Ver sector siguiente"
            data-sector-next
          >
            ›
          </button>
        </div>

        <div class="sectorDots" aria-label="Selector de sectores">
          {
            safeCards.map((card, index) => (
              <button
                class={`sectorDot ${index === 0 ? "isActive" : ""}`}
                type="button"
                aria-label={`Ver ${card.title}`}
                data-sector-dot
                data-dot-index={index}
              ></button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const bindSectorsCarousel = () => {
      const section = document.querySelector("[data-vma-sectors-carousel]");
      if (!section) return;

      const slides = Array.from(section.querySelectorAll("[data-sector-slide]"));
      const dots = Array.from(section.querySelectorAll("[data-sector-dot]"));
      const prev = section.querySelector("[data-sector-prev]");
      const next = section.querySelector("[data-sector-next]");

      if (!slides.length) return;

      let activeIndex = 0;

      const setActive = (index) => {
        activeIndex = (index + slides.length) % slides.length;

        slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === activeIndex;

          slide.classList.toggle("isActive", isActive);
          slide.setAttribute("aria-hidden", isActive ? "false" : "true");
        });

        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === activeIndex;

          dot.classList.toggle("isActive", isActive);
          dot.setAttribute("aria-current", isActive ? "true" : "false");
        });
      };

      prev?.addEventListener("click", () => {
        setActive(activeIndex - 1);
      });

      next?.addEventListener("click", () => {
        setActive(activeIndex + 1);
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const nextIndex = Number(dot.dataset.dotIndex || 0);
          setActive(nextIndex);
        });
      });

      section.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") setActive(activeIndex - 1);
        if (event.key === "ArrowRight") setActive(activeIndex + 1);
      });

      setActive(0);
    };

    bindSectorsCarousel();
    document.addEventListener("DOMContentLoaded", bindSectorsCarousel, { once: true });
  })();
</script>

<style>
  .sectorsSection {
    background: #ffffff;
    color: #080808;
    overflow: clip;
  }

  .sectorsShell {
    width: 100%;
    padding:
      clamp(72px, 8vw, 120px)
      clamp(30px, 4vw, 74px)
      clamp(80px, 8vw, 128px);
    display: flex;
    flex-direction: column;
  }

  .sectorsRule {
    width: 100%;
    height: 1px;
    flex: 0 0 auto;
    background: rgba(8, 8, 8, 0.88);
    margin-bottom: clamp(34px, 4vw, 58px);
  }

  .sectorsLayout {
    display: grid;
    grid-template-columns: minmax(420px, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(42px, 5vw, 92px);
    align-items: center;
  }

  .sectorsCopy {
    max-width: 760px;
    z-index: 2;
  }

  .kicker {
    margin: 0 0 clamp(22px, 2vw, 30px);
    color: #ffc400;
    font-family: var(--font-body);
    font-size: clamp(0.78rem, 0.8vw, 0.92rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .title {
    margin: 0;
    max-width: 15.6ch;
    color: #080808;
    font-family: var(--font-body);
    font-size: clamp(3rem, 4.45vw, 5.72rem);
    font-weight: 400;
    line-height: 0.99;
    letter-spacing: -0.066em;
    text-wrap: balance;
  }

  .sectorsCarousel {
    width: 100%;
  }

  .sectorFrame {
    position: relative;
    width: 100%;
    height: min(calc(100svh - 180px), 760px);
    min-height: 610px;
    border-radius: clamp(22px, 2vw, 34px);
    overflow: hidden;
    isolation: isolate;
    background: #101010;
    color: #ffffff;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.12);
  }

  .sectorSlide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateX(18px) scale(1.01);
    transition:
      opacity 420ms ease,
      visibility 420ms ease,
      transform 520ms ease;
    will-change: opacity, transform;
  }

  .sectorSlide.isActive {
    opacity: 1;
    visibility: visible;
    transform: translateX(0) scale(1);
    z-index: 1;
  }

  .cardImg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    transform: scale(1.005);
    transition: transform 0.8s ease;
  }

  .sectorFrame:hover .sectorSlide.isActive .cardImg {
    transform: scale(1.03);
  }

  .cardOverlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.42) 0%,
        rgba(0, 0, 0, 0.18) 34%,
        rgba(0, 0, 0, 0.08) 64%,
        rgba(0, 0, 0, 0.18) 100%
      ),
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.24) 0%,
        rgba(0, 0, 0, 0.06) 58%,
        rgba(0, 0, 0, 0.08) 100%
      );
    pointer-events: none;
  }

  .cardContent {
    position: absolute;
    left: clamp(28px, 3.2vw, 54px);
    right: clamp(28px, 3.2vw, 54px);
    top: clamp(28px, 3.2vw, 54px);
    z-index: 2;
    max-width: 820px;
    color: #ffffff;
    text-decoration: none;
  }

  .cardEyebrow {
    display: block;
    margin-bottom: 12px;
    color: #ffc400;
    font-family: var(--font-body);
    font-size: clamp(0.68rem, 0.74vw, 0.82rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .cardTitle {
    margin: 0 0 12px;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: clamp(2.2rem, 3.35vw, 4.45rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .cardSubtitle {
    margin: 0;
    max-width: 68ch;
    color: rgba(255, 255, 255, 0.84);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.05vw, 1.18rem);
    font-weight: 400;
    line-height: 1.48;
    letter-spacing: -0.018em;
  }

  .sectorArrow {
    position: absolute;
    top: 50%;
    z-index: 4;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 999px;
    background: rgba(8, 8, 8, 0.34);
    color: #ffffff;
    font-size: 31px;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;

    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    text-align: center;
  }

  .sectorArrow:hover {
    background: rgba(8, 8, 8, 0.62);
    border-color: rgba(255, 196, 0, 0.8);
    transform: translateY(-50%) scale(1.04);
  }

  .sectorArrow--prev {
    left: 18px;
  }

  .sectorArrow--next {
    right: 18px;
  }

  .sectorDots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
  }

  .sectorDot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(8, 8, 8, 0.22);
    cursor: pointer;
    transition:
      width 220ms ease,
      background 220ms ease,
      opacity 220ms ease;
  }

  .sectorDot.isActive {
    width: 36px;
    background: rgba(8, 8, 8, 0.78);
  }

  @media (max-width: 1180px) {
    .sectorsShell {
      padding: 56px 30px 82px;
    }

    .sectorsLayout {
      grid-template-columns: 1fr;
      gap: 42px;
      align-items: start;
    }

    .sectorsCopy {
      max-width: 860px;
      padding-top: 0;
    }

    .title {
      max-width: 13.5ch;
      font-size: clamp(2.65rem, 8vw, 5rem);
    }

    .sectorFrame {
      height: 680px;
      min-height: 0;
    }
  }

  @media (max-width: 720px) {
    .sectorsShell {
      padding: 52px 22px 76px;
    }

    .sectorsLayout {
      gap: 34px;
    }

    .title {
      max-width: 11.8ch;
      font-size: clamp(2.25rem, 12vw, 4.05rem);
      line-height: 1;
      letter-spacing: -0.058em;
    }

    .sectorFrame {
      height: 500px;
      border-radius: 24px;
    }

    .sectorArrow {
      width: 40px;
      height: 40px;
      font-size: 28px;
    }

    .sectorArrow--prev {
      left: 12px;
    }

    .sectorArrow--next {
      right: 12px;
    }

    .cardContent {
      left: 24px;
      right: 24px;
      top: 28px;
    }

    .cardTitle {
      font-size: clamp(2rem, 10vw, 3.35rem);
    }

    .cardSubtitle {
      font-size: 0.98rem;
      line-height: 1.44;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sectorSlide,
    .cardImg,
    .sectorArrow,
    .sectorDot {
      transition: none;
    }
  }
</style>
