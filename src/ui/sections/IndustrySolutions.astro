---
type FeatureCard = {
  id: string;
  href: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image: { src: string; alt: string };
  size: "hero" | "regular";
};

type Props = {
  kicker?: string;
  title?: string;
  cards?: FeatureCard[];
};

const fallbackCards: FeatureCard[] = [
  {
    id: "industria",
    href: "#contacto",
    eyebrow: "SECTOR",
    title: "Industria y planta",
    subtitle:
      "Contratos a medida. Equipos dedicados. Un solo interlocutor para toda la operación.",
    image: {
      src: "https://images.unsplash.com/photo-1717386255773-1e3037c81788?q=80&w=2340&auto=format&fit=crop",
      alt: "Planta industrial con maquinaria operativa",
    },
    size: "hero",
  },
  {
    id: "construccion",
    href: "#contacto",
    eyebrow: "SECTOR",
    title: "Construcción y obra",
    subtitle:
      "Disponibilidad inmediata. Entrega coordinada. Soporte en sitio.",
    image: {
      src: "/images/Firefly19.jpg",
      alt: "Obra en construcción con equipos de elevación",
    },
    size: "regular",
  },
  {
    id: "alquiler",
    href: "#contacto",
    eyebrow: "SECTOR",
    title: "Alquiler flexible",
    subtitle:
      "Planes para industria, planes para obra, planes para lo que necesites resolver.",
    image: {
      src: "/images/jovo.jpg?v=4",
      alt: "Plataforma articulada en operación",
    },
    size: "regular",
  },
];

const {
  kicker = "DÓNDE OPERAMOS",
  title = "Cada sector tiene su lógica. El equipo correcto depende de entenderla.",
  cards,
} = Astro.props as Partial<Props>;

const safeCards = Array.isArray(cards) && cards.length ? cards : fallbackCards;
---

<section
  id="sectores"
  class="sectorsSection"
  data-vma-sectors-carousel
  style={`--slides: ${safeCards.length};`}
>
  <div class="sectorsShell">
    <div class="sectorsLayout">
      <div class="sectorsCopy">
        <p class="kicker">{kicker}</p>
        <h2 class="title">{title}</h2>
      </div>

      <div class="sectorsCarousel">
        <div class="sectorFrame" aria-label="Sectores donde opera VMA Rental">
          {
            safeCards.map((card, index) => (
              <article
                class={`sectorSlide ${index === 0 ? "isActive" : ""}`}
                data-sector-slide
                data-slide-index={index}
                data-href={card.href}
                aria-hidden={index === 0 ? "false" : "true"}
              >
                <img
                  class="cardImg"
                  src={card.image.src}
                  alt={card.image.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />

                <div class="cardOverlay" aria-hidden="true"></div>

                <a class="cardContent" href={card.href}>
                  {card.eyebrow && <span class="cardEyebrow">{card.eyebrow}</span>}
                  <h3 class="cardTitle">{card.title}</h3>
                  {card.subtitle && <p class="cardSubtitle">{card.subtitle}</p>}
                </a>
              </article>
            ))
          }

          <button
            class="sectorArrow sectorArrow--prev"
            type="button"
            aria-label="Ver sector anterior"
            data-sector-prev
          >
            ‹
          </button>

          <button
            class="sectorArrow sectorArrow--next"
            type="button"
            aria-label="Ver sector siguiente"
            data-sector-next
          >
            ›
          </button>
        </div>

        <div class="sectorDots" aria-label="Selector de sectores">
          {
            safeCards.map((card, index) => (
              <button
                class={`sectorDot ${index === 0 ? "isActive" : ""}`}
                type="button"
                aria-label={`Ver ${card.title}`}
                data-sector-dot
                data-dot-index={index}
              ></button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const bindSectorsCarousel = () => {
      const section = document.querySelector("[data-vma-sectors-carousel]");
      if (!section) return;

      const slides = Array.from(section.querySelectorAll("[data-sector-slide]"));
      const dots = Array.from(section.querySelectorAll("[data-sector-dot]"));
      const prev = section.querySelector("[data-sector-prev]");
      const next = section.querySelector("[data-sector-next]");

      if (!slides.length) return;

      let activeIndex = 0;

      const setActive = (index) => {
        activeIndex = (index + slides.length) % slides.length;

        slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === activeIndex;
          slide.classList.toggle("isActive", isActive);
          slide.setAttribute("aria-hidden", isActive ? "false" : "true");
        });

        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === activeIndex;
          dot.classList.toggle("isActive", isActive);
          dot.setAttribute("aria-current", isActive ? "true" : "false");
        });
      };

      prev?.addEventListener("click", () => setActive(activeIndex - 1));
      next?.addEventListener("click", () => setActive(activeIndex + 1));

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          setActive(Number(dot.dataset.dotIndex || 0));
        });
      });

      section.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") setActive(activeIndex - 1);
        if (event.key === "ArrowRight") setActive(activeIndex + 1);
      });

      setActive(0);
    };

    bindSectorsCarousel();
    document.addEventListener("DOMContentLoaded", bindSectorsCarousel, { once: true });
  })();
</script>

<style>
  .sectorsSection {
    background: #ffffff;
    color: #080808;
    overflow: hidden;
  }

  .sectorsShell {
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
    padding:
      clamp(54px, 6vw, 88px)
      clamp(22px, 4vw, 72px)
      clamp(54px, 6vw, 88px);
  }

  .sectorsLayout {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(28px, 4vw, 72px);
    align-items: center;
  }

  .sectorsCopy {
    max-width: 620px;
    z-index: 2;
  }

  .kicker {
    margin: 0 0 clamp(14px, 1.4vw, 22px);
    color: #ffc400;
    font-family: var(--font-body);
    font-size: clamp(0.68rem, 0.72vw, 0.82rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .title {
    margin: 0;
    max-width: 15ch;
    color: #080808;
    font-family: var(--font-body);
    font-size: clamp(2.65rem, 4vw, 5rem);
    font-weight: 400;
    line-height: 0.99;
    letter-spacing: -0.064em;
    text-wrap: balance;
  }

  .sectorsCarousel {
    width: 95%;
min-width: 0;
margin-left: 4%;
  }

  .sectorFrame {
    position: relative;
    width: 100%;
    height: clamp(360px, 36vw, 560px);
    border-radius: clamp(20px, 2vw, 30px);
    overflow: hidden;
    isolation: isolate;
    background: #101010;
    color: #ffffff;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.12);
  }

  .sectorSlide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateX(14px) scale(1.01);
    transition:
      opacity 360ms ease,
      visibility 360ms ease,
      transform 460ms ease;
    will-change: opacity, transform;
  }

  .sectorSlide.isActive {
    opacity: 1;
    visibility: visible;
    transform: translateX(0) scale(1);
    z-index: 1;
  }

  .cardImg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    transform: scale(1.005);
    transition: transform 0.7s ease;
  }

  .sectorFrame:hover .sectorSlide.isActive .cardImg {
    transform: scale(1.025);
  }

  .cardOverlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.44) 0%,
        rgba(0, 0, 0, 0.16) 44%,
        rgba(0, 0, 0, 0.2) 100%
      ),
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.2) 0%,
        rgba(0, 0, 0, 0.05) 60%,
        rgba(0, 0, 0, 0.1) 100%
      );
    pointer-events: none;
  }

  .cardContent {
    position: absolute;
    left: clamp(22px, 3vw, 44px);
    right: clamp(22px, 3vw, 44px);
    top: clamp(22px, 3vw, 44px);
    z-index: 2;
    max-width: 720px;
    color: #ffffff;
    text-decoration: none;
  }

  .cardEyebrow {
    display: block;
    margin-bottom: 10px;
    color: #ffc400;
    font-family: var(--font-body);
    font-size: clamp(0.62rem, 0.68vw, 0.78rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .cardTitle {
    margin: 0 0 10px;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: clamp(2rem, 3vw, 3.7rem);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.045em;
  }

  .cardSubtitle {
    margin: 0;
    max-width: 58ch;
    color: rgba(255, 255, 255, 0.84);
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 0.95vw, 1.08rem);
    font-weight: 400;
    line-height: 1.42;
    letter-spacing: -0.018em;
  }

  .sectorArrow {
    position: absolute;
    top: 50%;
    z-index: 4;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(211, 211, 211);
    border-radius: 999px;
    background: rgb(8, 8, 8);
    color: #ffffff;
    font-size: 29px;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;

    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    text-align: center;
  }

  .sectorArrow:hover {
    background: rgba(8, 8, 8, 0.62);
    border-color: rgba(255, 196, 0, 0.8);
    transform: translateY(-50%) scale(1.04);
  }

  .sectorArrow--prev {
    left: 14px;
  }

  .sectorArrow--next {
    right: 14px;
  }

  .sectorDots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 16px;
  }

  .sectorDot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(8, 8, 8, 0.2);
    cursor: pointer;
    transition:
      width 220ms ease,
      background 220ms ease,
      opacity 220ms ease;
  }

  .sectorDot.isActive {
    width: 30px;
    background: rgba(8, 8, 8, 0.74);
  }

  @media (max-width: 1180px) {
    .sectorsShell {
      padding: 50px 24px 74px;
    }

    .sectorsLayout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .sectorsCopy {
      max-width: 820px;
    }

    .title {
      max-width: 15ch;
      font-size: clamp(2.45rem, 7vw, 4.4rem);
    }

    .sectorFrame {
      height: clamp(380px, 56vw, 620px);
    }
  }

  @media (max-width: 720px) {
    .sectorsShell {
      padding: 44px 16px 54px;
    }

    .sectorsLayout {
      gap: 24px;
    }

    .sectorsCopy {
      text-align: center;
      margin: 0 auto;
    }

    .kicker {
      margin-bottom: 10px;
      font-size: 0.66rem;
    }

    .title {
      max-width: 16ch;
      margin-inline: auto;
      font-size: clamp(1.95rem, 8.8vw, 3.05rem);
      line-height: 1.02;
      letter-spacing: -0.052em;
    }

    .sectorFrame {
      height: 332px;
      border-radius: 20px;
    }

    .sectorArrow {
      width: 34px;
      height: 34px;
      font-size: 24px;
      background: rgba(8, 8, 8, 0.46);
    }

    .sectorArrow--prev {
      left: 10px;
    }

    .sectorArrow--next {
      right: 10px;
    }

    .cardContent {
      left: 18px;
      right: 18px;
      top: 18px;
    }

    .cardEyebrow {
      margin-bottom: 8px;
      font-size: 0.6rem;
    }

    .cardTitle {
      font-size: clamp(1.7rem, 7.8vw, 2.55rem);
      line-height: 1;
    }

    .cardSubtitle {
      max-width: 30ch;
      font-size: 0.84rem;
      line-height: 1.36;
    }

    .sectorDots {
      margin-top: 12px;
    }
  }

  @media (max-width: 420px) {
    .sectorsShell {
      padding: 40px 14px 50px;
    }

    .title {
      font-size: clamp(1.75rem, 8vw, 2.4rem);
    }

    .sectorFrame {
      height: 300px;
      border-radius: 18px;
    }

    .cardSubtitle {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sectorSlide,
    .cardImg,
    .sectorArrow,
    .sectorDot {
      transition: none;
    }
  }
</style>
