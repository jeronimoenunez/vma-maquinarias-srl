---
type FeatureCard = {
  id: string;
  href: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image: { src: string; alt: string };
  size: "hero" | "regular";
};

type Props = {
  kicker?: string;
  title?: string;
  cards?: FeatureCard[];
};

const fallbackCards: FeatureCard[] = [
  {
    id: "industria",
    href: "#contacto",
    eyebrow: "SECTOR",
    title: "Industria y planta",
    subtitle:
      "Contratos a medida. Equipos dedicados. Un solo interlocutor para toda la operación.",
    image: {
      src: "https://images.unsplash.com/photo-1717386255773-1e3037c81788?q=80&w=2340&auto=format&fit=crop",
      alt: "Planta industrial con maquinaria operativa",
    },
    size: "hero",
  },
  {
    id: "construccion",
    href: "#contacto",
    eyebrow: "SECTOR",
    title: "Construcción y obra",
    subtitle:
      "Disponibilidad inmediata. Entrega coordinada. Soporte en sitio.",
    image: {
      src: "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=1400&auto=format&fit=crop&q=80",
      alt: "Obra en construcción con equipos de elevación",
    },
    size: "regular",
  },
  {
    id: "alquiler",
    href: "#contacto",
    title: "Alquiler flexible",
    subtitle:
      "Planes para industria, planes para obra, planes para lo que necesites resolver.",
    image: {
      src: "/images/IMG_20250703_094445389_HDR.jpg",
      alt: "Plataforma articulada en operación",
    },
    size: "regular",
  },
];

const {
  kicker = "DÓNDE OPERAMOS",
  title = "Cada sector tiene su lógica. El equipo correcto depende de entenderla.",
  cards,
} = Astro.props as Partial<Props>;

const safeCards = Array.isArray(cards) && cards.length ? cards : fallbackCards;
---

<section
  id="sectores"
  class="sectorsSection"
  data-vma-sectors
  style={`--slides: ${safeCards.length};`}
>
  <div class="sectorsShell">
    <div class="sectorsRule" aria-hidden="true"></div>

    <div class="sectorsLayout">
      <div class="sectorsCopy">
        <p class="kicker">{kicker}</p>
        <h2 class="title">{title}</h2>
      </div>

      <div class="sectorsSticky">
        <a class="sectorFrame" href="#contacto" aria-label="Sectores donde opera VMA Rental">
          {
            safeCards.map((card, index) => (
              <article
                class={`sectorSlide ${index === 0 ? "isActive" : ""}`}
                data-sector-slide
                data-slide-index={index}
              >
                <img
                  class="cardImg"
                  src={card.image.src}
                  alt={card.image.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />

                <div class="cardOverlay" aria-hidden="true"></div>

                <div class="cardContent">
                  {card.eyebrow && <span class="cardEyebrow">{card.eyebrow}</span>}
                  <h3 class="cardTitle">{card.title}</h3>
                  {card.subtitle && <p class="cardSubtitle">{card.subtitle}</p>}
                </div>
              </article>
            ))
          }
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const bindSectors = () => {
      const section = document.querySelector("[data-vma-sectors]");
      if (!section) return;

      const slides = [...section.querySelectorAll("[data-sector-slide]")];
      const frame = section.querySelector(".sectorFrame");
      if (!slides.length || !frame) return;

      const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
      let ticking = false;

      const setActive = () => {
        const rect = section.getBoundingClientRect();
        const viewport = window.innerHeight || 1;
        const totalScroll = Math.max(rect.height - viewport, 1);
        const progress = clamp(-rect.top / totalScroll, 0, 0.999);

        /*
          slides.length - 1 = transiciones reales.
          lastHold agrega una pausa al final, solo para que la última card respire.
        */
        const lastHold = 0.62;
        const transitionCount = Math.max(slides.length - 1, 1);
        const scrollUnits = transitionCount + lastHold;

        const raw = progress * scrollUnits;
        const activeIndex = Math.min(slides.length - 1, Math.floor(raw));
        const nextIndex = Math.min(slides.length - 1, activeIndex + 1);
        const localProgress = activeIndex >= slides.length - 1 ? 0 : raw - activeIndex;

        slides.forEach((slide, index) => {
          const isActive = index === activeIndex;
          const isNext = index === nextIndex && nextIndex !== activeIndex;

          slide.classList.toggle("isActive", isActive);
          slide.classList.toggle("isNext", isNext);
          slide.setAttribute(
            "aria-hidden",
            isActive || isNext ? "false" : "true"
          );

          if (isActive) {
            slide.style.setProperty("--reveal", "0%");
            slide.style.setProperty("--opacity", "1");
          } else if (isNext) {
            const reveal = 100 - localProgress * 100;
            const opacity = clamp(localProgress * 1.25, 0, 1);
            slide.style.setProperty("--reveal", `${reveal}%`);
            slide.style.setProperty("--opacity", `${opacity}`);
          } else {
            slide.style.setProperty("--reveal", "100%");
            slide.style.setProperty("--opacity", "0");
          }
        });

        const href = slides[Math.min(slides.length - 1, Math.round(raw))]?.dataset?.href;
        if (href) frame.setAttribute("href", href);

        ticking = false;
      };

      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(setActive);
      };

      setActive();
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
    };

    bindSectors();
    document.addEventListener("DOMContentLoaded", bindSectors, { once: true });
  })();
</script>

<style>
.sectorsSection {
  --nav-offset: 84px;
  --last-slide-hold: 52svh;

  position: relative;
  min-height: calc(var(--slides) * 62svh + 35svh + var(--last-slide-hold));
  background: #ffffff;
  color: #080808;
  overflow: visible;
}

.sectorsShell {
  position: sticky;
  top: var(--nav-offset);
  width: 100%;
  min-height: calc(100svh - var(--nav-offset));
  padding:
    clamp(18px, 2.2vw, 36px)
    clamp(30px, 4vw, 74px)
    clamp(46px, 5vw, 82px);
  display: flex;
  flex-direction: column;
}

  .sectorsRule {
    width: 100%;
    height: 1px;
    flex: 0 0 auto;
    background: rgba(8, 8, 8, 0.88);
  }

.sectorsLayout {
  flex: 1;
  display: grid;
  grid-template-columns: minmax(520px, 0.78fr) minmax(0, 1.22fr);
  gap: clamp(42px, 5vw, 92px);
  align-items: center;
  padding-top: clamp(26px, 3.2vw, 46px);
}

  .sectorsCopy {
    max-width: 760px;
    align-self: start;
    padding-top: clamp(8px, 1.4vw, 24px);
    z-index: 2;
  }

  .kicker {
    margin: 0 0 clamp(22px, 2vw, 30px);
    color: #ffc400;
    font-family: var(--font-body);
    font-size: clamp(0.78rem, 0.8vw, 0.92rem);
    font-weight: 700;
    text-transform: uppercase;
  }

  .title {
    margin: 0;
    max-width: 15.6ch;
    color: #080808;
    font-family: var(--font-body);
    font-size: clamp(3rem, 4.45vw, 5.72rem);
    font-weight: 400;
    line-height: 0.99;
    letter-spacing: -0.066em;
    text-wrap: balance;
  }

.sectorsSticky {
  height: min(calc(100svh - var(--nav-offset) - 112px), 760px);
  min-height: 610px;
  align-self: center;
}

  .sectorFrame {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: clamp(22px, 2vw, 34px);
    overflow: hidden;
    isolation: isolate;
    background: #101010;
    color: #ffffff;
    text-decoration: none;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.12);
  }

.sectorSlide {
  --reveal: 100%;
  --opacity: 0;

  position: absolute;
  inset: 0;
  opacity: var(--opacity);
  visibility: hidden;
  transform: translateY(var(--reveal));
  clip-path: inset(var(--reveal) 0 0 0);
  transition:
    visibility 0.2s ease,
    opacity 0.18s linear,
    transform 0.12s linear,
    clip-path 0.12s linear;
  will-change: transform, clip-path, opacity;
}

.sectorSlide.isActive {
  --reveal: 0%;
  --opacity: 1;

  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  clip-path: inset(0 0 0 0);
  z-index: 1;
}

.sectorSlide.isNext {
  visibility: visible;
  z-index: 2;
}

.cardImg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  object-position: center;
  transform: scale(1.005);
  transition: transform 0.8s ease;
}

  .sectorFrame:hover .sectorSlide.isActive .cardImg {
    transform: scale(1.03);
  }

.cardOverlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.42) 0%,
      rgba(0, 0, 0, 0.18) 34%,
      rgba(0, 0, 0, 0.08) 64%,
      rgba(0, 0, 0, 0.18) 100%
    ),
    linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.24) 0%,
      rgba(0, 0, 0, 0.06) 58%,
      rgba(0, 0, 0, 0.08) 100%
    );
  pointer-events: none;
}

.cardContent {
  position: absolute;
  left: clamp(28px, 3.2vw, 54px);
  right: clamp(28px, 3.2vw, 54px);
  top: clamp(28px, 3.2vw, 54px);
  bottom: auto;
  z-index: 2;
  max-width: 820px;
}

  .cardEyebrow {
    display: block;
    margin-bottom: 12px;
    color: #ffc400;
    font-family: var(--font-body);
    font-size: clamp(0.68rem, 0.74vw, 0.82rem);
    font-weight: 700;
    text-transform: uppercase;
  }

.cardTitle {
  margin: 0 0 12px;
  color: #ffffff;
  font-family: var(--font-body);
  font-size: clamp(2.2rem, 3.35vw, 4.45rem);
  font-weight: 400;
}

  .cardSubtitle {
    margin: 0;
    max-width: 68ch;
    color: rgba(255, 255, 255, 0.84);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.05vw, 1.18rem);
    font-weight: 400;
    line-height: 1.48;
    letter-spacing: -0.018em;
  }

  @media (max-width: 1180px) {
    .sectorsSection {
      min-height: auto;
    }

    .sectorsShell {
      position: relative;
      top: auto;
      min-height: auto;
      padding: 56px 30px 82px;
    }

    .sectorsLayout {
      grid-template-columns: 1fr;
      gap: 42px;
      align-items: start;
    }

    .sectorsCopy {
      max-width: 860px;
      padding-top: 0;
    }

    .title {
      max-width: 13.5ch;
      font-size: clamp(2.65rem, 8vw, 5rem);
    }

    .sectorsSticky {
      height: auto;
      min-height: 0;
    }

    .sectorFrame {
      height: 680px;
    }

    .sectorSlide:first-child {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .sectorsShell {
      padding: 52px 22px 76px;
    }

    .sectorsLayout {
      padding-top: 42px;
      gap: 34px;
    }

    .title {
      max-width: 11.8ch;
      font-size: clamp(2.25rem, 12vw, 4.05rem);
      line-height: 1;
      letter-spacing: -0.058em;
    }

    .sectorFrame {
      height: 500px;
      border-radius: 24px;
    }

    .cardTitle {
      font-size: clamp(2rem, 10vw, 3.35rem);
    }

    .cardSubtitle {
      font-size: 0.98rem;
      line-height: 1.44;
    }
  }

@media (prefers-reduced-motion: reduce) {
  .sectorSlide,
  .cardImg {
    transition: none;
  }

  .sectorSlide {
    transform: none;
    clip-path: none;
  }
}
</style>