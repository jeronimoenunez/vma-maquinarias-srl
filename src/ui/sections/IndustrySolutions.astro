---
import Container from "@/ui/components/Container.astro";

type FeatureCard = {
  id: string;
  href: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image: { src: string; alt: string };
  size: "hero" | "regular";
};

type Props = {
  kicker?: string;
  title?: string;
  cards?: FeatureCard[];
};

const fallbackCards: FeatureCard[] = [
  {
    id: "industria",
    href: "#sectores-industria",
    eyebrow: "SECTOR",
    title: "Industria y planta",
    subtitle:
      "Plataformas para mantenimiento de techos, luminarias y estructuras de planta.",
    image: {
      src: "https://images.unsplash.com/photo-1717386255773-1e3037c81788?q=80&w=2340&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
      alt: "Planta industrial con maquinaria operativa",
    },
    size: "hero",
  },
  {
    id: "construccion",
    href: "#sectores-construccion",
    eyebrow: "SECTOR",
    title: "Construcción y obra",
    subtitle:
      "Plataformas, manipuladores y equipos para fachada, montaje estructural y trabajos en altura.",
    image: {
      src: "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=800&auto=format&fit=crop&q=80",
      alt: "Obra en construcción con grúa torre",
    },
    size: "regular",
  },
  // {
  //   id: "mantenimiento",
  //   href: "#sectores-mantenimiento",
  //   eyebrow: "SECTOR",
  //   title: "Mantenimiento y servicios",
  //   subtitle: "Equipos compactos para intervenciones puntuales y mantenimiento preventivo.",
  //   image: {
  //     src: "https://images.unsplash.com/photo-1530124566582-a618bc2615dc?w=800&auto=format&fit=crop&q=80",
  //     alt: "Operario con tablet inspeccionando equipo",
  //   },
  //   size: "regular",
  // },
  {
    id: "alquiler",
    href: "#alquiler",
    title: "Alquiler",
    subtitle: "Equipos disponibles cuando los necesitás",
    image: {
      src: "https://images.unsplash.com/photo-1581094288338-2314dddb7ece?w=800&auto=format&fit=crop&q=80",
      alt: "Plataforma articulada en obra",
    },
    size: "regular",
  },
  // {
  //   id: "soporte",
  //   href: "#soporte",
  //   title: "Soporte técnico 24/7",
  //   subtitle: "Respuesta en sitio cuando la operación no puede frenar",
  //   image: {
  //     src: "https://images.unsplash.com/photo-1581092446327-9b52bd1570c2?w=800&auto=format&fit=crop&q=80",
  //     alt: "Mecánico trabajando con linterna",
  //   },
  //   size: "regular",
  // },
];

const {
  kicker = "EXPLORÁ EL UNIVERSO VMA",
  title = "Tres sectores. Dos modalidades. Un solo estándar operativo.",
  cards,
} = Astro.props as Partial<Props>;

const safeCards = Array.isArray(cards) && cards.length ? cards : fallbackCards;
---

<section id="sectores" class="featuresSection section-pad">
  <Container>
    <div class="header">
      <p class="kicker">{kicker}</p>
      <h2 class="title">{title}</h2>
    </div>
    <div class="grid">
      {
        safeCards.map((card) => (
          <a href={card.href} class={`card card--${card.size}`}>
            <img class="cardImg" src={card.image.src} alt={card.image.alt} loading="lazy" decoding="async" />
            <div class="cardOverlay" aria-hidden="true"></div>
            <div class="cardContent">
              {card.eyebrow && <span class="cardEyebrow">{card.eyebrow}</span>}
              <h3 class="cardTitle">{card.title}</h3>
              {card.subtitle && <p class="cardSubtitle">{card.subtitle}</p>}
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .featuresSection {
    background: #070707;
  }

  section.featuresSection.section-pad {
    padding: clamp(80px, 10vw, 140px) 0;
  }

  .header {
    margin-bottom: 64px;
    text-align: center;
  }

  .kicker {
    color: #ffc400;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .title {
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 26ch;
    margin: 0 auto;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(280px, auto);
    gap: 12px;
  }

  .card {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    background: #1a1a1a;
    text-decoration: none;
    color: #fff;
    display: block;
    transition: transform 0.4s ease;
  }

  .card--hero {
    grid-column: span 2;
    grid-row: span 2;
    min-height: 600px;
  }

  .card--regular {
    min-height: 280px;
  }

  .cardImg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .card:hover .cardImg {
    transform: scale(1.04);
  }

  .cardOverlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.3) 50%, transparent 80%);
    pointer-events: none;
    z-index: 1;
  }

  .cardContent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px;
    z-index: 2;
    transition: transform 0.4s ease;
  }

  .card:hover .cardContent {
    transform: translateY(-4px);
  }

  .cardEyebrow {
    display: block;
    color: #ffc400;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .cardTitle {
    color: #fff;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .card--hero .cardTitle {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .cardSubtitle {
    color: #c9c9c9;
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: 50ch;
    margin: 0;
  }

  .card--hero .cardSubtitle {
    font-size: 1.05rem;
    max-width: 60ch;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 240px;
    }

    .card--hero {
      grid-column: span 2;
      grid-row: span 2;
      min-height: 480px;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }

    .card,
    .card--hero {
      grid-column: span 1;
      grid-row: span 1;
      aspect-ratio: 4 / 3;
      min-height: auto;
    }

    .cardContent {
      padding: 24px;
    }
  }
</style>
