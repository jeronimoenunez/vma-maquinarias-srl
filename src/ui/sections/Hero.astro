---
import Container from "@/ui/components/Container.astro";
import { videoAssets } from "@/data/videoAssets";

type Cta = { label: string; href: string };

type Props = {
  kicker?: string;
  title?: string;
  subtitle?: string;
  pullQuote?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  image?: { src: string; alt?: string };
};

const {
  kicker = "ALQUILER Y VENTA DE MAQUINARIA ESPECIALIZADA",
  title = "VMA Rental",
  subtitle = "Alquiler, venta y soporte técnico con disponibilidad real en el AMBA y zonas extendidas.",
  primaryCta = { label: "Cotizar equipo", href: "#" },
  secondaryCta = { label: "Ver catálogo", href: "#equipos" },
  image,
} = Astro.props as Props;

const heroVideo = videoAssets.heroMain;
const posterSrc = image?.src ?? heroVideo.poster;
---

<section id="inicio" class="hero">
  <video
  id="heroVideo"
  class="heroVideo"
  muted
  autoplay
  loop
  playsinline
  webkit-playsinline="true"
  preload="auto"
  aria-label={image?.alt ?? "Video de presentación VMA Rental"}
>
  <source src={heroVideo.desktop.mp4} type="video/mp4" />
</video>
  <div class="heroOverlay" aria-hidden="true"></div>

  <div class="heroContent">
    <Container class="heroContentInner">
      <p class="kicker">{kicker}</p>
      <h1 class="brandLogo">{title}</h1>
      <p class="tagline">{subtitle}</p>

      <div class="heroActions">
        <a class="heroBtn" href={primaryCta.href}>{primaryCta.label}</a>
        <a class="heroLinkSecondary" href={secondaryCta.href}>{secondaryCta.label}</a>
      </div>

      <!-- <div class="slideIndicator" aria-hidden="true">
        <span class="active"></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div> -->
    </Container>
  </div>
</section>

<script is:inline>
  (() => {
    const playHeroVideo = async () => {
      const video = document.getElementById("heroVideo");

      if (!video) return;

      video.muted = true;
      video.defaultMuted = true;
      video.volume = 0;
      video.autoplay = true;
      video.loop = true;
      video.playsInline = true;

      video.setAttribute("muted", "");
      video.setAttribute("autoplay", "");
      video.setAttribute("loop", "");
      video.setAttribute("playsinline", "");
      video.setAttribute("webkit-playsinline", "true");

      try {
        await video.play();
        video.classList.add("isPlaying");
        video.classList.remove("isBlocked");
      } catch (error) {
        console.warn("[HeroVideo] autoplay bloqueado:", error);
        video.classList.add("isBlocked");
      }
    };

    playHeroVideo();

    document.addEventListener("DOMContentLoaded", playHeroVideo, { once: true });
    window.addEventListener("load", playHeroVideo, { once: true });

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) playHeroVideo();
    });

    ["click", "touchstart", "pointerdown", "keydown"].forEach((eventName) => {
      window.addEventListener(eventName, playHeroVideo, {
        once: true,
        passive: true,
      });
    });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #000;
  }

  .heroVideo.isBlocked {
    filter: brightness(0.85);
  }

  .heroVideo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    z-index: 0;
  }

  .heroOverlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.15) 40%,
      transparent 70%
    );
  }

  .heroContent {
    position: absolute;
    bottom: 80px;
    left: 80px;
    max-width: 600px;
    z-index: 2;
    margin: 130px 0px;
  }

  .heroContent :global(.container.heroContentInner) {
    width: 100%;
    max-width: 600px;
    margin-inline: 0;
  }

  .kicker {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.4;
    margin: 0;
  }

  .brandLogo {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: #fff;
    line-height: 1;
    margin: 0;
    margin-top: 12px;
  }

  .tagline {
    font-family: var(--font-serif), var(--font-display), serif;
    font-size: 0.95rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    margin-top: 8px;
    line-height: 1.5;
  }

  .heroActions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
  }

  .heroBtn {
    display: inline-block;
    padding: 14px 32px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: transparent;
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: none;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    border-radius: var(--r-sm);
  }

  .heroBtn:hover {
    background: #fff;
    color: var(--vma-black);
    border-color: #fff;
  }

  .heroLinkSecondary {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 1px solid var(--vma-line);
    padding-bottom: 2px;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .heroLinkSecondary:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.55);
  }

  .slideIndicator {
    display: flex;
    gap: 8px;
    margin-top: 48px;
  }

  .slideIndicator span {
    display: block;
    width: 56px;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
  }

  .slideIndicator span.active {
    background: #fff;
  }

  @media (max-width: 768px) {
    .heroContent {
      left: 24px;
      right: 24px;
      bottom: 48px;
      max-width: none;
    }

    .heroContent :global(.container.heroContentInner) {
      max-width: none;
    }

    .brandLogo {
      font-size: clamp(2rem, 8vw, 3rem);
    }

    .slideIndicator span {
      width: 32px;
    }

    .heroActions {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
