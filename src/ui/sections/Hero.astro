---
type Props = {
  eyebrow?: string;
  title?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
};

const {
  eyebrow = "Medios de elevación para trabajos en altura",
  title = "No solo elevamos personas, Impulsamos tu productividad.",
  primaryCta = { label: "Cotizar Equipo", href: "#contacto" },
  secondaryCta = { label: "Ver equipos", href: "#equipos" },
} = Astro.props;
---

<section id="inicio" class="heroB" data-vma-hero>
  <div class="heroB__visual" aria-hidden="true"></div>

  <div class="heroB__content">
    <p class="heroB__kicker">{eyebrow}</p>

    <h1 class="heroB__title">
      {title}
    </h1>

    <div class="heroB__actions">
      <a class="heroB__btn heroB__btn--primary" href={primaryCta.href}>
        {primaryCta.label}
      </a>

      <a class="heroB__btn heroB__btn--secondary" href={secondaryCta.href}>
        {secondaryCta.label}
      </a>
    </div>
  </div>

  <div class="heroB__bottomBlend" aria-hidden="true"></div>

  <a class="heroB__banner" href="#equipo-brazo-articulado-diesel-ha-16-rtj-pro" data-vma-open-machine="brazo-articulado-diesel-ha-16-rtj-pro" aria-label="Ver equipo destacado HA16 RTJ Pro">
    <span class="heroB__bannerImage" aria-hidden="true"></span>
    <span class="heroB__bannerShade" aria-hidden="true"></span>

    <span class="heroB__bannerCopy">
      <strong>Experimenta <em>nuevas alturas</em></strong>
      <small>Descubrí la HA16 RTJ Pro</small>
    </span>
  </a>
</section>

<script>
  (() => {
    const TARGET_ID = "brazo-articulado-diesel-ha-16-rtj-pro";
    const TARGET_HASH = "#equipo-brazo-articulado-diesel-ha-16-rtj-pro";

    const getSection = (): HTMLElement | null =>
      document.querySelector<HTMLElement>("[data-equipment-section]") ||
      document.querySelector<HTMLElement>("#equipos");

    const openTargetMachine = () => {
      const section = getSection();
      if (!section) return;

      try {
        history.replaceState(null, "", TARGET_HASH);
      } catch (_) {}

      section.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });

      window.setTimeout(() => {
        const rawCard = section.querySelector<HTMLElement>(
          `[data-machine-card][data-id="${TARGET_ID}"]`
        );

        if (!rawCard) return;

        const subCategory = rawCard.dataset.subCategory;
        const subButton = subCategory
          ? section.querySelector<HTMLElement>(`[data-sub-category="${subCategory}"]`)
          : null;

        const mainCategory = subButton?.dataset.parentCategory;
        const mainButton = mainCategory
          ? section.querySelector<HTMLElement>(`[data-main-category="${mainCategory}"]`)
          : null;

        mainButton?.click();

        window.setTimeout(() => {
          subButton?.click();

          window.setTimeout(() => {
            const targetCard = section.querySelector<HTMLElement>(
              `[data-machine-card][data-id="${TARGET_ID}"]`
            );

            if (!targetCard) return;

            targetCard.scrollIntoView({
              behavior: "smooth",
              block: "nearest",
              inline: "center",
            });

            targetCard.click();
          }, 220);
        }, 120);
      }, 480);
    };

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const trigger = target?.closest(`[data-vma-open-machine="${TARGET_ID}"]`);

      if (!trigger) return;

      event.preventDefault();
      openTargetMachine();
    });

    window.addEventListener("DOMContentLoaded", () => {
      if (window.location.hash === TARGET_HASH) {
        window.setTimeout(openTargetMachine, 650);
      }
    });
  })();
</script>

<style>
  .heroB {
    position: relative;
    width: 100%;
    min-height: clamp(690px, 99svh, 920px);
    overflow: hidden;
    isolation: isolate;
    background: #030303;
    color: #ffffff;
  }

  .heroB__visual {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.08) 0%,
        rgba(0, 0, 0, 0.14) 38%,
        rgba(0, 0, 0, 0.86) 100%
      ),
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.56) 0%,
        rgba(0, 0, 0, 0.16) 54%,
        rgba(0, 0, 0, 0.18) 100%
      ),
      url("/images/optimized/Firefly-10-2.png");
    background-size: cover;
    background-position: 50% center;
    background-repeat: no-repeat;
  }

  .heroB__content {
    position: relative;
    z-index: 2;
    width: min(100% - 44px, 1180px);
    margin: 0 auto;
    padding-top: clamp(220px, 25svh, 310px);
  }

  .heroB__kicker {
    margin: 0 0 12px;
    color: #ffc400;
    font-size: clamp(0.68rem, 2vw, 1rem);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
  }

  .heroB__title {
    margin: 0;
    max-width: 17.5ch;
    color: #ffffff;
    font-size: clamp(2.25rem, 5.8vw, 5.9rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
    font-weight: 300;
    text-shadow: 0 4px 28px rgba(0, 0, 0, 0.52);
  }

  .heroB__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: clamp(22px, 3vw, 30px);
  }

  .heroB__btn {
    min-width: 142px;
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    padding: 0 18px;
    text-decoration: none;
    font-size: 0.83rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    transition:
      transform 0.22s ease,
      background 0.22s ease,
      border-color 0.22s ease,
      color 0.22s ease;
  }

  .heroB__btn--primary {
    background: rgba(255, 196, 0, 0.12);
    color: #ffc400;
    border: 1px solid rgba(255, 196, 0, 0.88);
  }

  .heroB__btn--secondary {
    color: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.42);
    background: rgba(0, 0, 0, 0.22);
  }

  .heroB__btn:hover {
    transform: translateY(-2px);
  }

  .heroB__btn--primary:hover {
    background: #ffc400;
    color: #050505;
  }

  .heroB__btn--secondary:hover {
    border-color: rgba(255, 255, 255, 0.72);
    color: #ffffff;
  }

  .heroB__bottomBlend {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    height: clamp(260px,30vh,378px);
    pointer-events: none;
    background: radial-gradient(ellipse at center bottom, rgba(0, 0, 0, 0.96), rgba(0, 0, 0, 0.72) 13.03%, rgba(0, 0, 0, 0) 23.95%),linear-gradient(180deg,rgba(0,0,0,0) 0%,#030303 76%);
    backdrop-filter: blur(1.5px);
    -webkit-backdrop-filter: blur(1.2px);
  }

  .heroB__banner {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 3;
    display: block;
    width: min(calc(100% - 48px), 1200px);
    height: clamp(104px, 12vw, 200px);
    transform: translateX(-50%);
    overflow: hidden;
    border-radius: 14px;
    color: #fff;
    text-decoration: none;
    background: #101010;
    box-shadow:
      0 28px 90px rgba(0, 0, 0, 0.62),
      0 0 80px rgba(0, 0, 0, 0.42);
  }

  .heroB__banner::before {
    content: "";
    position: absolute;
    inset: -28px;
    z-index: -1;
    background: rgba(0, 0, 0, 0.58);
    filter: blur(34px);
  }

  .heroB__bannerImage {
    position: absolute;
    inset: 0;
    background-image: url("/images/optimized/ha-16-rtj-pro-card-Banner-1-large.webp");
    background-size: cover;
    background-position: center 42%;
    background-repeat: no-repeat;
    opacity: 0.86;
  }

  .heroB__bannerShade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.84) 0%,
        rgba(0, 0, 0, 0.52) 34%,
        rgba(0, 0, 0, 0.16) 68%,
        rgba(0, 0, 0, 0.06) 100%
      ),
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.02) 0%,
        rgba(0, 0, 0, 0.34) 100%
      );
  }

  .heroB__bannerCopy {
    position: absolute;
    left: clamp(18px, 3vw, 34px);
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
    display: grid;
    gap: 7px;
  }

  .heroB__bannerCopy strong {
    font-size: clamp(0.9rem, 1.4vw, 1.18rem);
    font-weight: 500;
    font-style: normal;
  }

  .heroB__bannerCopy strong em {
    font-weight: 700;
    font-style: normal;
  }

  .heroB__bannerCopy small {
    width: fit-content;
    border: 1px solid rgba(255, 196, 0, 0.5);
    border-radius: 8px;
    padding: 7px 12px;
    color: #ffc400;
    font-size: 0.74rem;
    font-weight: 800;
    background: rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 980px) and (min-width: 721px) {
    .heroB__banner {
      width: min(calc(100% - 36px), 960px);
      height: 116px;
    }

    .heroB__bannerImage {
      background-size: cover;
      background-position: center 42%;
    }
  }

  @media (max-width: 720px) {
    .heroB {
      height: 100svh;
      min-height: 100svh;
      max-height: 100svh;
      overflow: hidden;
    }

    .heroB__visual {
      inset: 0;
      height: 100%;
      background-image:
        linear-gradient(
          180deg,
          rgba(0, 0, 0, 0.04) 0%,
          rgba(0, 0, 0, 0.04) 24%,
          rgba(0, 0, 0, 0.12) 42%,
          rgba(0, 0, 0, 0.34) 64%,
          rgba(0, 0, 0, 0.68) 100%
        ),
        linear-gradient(
          90deg,
          rgba(0, 0, 0, 0.16) 0%,
          rgba(0, 0, 0, 0.02) 48%,
          rgba(0, 0, 0, 0.12) 100%
        ),
        url("/images/optimized/Firefly-10.png");
      background-size: cover;
      background-position: 52% center;
      background-repeat: no-repeat;
    }

    .heroB__content {
      width: 100%;
      height: 100svh;
      min-height: 100svh;
      margin: 0;
      padding: 0 18px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      transform: translateY(36px);
    }

    .heroB__kicker {
      margin-bottom: 8px;
      font-size: clamp(0.62rem, 2.45vw, 0.72rem);
      line-height: 1.05;
      letter-spacing: 0.055em;
      text-shadow: 0 2px 16px rgba(0, 0, 0, 0.65);
    }

    .heroB__title {
      max-width: 94%;
      font-size: clamp(1.58rem, 7.35vw, 2.18rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
      font-weight: 500;
      text-shadow: 0 3px 20px rgba(0, 0, 0, 0.7);
    }

    .heroB__actions {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 20px;
    }

    .heroB__btn {
      width: 100%;
      min-width: 0;
      min-height: 48px;
      padding-inline: 10px;
      font-size: 0.8rem;
      border-radius: 10px;
    }

    .heroB__btn--primary {
      background: rgba(255, 196, 0, 1);
      color: #090909;
      border-color: rgba(255, 196, 0, 0.9);
    }

    .heroB__btn--secondary {
      background: rgba(0, 0, 0, 0.12);
      border-color: rgba(255, 255, 255, 0.46);
      color: rgba(255, 255, 255, 0.86);
    }

    .heroB__bottomBlend,
    .heroB__banner {
      display: none;
    }
  }

  @media (max-width: 390px) {
    .heroB__visual {
      background-position: 54% center;
    }

    .heroB__content {
      padding-inline: 16px;
      transform: translateY(34px);
    }

    .heroB__title {
      max-width: 96%;
      font-size: clamp(1.5rem, 7.2vw, 2rem);
    }

    .heroB__actions {
      gap: 9px;
    }

    .heroB__btn {
      min-height: 46px;
      font-size: 0.76rem;
    }
  }
</style>
