---
import Container from "@/ui/components/Container.astro";
import { videoAssets } from "@/data/videoAssets";

type Cta = { label: string; href: string };

type Props = {
  kicker?: string;
  title?: string;
  subtitle?: string;
  pullQuote?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  image?: { src: string; alt?: string };
};

const {
  kicker = "EQUIPOS DE ELEVACIÓN Y TRABAJO EN ALTURA",
  title = "Tu operación no puede parar. Nosotros nos encargamos de que no pare.",
  subtitle = "Equipos de elevación listos, donde los necesites, cuando los necesites.",
  primaryCta = { label: "Cotizar equipo", href: "#contacto" },
  secondaryCta = { label: "Ver equipos", href: "#equipos" },
  image,
} = Astro.props as Props;

const heroVideo = videoAssets.heroMain;
const posterSrc = image?.src ?? heroVideo.poster;
---

<section id="inicio" class="hero">
  <video
    id="heroVideo"
    class="heroVideo"
    muted
    autoplay
    loop
    playsinline
    webkit-playsinline="true"
    preload="auto"
    aria-label={image?.alt ?? "Video de presentación VMA Rental"}
  >
    <source src={heroVideo.desktop.mp4} type="video/mp4" />
  </video>
  <div class="heroOverlay" aria-hidden="true"></div>

  <div class="heroContent">
    <Container class="heroContentInner">
      <p class="kicker">{kicker}</p>
      <h1 class="brandLogo">{title}</h1>
      <p class="tagline">{subtitle}</p>

      <div class="heroActions">
        <a class="heroBtn" href={primaryCta.href}>{primaryCta.label}</a>
        <a class="heroLinkSecondary" href={secondaryCta.href}>{secondaryCta.label}</a>
      </div>
    </Container>
  </div>
</section>

<script is:inline>
  (() => {
    const playHeroVideo = async () => {
      const video = document.getElementById("heroVideo");
      if (!video) return;

      video.muted = true;
      video.defaultMuted = true;
      video.volume = 0;
      video.autoplay = true;
      video.loop = true;
      video.playsInline = true;

      video.setAttribute("muted", "");
      video.setAttribute("autoplay", "");
      video.setAttribute("loop", "");
      video.setAttribute("playsinline", "");
      video.setAttribute("webkit-playsinline", "true");

      try {
        await video.play();
        video.classList.add("isPlaying");
        video.classList.remove("isBlocked");
      } catch (error) {
        console.warn("[HeroVideo] autoplay bloqueado:", error);
        video.classList.add("isBlocked");
      }
    };

    playHeroVideo();
    document.addEventListener("DOMContentLoaded", playHeroVideo, { once: true });
    window.addEventListener("load", playHeroVideo, { once: true });

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) playHeroVideo();
    });

    ["click", "touchstart", "pointerdown", "keydown"].forEach((eventName) => {
      window.addEventListener(eventName, playHeroVideo, {
        once: true,
        passive: true,
      });
    });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #000;
  }

  .heroVideo.isBlocked {
    filter: brightness(0.85);
  }

  .heroVideo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    z-index: 0;
  }

  .heroOverlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.25) 40%,
      transparent 70%
    );
  }

  .heroContent {
    position: absolute;
    bottom: 80px;
    left: 80px;
    max-width: 650px;
    z-index: 2;
    margin: 130px 0px;
  }

  .heroContent :global(.container.heroContentInner) {
    width: 100%;
    max-width: 650px;
    margin-inline: 0;
  }

  .kicker {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffc400;
    line-height: 1.4;
    margin: 0;
    font-weight: 600;
  }

  .brandLogo {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: #fff;
    line-height: 1.1;
    margin: 0;
    margin-top: 16px;
  }

  .tagline {
    font-size: 1rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    margin-top: 16px;
    line-height: 1.6;
    max-width: 48ch;
  }

  .heroActions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 36px;
  }

  .heroBtn {
    display: inline-block;
    padding: 16px 36px;
    border: none;
    background: #ffc400;
    color: #070707;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: none;
    transition: background 0.3s ease, color 0.3s ease;
    border-radius: var(--r-sm);
  }

  .heroBtn:hover {
    background: #fff;
    color: #070707;
  }

  .heroLinkSecondary {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 1px solid var(--vma-line);
    padding-bottom: 2px;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .heroLinkSecondary:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 768px) {
    .heroContent {
      left: 24px;
      right: 24px;
      bottom: 48px;
      max-width: none;
    }

    .heroContent :global(.container.heroContentInner) {
      max-width: none;
    }

    .brandLogo {
      font-size: clamp(1.8rem, 7vw, 2.6rem);
    }

    .heroActions {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>