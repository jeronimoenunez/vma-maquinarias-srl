---
import Container from "@/ui/components/Container.astro";
import { videoAssets } from "@/data/videoAssets";

type Cta = { label: string; href: string };

type Props = {
  kicker?: string;
  title?: string;
  subtitle?: string;
  pullQuote?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  image?: { src: string; alt?: string };
};

const {
  kicker = "EQUIPOS DE ELEVACIÓN Y TRABAJO EN ALTURA",
  title = "Tu operación no puede parar. Nosotros nos encargamos de que no pare.",
  subtitle = "Equipos de elevación listos, donde los necesites, cuando los necesites.",
  primaryCta = { label: "Cotizar equipo", href: "#contacto" },
  secondaryCta = { label: "Ver equipos", href: "#equipos" },
  image,
} = Astro.props as Props;

const heroVideo = videoAssets.heroMain;
---

<section id="inicio" class="hero" data-vma-hero>
  <div class="heroSticky">
    <div class="heroFrame">
      <video
        id="heroVideo"
        class="heroVideo"
        muted
        autoplay
        loop
        playsinline
        webkit-playsinline="true"
        preload="auto"
        poster="/videos/imgBackground.jpg"
        aria-label={image?.alt ?? "Video de presentación VMA Rental"}
      >
        <source src={heroVideo.desktop.mp4} type="video/mp4" />
      </video>

      <div class="heroOverlay" aria-hidden="true"></div>

      <div class="heroContent">
        <Container class="heroContentInner">
          <p class="kicker">{kicker}</p>
          <h1 class="brandLogo">{title}</h1>
          <p class="tagline">{subtitle}</p>

          <div class="heroActions">
            <a class="heroBtn" href={primaryCta.href}>{primaryCta.label}</a>
            <a class="heroLinkSecondary" href={secondaryCta.href}>{secondaryCta.label}</a>
          </div>
        </Container>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const playHeroVideo = async () => {
      const video = document.getElementById("heroVideo");
      if (!video) return;

      if (!video.paused && video.readyState >= 2) return;

      video.muted = true;
      video.defaultMuted = true;
      video.volume = 0;
      video.autoplay = true;
      video.loop = true;
      video.playsInline = true;

      video.setAttribute("muted", "");
      video.setAttribute("autoplay", "");
      video.setAttribute("loop", "");
      video.setAttribute("playsinline", "");
      video.setAttribute("webkit-playsinline", "true");

      try {
        await video.play();
        video.classList.add("isPlaying");
        video.classList.remove("isBlocked");
      } catch (error) {
        console.warn("[HeroVideo] autoplay bloqueado:", error);
        video.classList.add("isBlocked");
      }
    };

    const bindHeroScroll = () => {
      const hero = document.querySelector("[data-vma-hero]");
      if (!hero) return;

      let ticking = false;

      const update = () => {
        const rect = hero.getBoundingClientRect();
        const viewport = window.innerHeight || 1;
        const travel = Math.max(hero.offsetHeight - viewport, 1);
        const raw = clamp(Math.abs(rect.top) / travel, 0, 1);

        const eased = 1 - Math.pow(1 - raw, 3);

        const delayedFade = clamp((eased - 0.52) / 0.42, 0, 1);

        hero.style.setProperty("--hero-inset", `${Math.round(eased * 26)}px`);
        hero.style.setProperty("--hero-radius", `${Math.round(eased * 22)}px`);
        hero.style.setProperty("--hero-scale", `${1 + eased * 0.028}`);
        hero.style.setProperty("--content-opacity", `${clamp(1 - delayedFade, 0, 1)}`);
        hero.style.setProperty("--content-y", `${Math.round(delayedFade * -28)}px`);

        ticking = false;
      };

      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(update);
      };

      update();
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
    };

    playHeroVideo();
    bindHeroScroll();

    document.addEventListener("DOMContentLoaded", () => {
      playHeroVideo();
      bindHeroScroll();
    }, { once: true });

    window.addEventListener("load", playHeroVideo, { once: true });

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) playHeroVideo();
    });

    ["click", "touchstart", "pointerdown", "keydown"].forEach((eventName) => {
      window.addEventListener(eventName, playHeroVideo, {
        once: true,
        passive: true,
      });
    });
  })();
</script>

<style>
  .hero {
    --hero-inset: 0px;
    --hero-radius: 0px;
    --hero-scale: 1;
    --content-opacity: 1;
    --content-y: 0px;

    position: relative;
    height: 132vh;
    background: #f5f5f2;
  }

  .heroSticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: #ffffff;
  }

  .heroFrame {
    position: absolute;
    inset: var(--hero-inset);
    overflow: hidden;
    border-radius: var(--hero-radius);
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.22)),
      url("/videos/imgBackground.jpg") center / cover no-repeat,
      #000;
    transform: translateZ(0);
    will-change: inset, border-radius;
  }

  .heroVideo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    z-index: 0;
    transform: scale(var(--hero-scale));
    transform-origin: center;
    transition: filter 0.4s ease;
    will-change: transform;
  }

  .heroVideo.isBlocked {
    filter: brightness(0.85);
  }

.heroOverlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    radial-gradient(
      circle at 24% 52%,
      rgba(0, 0, 0, 0.56) 0%,
      rgba(0, 0, 0, 0.42) 34%,
      rgba(0, 0, 0, 0.12) 62%,
      rgba(0, 0, 0, 0.18) 100%
    ),
    linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.58) 34%,
      rgba(0, 0, 0, 0.18) 68%,
      rgba(0, 0, 0, 0.22) 100%
    ),
    linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.12) 0%,
      rgba(0, 0, 0, 0.16) 56%,
      rgba(0, 0, 0, 0.44) 100%
    );
}

  .heroContent {
    position: absolute;
    left: clamp(28px, 4vw, 76px);
    bottom: clamp(62px,22vh,300px);
    max-width: min(1180px, calc(100vw - 120px));
    z-index: 2;
    opacity: var(--content-opacity);
    transform: translate3d(0, var(--content-y), 0);
    will-change: opacity, transform;
  }

  .heroContent :global(.container.heroContentInner) {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: 0;
  }

  .kicker {
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #ffc400;
    line-height: 1.4;
    margin: 0;
    font-weight: 700;
  }

  .brandLogo {
    font-family: var(--font-body);
    font-size: clamp(3.8rem,6vw,8.2rem);
    font-weight: 300;
    letter-spacing: -0.065em;
    color: #fff;
    line-height: 0.94;
    margin: 18px 0 0;
    /* max-width: 20.5ch; */
  }

  .tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.35vw, 1.22rem);
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.84);
    margin: 26px 0 0;
    line-height: 1.55;
    max-width: 58ch;
  }

  .heroActions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 38px;
  }

.heroBtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54px;
  padding: 0 34px;
  border: 1px solid rgba(255, 196, 0, 0.76);
  background: rgba(255, 196, 0, 0.08);
  color: #ffc400;
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  text-decoration: none;
  border-radius: 10px;
  box-shadow: 0 14px 42px rgba(0, 0, 0, 0.12);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transition:
    background 0.28s ease,
    color 0.28s ease,
    border-color 0.28s ease,
    box-shadow 0.28s ease,
    transform 0.28s ease;
}

.heroBtn:hover {
  background: #ffc400;
  border-color: #ffc400;
  color: #070707;
  box-shadow: 0 18px 54px rgba(255, 196, 0, 0.2);
  transform: translateY(-2px);
}

  .heroLinkSecondary {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.68);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .heroLinkSecondary::after {
    content: "";
    width: 42px;
    height: 1px;
    margin-left: 14px;
    background: rgba(255, 255, 255, 0.34);
    transform-origin: left;
    transition: transform 0.28s ease, background 0.28s ease;
  }

  .heroLinkSecondary:hover {
    color: #fff;
  }

  .heroLinkSecondary:hover::after {
    background: #ffc400;
    transform: scaleX(1.22);
  }

  @media (max-width: 768px) {
    .hero {
      height: 118vh;
    }

    .heroContent {
      left: 24px;
      right: 24px;
      bottom: 48px;
      max-width: none;
    }

    .brandLogo {
      font-size: clamp(2.7rem, 13vw, 4.4rem);
      max-width: 10.5ch;
    }

    .tagline {
      max-width: 34ch;
    }

    .heroActions {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: 100svh;
    }

    .heroSticky {
      position: relative;
    }

    .heroVideo,
    .heroContent,
    .heroFrame {
      transform: none;
      transition: none;
      will-change: auto;
    }
  }
</style>